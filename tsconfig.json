{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": [
    "node_modules",
    "scripts/batch-fetch-bg.ts",
    "scripts/build-works-snapshot.ts",
    "scripts/fetch-literature-data.ts",
    "scripts/scan-completeness.ts",
    "scripts/seed-from-static.ts.bak",
    "scripts/seed-from-static.ts",
    "src/lib/data.ts.bak",
    "src/lib/book-data.ts.bak",
    "src/lib/character-data.ts.bak",
    "src/lib/award-data.ts.bak",
    "src/lib/works"
  ]
}
