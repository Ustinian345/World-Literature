  ],
  "tao-yuanming": [
    { name: "陶渊明", role: "诗人", description: "号五柳先生，东晋诗人。'采菊东篱下，悠然见南山'——中国田园诗派的开创者，归隐生活的美学典范。" },
  ],
  "jin-ping-mei": [
    { name: "西门庆", role: "主人公", description: "清河县的富商，集商人、官僚与恶霸于一身。他的放纵与暴亡是晚明欲望社会的缩影。" },
    { name: "潘金莲", role: "主要人物", description: "西门庆的第五房妾，美貌而狠毒。她是中国文学中最复杂的'淫妇'形象——既是欲望的化身又是男权社会的牺牲品。" },
    { name: "李瓶儿", role: "重要人物", description: "西门庆的第六房妾，善良而多情。她的儿子官哥被潘金莲害死，她自己也郁郁而终——全书最令人心碎的女性悲剧。" },
