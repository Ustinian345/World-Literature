  // ==================== 核心库 — 欧洲 ====================

  "iliad": [
    { name: "阿喀琉斯", role: "主人公", description: "希腊联军最伟大的战士，半神英雄。他的愤怒是整部史诗的引擎——挚友帕特罗克洛斯之死使他重返战场，杀死了特洛伊英雄赫克托耳。" },
    { name: "赫克托耳", role: "特洛伊英雄", description: "特洛伊王子，城邦最勇敢的守护者。他为保卫家园和妻儿而战，在与妻子安德洛玛刻告别的场景中展现了最深沉的人性光辉。" },
    { name: "帕特罗克洛斯", role: "关键人物", description: "阿喀琉斯的挚友。当希腊军溃败时，他穿上阿喀琉斯的盔甲出战，被赫克托耳杀死——他的死改变了整场战争。" },
    { name: "阿伽门农", role: "希腊统帅", description: "迈锡尼国王，希腊联军最高统帅。他与阿喀琉斯因女俘布里塞伊斯引发冲突，几乎葬送了整个远征。" },
  ],
  "odyssey": [
    { name: "奥德修斯", role: "主人公", description: "伊塔卡国王，特洛伊战争中'木马计'的设计者。归家途中历经十年漂泊——独眼巨人、海妖塞壬、女神卡吕普索——他以智慧和忍耐回到妻子身边。" },
    { name: "佩涅洛佩", role: "女主角", description: "奥德修斯的妻子，以智慧和忠贞抵御了一百多个求婚者二十年的纠缠。她白天织布夜里拆掉——这个'永远在完成中的织物'是她等待丈夫归来的最动人隐喻。" },
    { name: "忒勒玛科斯", role: "儿子", description: "奥德修斯离家时还在襁褓中的儿子，长大后踏上寻父之旅——从一个无助的少年成长为勇士。" },
  ],
  "oedipus": [
    { name: "俄狄浦斯", role: "主人公", description: "忒拜国王，在不知情中弑父娶母。他解开了斯芬克斯的谜语，却解不开自己的命运——当他发现真相，刺瞎了自己的双眼。" },
    { name: "伊俄卡斯忒", role: "王后/母亲", description: "俄狄浦斯的生母和不自知中的妻子。当她发现真相时选择了自缢——她是全剧最早意识到恐怖真相的人。" },
  ],
  "medea": [
    { name: "美狄亚", role: "主人公", description: "科尔喀斯公主，拥有强大的巫术。她为爱背叛父亲、杀死弟弟——当伊阿宋为政治利益抛弃她时，她以杀死自己两个孩子来惩罚他。西方文学中最令人震撼的女性形象之一。" },
    { name: "伊阿宋", role: "男主角", description: "阿尔戈英雄领袖。他对美狄亚的背叛并非出于恶意而是功利——他的'理性理由'低估了美狄亚的愤怒。" },
  ],
  "aeneid": [
    { name: "埃涅阿斯", role: "主人公", description: "特洛伊英雄，维纳斯之子。特洛伊陷落后背负父亲、牵着儿子逃出火海——这个'孝子'形象定义了罗马精神。他漂泊至意大利成为罗马人的祖先，但为此离开了深爱他的迦太基女王狄多。" },
    { name: "狄多", role: "重要人物", description: "迦太基女王。她爱上了埃涅阿斯，但当后者遵神意离开她时，她自焚而死——她的诅咒是罗马与迦太基百年战争的源头。" },
  ],
  "metamorphoses": [
    { name: "奥维德", role: "诗人/叙述者", description: "古罗马诗人，以'变形'为主题串联起250多个希腊罗马神话故事——人变成树、石、鸟、花——每种变形都是对欲望与爱的诗意审判。" },
  ],
  "divine-comedy": [
    { name: "但丁", role: "主人公/叙述者", description: "既是作者也是旅者——在维吉尔和贝雅特丽齐的引导下游历地狱、炼狱和天堂。他的旅程是人类灵魂寻求救赎的最伟大文学寓言。" },
    { name: "维吉尔", role: "引导者", description: "古罗马诗人，作为'理性'的化身引导但丁穿越地狱和炼狱——但他不能进入天堂，因为他缺乏信仰。" },
    { name: "贝雅特丽齐", role: "引导者/缪斯", description: "但丁一生挚爱的女性，在天堂接替维吉尔成为向导——她代表了超越理性的'信仰'与'神恩'。" },
  ],
  "decameron": [
    { name: "十位青年男女", role: "叙述者群体", description: "1348年黑死病肆虐佛罗伦萨期间，七位少女和三位青年逃到乡间别墅，十日讲了一百个故事——以故事对抗死亡，以笑声消解恐惧。" },
  ],
  "king-lear": [
    { name: "李尔王", role: "主人公", description: "不列颠的老年国王，因虚荣将王国分给两个巧言令色的女儿，却驱逐了真诚的小女儿考狄利娅。在暴风雨荒野中发疯时，他终于明白了真正的人性。" },
    { name: "考狄利娅", role: "小女儿", description: "李尔王最心爱的小女儿，拒绝用虚假的甜言蜜语换取父亲恩宠。她被驱逐后率军回来拯救父亲，却被俘虏并处死——莎士比亚所有悲剧中最令人无法承受的死亡。" },
    { name: "埃德蒙", role: "反派", description: "格罗斯特伯爵的私生子，以超群的智力和冷酷的野心挑战合法继承秩序。他的'恶魔'魅力令人既憎恨又着迷。" },
  ],
  "paradise-lost": [
    { name: "撒旦", role: "反英雄", description: "曾经的天使长路西法，因骄傲反叛上帝被打入地狱。'宁在地狱为王，不在天堂为仆'——他是全书最富有魅力的角色。" },
    { name: "亚当", role: "主人公", description: "第一个人类，明知吃了禁果的后果却因为爱与夏娃一同承担而选择堕落。他的'堕落'不是因为邪恶而是因为爱。" },
    { name: "夏娃", role: "女主角", description: "第一个女性，被撒旦引诱吃了智慧树的果子。弥尔顿赋予她独特的尊严——她在追求知识的渴望中做出了自主的选择。" },
  ],
  "pride-and-prejudice": [
    { name: "伊丽莎白·班纳特", role: "女主角", description: "班纳特家的二女儿，聪明、机智、有独立判断力。她最大的成长在于克服自己的'偏见'，看到达西傲慢之下的真心。" },
    { name: "达西先生", role: "男主角", description: "年收入一万英镑的贵族绅士。他的傲慢和不合群让伊丽莎白产生了深深的反感——但他为她妹妹的事暗中奔走，以行动证明了自己的品格。" },
    { name: "简·班纳特", role: "重要人物", description: "班纳特长女，美丽温柔。她与宾利先生的爱情因过于含蓄差点错过——简与伊丽莎白构成了奥斯汀笔下善良的两种形态。" },
  ],
  "wuthering-heights": [
    { name: "希斯克利夫", role: "主人公", description: "被老恩肖收养的利物浦孤儿。他对凯瑟琳的爱是毁灭性的——当他听到凯瑟琳说'嫁给希斯克利夫就是贬低我自己'后愤然离去，三年后回来变成了复仇恶魔。但他的复仇最终是空虚的——他只想与凯瑟琳的灵魂合二为一。" },
    { name: "凯瑟琳·恩肖", role: "女主角", description: "一个狂野的、充满生命力的灵魂。她爱希斯克利夫——'我就是希斯克利夫'——却选择嫁给温和富有的埃德加·林顿。这个错误的选择撕裂了她自己的灵魂。" },
    { name: "耐莉·迪恩", role: "叙述者", description: "呼啸山庄和画眉田庄的管家，全部故事的讲述者。她的'普通常识'与故事中的狂暴情感形成奇妙的张力。" },
  ],
  "great-expectations": [
    { name: "皮普", role: "主人公/叙述者", description: "一个孤儿，从贫穷的铁匠学徒变成伦敦的'绅士'。他以为自己的远大前程来自郝薇香小姐的恩赐——但真相远比他想象的更残酷。" },
    { name: "郝薇香小姐", role: "重要人物", description: "在新婚当天被抛弃的富家老处女。她从此让所有钟表停在那个时刻，穿着从未穿过的婚纱在荒废的豪宅中腐烂——收养艾丝黛拉并把她培养成'让男人心碎的武器'。" },
    { name: "艾丝黛拉", role: "女主角", description: "郝薇香小姐的养女，被培养成一个冷漠而美丽的'复仇工具'。皮普一生爱她，但她被教导'没有心'。" },
    { name: "马格韦契", role: "关键人物", description: "一个逃犯，皮普小时候帮助过他。多年后真相揭露——他才是皮普'远大前程'的真正资助者。" },
  ],
  "middlemarch": [
    { name: "多萝西娅·布鲁克", role: "女主角", description: "一个充满理想主义热情的年轻女子，嫁给了年长的学究卡苏朋，以为可以协助他完成伟大的学术著作——但她很快发现他的'伟大研究'不过是一个空洞的幻影。" },
    { name: "特蒂斯·利德盖特", role: "男主角", description: "一位年轻医生，怀抱着改革医学的理想来到米德尔马契。但他的理想在娶了美丽而虚荣的罗莎蒙德之后逐渐被日常压力侵蚀。" },
    { name: "爱德华·卡苏朋", role: "重要人物", description: "多萝西娅的丈夫，一个枯槁的学究。他耗费一生研究一部永远不会完成的'世界神话体系'。" },
  ],
  "1984": [
    { name: "温斯顿·史密斯", role: "主人公", description: "大洋国真理部的小职员，篡改历史记录是他的工作。但他内心深处渴望真相和自由——'思想罪并不导致死亡：思想罪就是死亡'。" },
    { name: "茱莉亚", role: "女主角", description: "一个年轻的女性党员，表面热心于党的活动，私下却是'肉体反叛者'。她与温斯顿的恋情是全书唯一温暖的光。" },
    { name: "奥布赖恩", role: "反派", description: "核心党党员，温斯顿以为的'同道反叛者'。他在101号房间里以极端折磨摧毁了温斯顿的精神——极权主义逻辑的活体化身。" },
  ],
  "ulysses": [
    { name: "利奥波德·布卢姆", role: "主人公", description: "一个犹太裔广告推销员，在1904年6月16日的都柏林街头漫游了一天。他平庸、仁慈、被轻视——但乔伊斯在他的日常中发现了史诗般的尊严。" },
    { name: "斯蒂芬·迪达勒斯", role: "第二主人公", description: "一个年轻的知识分子，与布卢姆在同一天漫游都柏林。布卢姆在半夜的妓院中救了他——两个孤独的灵魂完成了'精神父子'的相认。" },
    { name: "莫莉·布卢姆", role: "女主角", description: "布卢姆的妻子，一个歌手。全书以她长达四十页无标点的内心独白结束——她在回忆与布卢姆最初的爱情中，以'Yes'收束了整部小说。" },
  ],
  "madame-bovary": [
    { name: "爱玛·包法利", role: "女主角", description: "一个被浪漫小说喂养长大的乡村医生之妻。她无法忍受平庸的婚姻生活，通过婚外情和奢侈消费来逃避现实——但情人们的背叛和高利贷者的逼迫最终将她推向了砒霜。" },
    { name: "夏尔·包法利", role: "丈夫", description: "爱玛的丈夫，一个平庸但善良的乡村医生。他深爱爱玛却完全不了解她——直到她死后在抽屉里发现了所有的情书和当票。" },
    { name: "罗多尔夫", role: "爱玛的情人", description: "一个富有的地主，以猎艳为乐。他引诱了爱玛却在她准备私奔的前夜写了诀别信——'命运'是他为自己开脱的借口。" },
  ],
  "les-miserables": [
    { name: "冉阿让", role: "主人公", description: "为饥饿的侄子偷了面包而被判十九年苦役。出狱后被主教以银器相赠，洗心革面，以'马德兰'之名成为市长。但他的一生都被警长沙威追捕——他的逃亡与救赎构成了这部史诗的灵魂。" },
    { name: "沙威", role: "追捕者", description: "法律绝对化身的警长。他对冉阿让的穷追不舍不是出于个人恩怨而是对'法律'的盲目信仰。当冉阿让在街垒战中饶他一命后，他的世界观崩塌——最终投入塞纳河自尽。" },
    { name: "芳汀", role: "悲剧女性", description: "被情人抛弃的年轻女工，为养活女儿珂赛特卖了头发、牙齿，最后卖了自己。她的悲剧是对社会冷漠的最血泪控诉。" },
    { name: "珂赛特", role: "女主角", description: "芳汀的女儿，在贪婪的德纳第夫妇家受尽虐待。冉阿让将她救出并抚养成人，她与马吕斯的爱情成为小说中的希望之光。" },
  ],
  "in-search-of-lost-time": [
    { name: "马塞尔", role: "叙述者/主人公", description: "从贡布雷的童年到巴黎的沙龙，他将自己的一生化为这座文字的教堂——最终发现唯一真实的天堂是已经失去的天堂。" },
    { name: "斯万", role: "重要人物", description: "叙述者家族的朋友，一个优雅的犹太裔鉴赏家。他对交际花奥黛特的痴迷之爱构成了小说中最令人心碎的篇章。" },
    { name: "阿尔贝蒂娜", role: "女主角", description: "叙述者爱恋的对象，一个谜一般的少女。叙述者将她'囚禁'在自己身边以占有她——但她有一天不告而别，不久后坠马身亡。" },
  ],
  "the-stranger": [
    { name: "默尔索", role: "主人公/叙述者", description: "阿尔及尔的小职员，以令人不安的冷漠面对一切——母亲的死亡、恋人的求婚、自己的杀人行为。他因'在母亲葬礼上没有哭'而被判死刑，这荒谬的判决映照了人类存在的荒谬本质。" },
    { name: "玛丽", role: "女友", description: "默尔索的女友，她爱默尔索却始终无法理解他的冷漠。她代表了正常人对荒谬者的不可能的理解。" },
  ],
  "the-plague": [
    { name: "里厄医生", role: "主人公/叙述者", description: "奥兰城的医生，在鼠疫爆发后日以继夜地救治病人。他从不说大话，只是做自己该做的事——'与瘟疫斗争的唯一方式就是正直'。" },
    { name: "塔鲁", role: "重要人物", description: "一个外地来的访客，组织了卫生防疫队。他与里厄的深夜对话是全书的思想核心——他在鼠疫即将结束前夕死于疾病。" },
    { name: "帕纳卢神父", role: "重要人物", description: "耶稣会神父，在鼠疫初期宣称这是上帝对罪恶之城的惩罚。但当他看到一个无辜孩子在鼠疫中痛苦死去时，他的信仰受到了毁灭性考验。" },
  ],
  "war-and-peace": [
    { name: "皮埃尔·别祖霍夫", role: "主人公", description: "一个继承了巨额遗产的私生子，笨拙而理想主义。他在拿破仑战争的洗礼中经历了信仰的挣扎——从共济会到战俘营，最终在朴素智慧中找到了内心的平静。" },
    { name: "安德烈·博尔孔斯基", role: "主人公", description: "一个厌世的贵族军官，在奥斯特利茨战役中躺在战场上仰望天空时领悟了所有荣耀的虚无。他与娜塔莎的爱情是他重返生活的唯一希望。" },
    { name: "娜塔莎·罗斯托娃", role: "女主角", description: "一个充满生命力的少女，她的歌声是小说的心跳。她从天真到幻灭再到成熟的成长历程使她成为世界文学中最动人的女性形象之一。" },
    { name: "拿破仑", role: "历史人物", description: "托尔斯泰笔下的拿破仑是被历史洪流裹挟而不自知的'伟人'——他以为自己掌控了千军万马，实际上只是'历史的奴隶'。" },
  ],
  "anna-karenina": [
    { name: "安娜·卡列尼娜", role: "女主角", description: "彼得堡上流社会贵妇，为爱情放弃了丈夫、儿子和社会地位。但伏伦斯基的爱没能经得起时间考验——在绝望中，安娜投身于火车轮下。" },
    { name: "伏伦斯基", role: "男主角", description: "英俊的年轻军官，热烈追求安娜并让她离开了丈夫。但他的爱有保质期——当安娜以全部生命赌注投入时，他却发现自己的感情在消退。" },
    { name: "康斯坦丁·列文", role: "平行主人公", description: "一个乡间地主，在农事劳作、家庭生活和信仰探索中寻找人生意义——他的'幸福'线索与安娜的'悲剧'线索构成了小说的对位结构。" },
    { name: "阿列克谢·卡列宁", role: "安娜的丈夫", description: "彼得堡高级官僚，刻板、冷漠，更像一个'行政装置'而非活人。当安娜离开他时，他关心的不是失去了妻子而是'别人会怎么想'。" },
  ],
  "brothers-karamazov": [
    { name: "阿辽沙", role: "主人公", description: "三兄弟中的老三，修道院的见习修士。他是陀思妥耶夫斯基理想中的'完全美好的人'——纯真、善良、对所有人怀有深沉的同情。" },
    { name: "伊万", role: "二哥", description: "一个理性的无神论者。'如果天堂的和谐是以一个无辜孩子的眼泪为代价，我恭敬地把我的门票退还'——他与阿辽沙的'宗教大法官'对话是西方文学中最深刻的信仰辩论。" },
    { name: "德米特里", role: "大哥", description: "一个被激情驱使的感官主义者——酗酒、狂欢、与父亲争夺同一个女人。父亲被杀害后他被控谋杀——虽然在法律上无辜，但他承认自己'在灵魂中'已经犯了罪。" },
    { name: "费奥多尔·卡拉马佐夫", role: "父亲", description: "三兄弟的父亲，一个卑劣而贪婪的丑角式人物。他是'卡拉马佐夫气质'最原始的形态。他的被谋杀是小说的核心事件。" },
    { name: "斯梅尔佳科夫", role: "关键人物", description: "费奥多尔的私生子兼厨子。他将伊万的'上帝不存在则一切皆可'推理到逻辑终点——真正实施了谋杀。" },
  ],
  "cherry-orchard": [
    { name: "柳博芙·拉涅夫斯卡娅", role: "女主角", description: "从巴黎归来的没落贵族女主人。她善良、慷慨却不切实际——明知道樱桃园将被拍卖，却仍在巴黎餐馆给侍者一卢布小费。" },
    { name: "罗帕欣", role: "重要人物", description: "一个出身农奴之家的富商。他最终买下了樱桃园——那个曾经拥有他祖父和父亲的庄园。他是新时代的化身，也是旧时代的终结者。" },
    { name: "特罗菲莫夫", role: "重要人物", description: "'永远的学生'，向安尼雅宣扬'整个俄罗斯就是我们的花园'的理想主义——契诃夫笔下新时代的声音。" },
  ],
  "faust": [
    { name: "浮士德", role: "主人公", description: "一位博学多识的博士，在书斋中耗尽一生却发现——'我知道我什么都不知道'。他与魔鬼梅菲斯特订下赌约：如果他能体验到真正的满足，灵魂就归魔鬼所有。" },
    { name: "梅菲斯特", role: "魔鬼/对立者", description: "否定的精灵——'我是一切永远否定着的精灵'。他不是以暴力而是以诱惑来考验浮士德，是文学中最迷人的'魔鬼'之一。" },
    { name: "格蕾琴", role: "悲剧女性", description: "一个纯洁的平民少女，被浮士德的爱所毁灭——她无意中毒死了母亲、兄长被恋人杀死、她在疯狂中溺死了自己的孩子。但她在最后时刻拒绝了浮士德的援救——她的救赎是整部诗中唯一的'恩典'。" },
  ],
  "magic-mountain": [
    { name: "汉斯·卡斯托普", role: "主人公", description: "一个年轻的汉堡工程师，因表兄生病来到瑞士山中的疗养院。原计划停留三周，却在那里度过了七年——在'魔山'中接受了疾病、死亡与人生哲学的全面'教育'。" },
    { name: "塞特姆布里尼", role: "导师", description: "一个意大利人文主义者，代表着启蒙运动的光明、理性与进步理想。在一战面前，他的乐观人文主义显得苍白无力。" },
    { name: "纳夫塔", role: "对立导师", description: "一个皈依天主教的犹太裔耶稣会士，代表着极端主义和神秘主义。他与塞特姆布里尼之间的持续辩论构成了小说思想的磁场。" },
  ],
  "the-trial": [
    { name: "约瑟夫·K", role: "主人公", description: "一个银行高级职员，在三十岁生日那天早晨被神秘法庭逮捕——但他从未被告知罪名。在试图为自己辩护的一年中，他越陷越深地卷入荒谬得令人窒息的'司法系统'。" },
  ],
  "metamorphosis": [
    { name: "格里高尔·萨姆沙", role: "主人公", description: "一个推销员，一天早晨醒来发现自己变成了一只巨大的甲虫。他的家人从最初的震惊到勉强容忍到最终厌恶——他的变形是关于异化、家庭与人性丧失的永恒寓言。" },
    { name: "格蕾特", role: "妹妹", description: "格里高尔的妹妹，最初最关心他的人。但随时间推移，她对'怪物'哥哥的耐心和爱逐渐耗尽——她最后说出'它必须离开'是对亲情脆弱性的最冷峻揭示。" },
  ],
  "waiting-for-godot": [
    { name: "弗拉基米尔（迪迪）", role: "主人公", description: "两个流浪汉中的一个，更倾向于思考和希望。他在一棵光秃秃的树下等待戈多——一个从未出现在舞台上、也永远不会来的'救赎者'。" },
    { name: "爱斯特拉冈（戈戈）", role: "主人公", description: "另一个流浪汉，更倾向于悲观和遗忘。他的脚总是疼，他反复脱鞋又穿上——这些无意义的重复动作就是人类处境的缩影。" },
  ],
  "dolls-house": [
    { name: "诺拉·海尔默", role: "女主角", description: "一个看似被丈夫宠爱的'小云雀'。当她的秘密暴露时，她期待的'奇迹'——丈夫为她挺身而出——没有发生。她摔门离开的声音震动了整个欧洲。" },
    { name: "托瓦尔德·海尔默", role: "丈夫", description: "诺拉的丈夫，一个刚升职的银行经理。他口口声声说爱诺拉，但当她的秘密暴露时，他的第一反应是——'我的前途毁了！'" },
  ],

  // ==================== 核心库 — 非洲 ====================

  "arrow-of-god": [
    { name: "埃泽乌鲁", role: "主人公", description: "伊博族祭司长乌姆阿罗的守护者。被夹在传统信仰与殖民统治之间——他的固执和骄傲使他失去了族人的信任，最终发疯而死。" },
    { name: "温特波特姆", role: "殖民官员", description: "英国殖民地官员，试图以'理性'方式管理伊博地区。他并非邪恶但完全无法理解伊博文化——他的'好意'造成的破坏不比直接的暴力更少。" },
  ],
  "grain-of-wheat": [
    { name: "穆戈", role: "主人公", description: "一个沉默寡言的村民，被整个村庄视为反抗英国殖民统治的英雄。但所有人都不知道——他正是出卖茅茅运动领袖基希卡的叛徒。" },
    { name: "基希卡", role: "重要人物", description: "茅茅运动游击队领袖，被殖民政府抓获并处死。他的名字成为肯尼亚独立斗争的象征——但他的被出卖揭示了革命中的人性阴暗面。" },
  ],
  "disgrace": [
    { name: "戴维·卢里", role: "主人公", description: "开普敦大学的白人文学教授，因与女学生的丑闻被学校开除后逃到女儿露西的农场，被迫面对后种族隔离时代南非的暴力现实。" },
    { name: "露西", role: "重要人物", description: "卢里的女儿，一个选择留在南非土地上的白人女性。被强暴后选择不报警——她的选择代表了后种族隔离时代一种痛苦的生存策略。" },
  ],
  "so-long-a-letter": [
    { name: "拉玛图拉耶", role: "叙述者/主人公", description: "塞内加尔穆斯林女性，丈夫去世后以一封长信向好友倾诉一生——丈夫晚年娶了她女儿的年轻同学，这种背叛使她重新审视婚姻、宗教和女性身份。" },
  ],
  "gods-bits-of-wood": [
    { name: "巴卡约科", role: "主人公", description: "铁路工人罢工运动的领袖，一个具有超凡魅力的组织者。他将不同种族、不同地区的工人团结在一起。" },
    { name: "拉玛", role: "重要人物", description: "罢工运动中的女性领袖之一。在男性工人被困于谈判时，她带领妇女们走上街头。" },
  ],
  "children-of-gebelawi": [
    { name: "格贝拉维", role: "象征人物", description: "开罗小���的创立者，一个缺席的父亲。他的后代——分别对应亚当、摩西、耶稣和穆罕默德——轮流试图从小巷的暴君手中解放人民，但每次都失败。" },
  ],
  "efuru": [
    { name: "埃弗鲁", role: "女主角", description: "一个美丽而勤劳的伊博族女性，经历了两次不幸的婚姻。女儿夭折后她将精力转向宗教——最终被'湖之女神'选中为祭司。" },
  ],
  "joys-of-motherhood": [
    { name: "恩努埃戈", role: "女主角", description: "一个在殖民时期拉各斯挣扎求存的母亲。为儿女奉献一切，期望晚年享受'为母之乐'——但受过西方教育的孩子们最终遗弃了她，她孤独地死在路边。" },
  ],
  "weep-not-child": [
    { name: "恩乔罗格", role: "主人公", description: "一个在茅茅起义期间成长的肯尼亚男孩。他的家庭被卷入殖民统治与独立斗争的漩涡——他从天真的孩子成长为被迫直面暴力的青年。" },
  ],
  "season-of-migration": [
    { name: "穆斯塔法·萨伊德", role: "主人公", description: "一个在英国获得经济学博士学位的苏丹人。他以自己的性魅力为武器在伦敦'反向殖民'白人女性——但最终无法在任何文化中找到归属，在尼罗河中神秘溺亡。" },
    { name: "叙述者", role: "叙述者", description: "回到家乡的苏丹知识分子，穆斯塔法死后成为他的遗嘱执行人。在试图理解穆斯塔法的过程中，发现自己与穆斯塔法的距离远比想象中更近。" },
  ],
  "the-beautyful-ones": [
    { name: "无名之人", role: "主人公", description: "加纳独立后一个拒绝腐败的铁路职员。他在无处不在的腐败中坚持'干净'——'美丽者尚未诞生'。他的清廉在一个全面腐败的社会中既光荣又无力。" },
  ],
  "nervous-conditions": [
    { name: "坦布", role: "叙述者/主人公", description: "罗得西亚乡村女孩，渴望通过教育改变命运。被叔叔接到英国化了的家中生活，但在'文明'与'传统'之间找不到安稳的位置。" },
    { name: "妮雅莎", role: "重要人物", description: "坦布的表姐，在英国受教育的'非洲公主'。她的厌食症不是生理疾病而是精神困境——对'被塑造'为完美非洲女性的无声抗议。" },
  ],
  "houseboy": [
    { name: "图迪", role: "叙述者/主人公", description: "一个喀麦隆男孩，在法国殖民者的家庭中做家仆。他的日记记录了在主人世界中所目睹的荒谬与残酷——最终死于法国殖民地丛林监狱中。" },
  ],
  "the-palm-wine-drinkard": [
    { name: "棕榈酒鬼", role: "叙述者/主人公", description: "一个嗜棕榈酒如命的人，当酒保死后踏上前去亡灵之城寻找酒保的旅途——在约鲁巴民间传说的奇异世界中遭遇各种超自然考验。" },
  ],
  "mine-boy": [
    { name: "徐马", role: "主人公", description: "一个从乡村来到约翰内斯堡金矿工作的青年。在种族隔离的残酷现实中，从被动忍耐逐渐走向政治觉醒——南非城市化进程中无数非洲劳工的缩影。" },
  ],

  // ==================== 核心库 — 美洲 ====================

  "love-in-cholera": [
    { name: "弗洛伦蒂诺·阿里萨", role: "男主角", description: "一个电报员兼诗人，年轻时爱上费尔明娜·达萨。她嫁了别人，他等了五十一年九个月零四天——期间发展了622次情事，但声称始终只爱她一人。" },
    { name: "费尔明娜·达萨", role: "女主角", description: "一个美丽而务实的女性。年轻时浪漫地回应弗洛伦蒂诺的爱——但在一次偶遇中突然'看见'真实的他并拒绝。她嫁给了乌尔比诺医生，度过了半个世纪体面的婚姻。" },
    { name: "胡维纳尔·乌尔比诺医生", role: "重要人物", description: "费尔明娜的丈夫，受人尊敬的医生和社会改革者。他的婚姻是'理性的爱'——在爬梯子捉鹦鹉时不慎坠亡，为弗洛伦蒂诺的第二次告白扫清了道路。" },
  ],
  "ficciones": [
    { name: "博尔赫斯", role: "作者/叙述者", description: "阿根廷最伟大的作家，以短篇小说重新定义了文学的可能性。他的故事充满了图书馆、迷宫、镜子与分岔的时间——'天堂应该是图书馆的模样'。" },
  ],
  "pedro-paramo": [
    { name: "胡安·普雷西亚多", role: "叙述者", description: "一个男人按母亲临终遗言来到科马拉寻找父亲佩德罗·巴拉莫。他逐渐发现镇上所有居民——包括他自己——都是亡魂。他的声音最终在坟墓中熄灭。" },
    { name: "佩德罗·巴拉莫", role: "主人公", description: "科马拉的地主，一个冷酷无情的人。他一生所爱的女人苏珊娜至死不爱他——在他漫长的等待和幻灭中，整个科马拉也随之枯萎。" },
  ],
  "house-of-spirits": [
    { name: "克拉拉", role: "女族长", description: "特鲁埃瓦家族的女族长，拥有通灵和预知能力。她九岁起就保持沉默，以一种超然的温柔成为整个家族的精神核心。" },
    { name: "埃斯特万·特鲁埃瓦", role: "男族长", description: "一个暴力而激情的男人，以铁腕统治家族和土地，却无法控制超自然的'幽灵'和历史的风暴。" },
    { name: "阿尔芭", role: "第三代人", description: "克拉拉的孙女，被政权的秘密警察逮捕和折磨。她以书写来对抗创伤——她的叙事本身就是政治反抗和家族记忆的延续。" },
  ],
  "canto-general": [
    { name: "聂鲁达", role: "诗人/叙述者", description: "智利最伟大的诗人，1971年诺贝尔文学奖得主。《漫歌》是他献给整个拉丁美洲的史诗——从玛雅金字塔到安第斯山矿工。" },
  ],
  "hopscotch": [
    { name: "奥拉西奥·奥利维拉", role: "主人公", description: "一个阿根廷知识分子，在巴黎过着波西米亚式的生活。在爵士乐、哲学思辨和爱情中，他试图跳过'房子'直接抵达'天空'——但跳房子的游戏没有捷径。" },
    { name: "玛伽", role: "女主角", description: "奥利维拉在巴黎的恋人，一个未受正规教育但拥有直觉智慧的女性。她是奥利维拉的'反面'——当他在智力迷宫中迷失时，她以本能直指事物本源。" },
  ],
  "time-of-hero": [
    { name: "捷豹", role: "主人公之一", description: "利马军事学校中的少年学员。他们在森严的等级制度和暴力规训中挣扎——军事体制如何将少年变成'英雄'或变成恶魔。" },
    { name: "诗人", role: "学员", description: "军校中最敏感的学员，以写作和幻想来抵抗暴力环境的同化。他在这个'微缩版秘鲁社会'中努力保持自己的人性。" },
  ],
  "death-of-artemio-cruz": [
    { name: "阿尔特米奥·克罗斯", role: "主人公", description: "一个墨西哥革命的战斗英雄，后来变成了他曾经反对的那种腐败寡头。在临终的病床上，他的意识在过去、现在和未来之间不断切换。" },
  ],
  "moby-dick": [
    { name: "以实玛利", role: "叙述者", description: "全书唯一的幸存者，故事的讲述者。'叫我以实玛利'——他上船是为了逃避陆地上压迫性的自我，却撞进了一场人与命运的终极战争。" },
    { name: "亚哈船长", role: "主人公", description: "裴廓德号的独腿船长，被白鲸莫比·迪克咬断了一条腿后以恶魔般的执念追杀这条鲸。他不是在与鲸鱼作战——是在与整个宇宙的'恶'和'冷漠'对抗。" },
    { name: "魁魁格", role: "重要人物", description: "来自南海岛屿的原住民鱼叉手，以实玛利在旅店中与他同床共枕——他们跨越种族、文化和宗教的友谊是梅尔维尔对19世纪文明偏见的优雅反驳。" },
  ],
  "leaves-of-grass": [
    { name: "沃尔特·惠特曼", role: "诗人/抒情主体", description: "美国最伟大的诗人。'我歌颂我自己，我歌唱自己'——惠特曼以'我'包容了全美国的多元声音，以自由诗体打破了英国传统的韵律锁链。" },
  ],
  "huckleberry-finn": [
    { name: "哈克贝利·费恩", role: "叙述者/主人公", description: "一个密西西比河边长大的野孩子，与逃奴吉姆一起沿河漂流。他最终'决定下地狱'也不出卖朋友——在人性的善良与法律的恶之间做出了选择。" },
    { name: "吉姆", role: "重要人物", description: "沃森小姐的黑奴，逃跑后与哈克在河上相遇。他粗鲁、迷信但心地善良——在漂流中扮演了哈克真正的'父亲'角色。" },
  ],
  "great-gatsby": [
    { name: "杰伊·盖茨比", role: "主人公", description: "出身贫寒的詹姆斯·盖兹通过非法私酒成为百万富翁，在西卵买下豪宅——只为看着海湾对岸黛西家那盏绿灯。他的'了不起'在于将整个生命投注到一个梦想之中。" },
    { name: "尼克·卡拉威", role: "叙述者", description: "一个来自中西部的年轻人，搬到盖茨比隔壁成为整个悲剧的见证者和讲述者。" },
    { name: "黛西·布坎南", role: "女主角", description: "盖茨比一生追逐的对象——'她的声音里充满了金钱'。她曾爱过盖茨比，但她更爱安全感和地位。她的浅薄和自私是美国梦空洞内核的化身。" },
  ],
  "sound-and-fury": [
    { name: "班吉", role: "叙述者之一", description: "康普生家的智障儿子。他的意识流没有时间顺序——但在这片'混乱'中，他是唯一还保留着爱和善的能力的人。" },
    { name: "昆丁", role: "叙述者之一", description: "康普生家长子，在哈佛大学学习。被妹妹凯蒂的'失贞'所困扰——不是因为道德而是对'秩序'的病态执念。最终在查尔斯河投水自尽。" },
    { name: "杰森", role: "叙述者之一", description: "康普生家三子，一个冷酷自私的'实用主义者'。以照顾为名侵吞外甥女的抚养费——代表了美国南方传统沦丧后的道德真空。" },
    { name: "凯蒂", role: "核心女性", description: "康普生家的女儿，全书所有痛苦的源头——但她本人从未获得叙事权。她是世界文学中最伟大的'不在场'。" },
  ],
  "old-man-and-sea": [
    { name: "圣地亚哥", role: "主人公", description: "一个年迈的古巴渔夫，连续八十四天没有捕到鱼。第八十五天独自出海钓到十八英尺长的大马林鱼——在这场搏斗中证明了一个人可以被打败但不能被摧毁。" },
    { name: "马诺林", role: "男孩/徒弟", description: "曾跟随圣地亚哥打鱼的男孩。虽然父母禁止他再上老人的船，但他始终照顾着老人——代表了年轻一代对传统价值的继承。" },
  ],
  "beloved": [
    { name: "赛丝", role: "主人公", description: "一个逃出奴隶制的黑人女性，在追捕者逼近时割断了幼女的喉咙——'为了不让她回到那地方去'。十八年后一个叫'宠儿'的神秘少女的到来仍在审判她的选择。" },
    { name: "宠儿", role: "神秘人物", description: "一个出现在赛丝家门口的少女，拥有一个婴儿的意识。她可能是赛丝死去的女儿的鬼魂——'她不是一个人，她是六十亿人'。" },
    { name: "保罗·D", role: "重要人物", description: "赛丝从前在'甜蜜之家'庄园的难友，十八年后出现在赛丝门前。他的爱给了赛丝对未来的希望——但当宠儿的秘密被揭示后，他被'太深'的爱所吓退。" },
  ],
  "invisible-man": [
    { name: "无名叙述者", role: "主人公", description: "一个匿名的非裔美国青年，从南方黑人学院到纽约地下种族政治——他一生都在试图被'看见'，却发现所有试图'看见'他的人只是把他投射为自己的幻象。最终选择退入地下。" },
  ],
  "lolita": [
    { name: "亨伯特·亨伯特", role: "叙述者/主人公", description: "一个欧洲移民学者，恋童癖者。他以令人难以置信的华美散文为自己对十二岁少女洛丽塔的罪行辩护——他是文学史上最危险的叙述者：以自己的文采把读者变成共谋。" },
    { name: "洛丽塔", role: "女主角", description: "一个普通的美国少女，被亨伯特囚禁在他的欲望叙事之中。她没有小说中亨伯特赋予的'性感'——她只是一个失去母亲、被成年男子控制的无助孩子。" },
  ],
  "catcher-in-the-rye": [
    { name: "霍尔顿·考尔菲尔德", role: "叙述者/主人公", description: "一个被学校开除的十六岁少年，在纽约街头漫游三天。他讨厌'假惺惺'的成人世界——唯一想做的事是站在麦田悬崖边上接住每一个跑过来的孩子。" },
    { name: "菲比", role: "妹妹", description: "霍尔顿的十岁妹妹，全书唯一他毫无保留喜欢的人。在旋转木马上，她原谅了霍尔顿的所有失败。" },
  ],
  "to-kill-mockingbird": [
    { name: "斯库特·芬奇", role: "叙述者/主人公", description: "一个六岁的南方女孩，用孩子纯真的视角观察着亚拉巴马小镇上的种族偏见。在父亲阿提克斯的影响下，学会了'站在别人的鞋子里走路'。" },
    { name: "阿提克斯·芬奇", role: "父亲/英雄", description: "斯库特的父亲，一个正直的白人律师。他接下为被诬告强暴的黑人汤姆·鲁滨逊辩护的案子——明知会输但坚持战斗。" },
    { name: "布·拉德利", role: "神秘邻居", description: "常年闭门不出的隐居者，是镇上孩子们幻想中的'怪物'。在小说结尾从阴影中走出救了斯库特和杰姆的命——他就是那只知更鸟。" },
  ],
  "dom-casmurro": [
    { name: "本托·圣地亚哥", role: "叙述者/主人公", description: "绰号'堂卡斯穆罗'的叙述者，回顾一生——从少年恋爱到对妻子卡皮图背叛的'发现'。他是否真的被背叛了？全书以第一人称叙事引诱读者相信——然后让我们怀疑。" },
    { name: "卡皮图", role: "女主角", description: "本托的少年恋人和妻子，拥有'潮汐般的眼睛'。她是否真的出轨了？她的形象完全被本托的视角所中介——文学史上最著名的悬案之一。" },
  ],
  "labyrinth-of-solitude": [
    { name: "奥克塔维奥·帕斯", role: "作者/思考者", description: "墨西哥诗人、1990年诺贝尔文学奖得主。在这部散文中剖析墨西哥国民性——假面、节日与死亡——同时追问所有现代文明中迷失的灵魂。" },
  ],
  "the-devils-to-pay": [
    { name: "里奥巴尔多", role: "叙述者/主人公", description: "巴西腹地的一个牛仔，向一位城市医生讲述了自己在荒野中的全部人生——爱情、战斗、与魔鬼的对峙。他的长篇独白将巴西内陆的声音升华为世界文学杰作。" },
  ],

  // ==================== 核心库 — 大洋洲 ====================

  "voss": [
    { name: "沃斯", role: "主人公", description: "一个德国探险家，以近乎宗教般的狂热试图穿越澳大利亚内陆。在远征的每个阶段，他都在精神上与劳拉对话——最终在荒野中被原住民杀死。" },
    { name: "劳拉", role: "女主角", description: "一个在悉尼收养家庭中生活的年轻女性。她与沃斯之间有着比爱情更深的精神纽带——在沃斯远征期间，她在高烧中'见证'了他的死亡。" },
  ],
  "the-bone-people": [
    { name: "克雷文", role: "主人公之一", description: "一个隐居的毛利裔艺术家，独自生活在新西兰海岸的塔中。她收留了被遗弃的哑巴男孩西蒙——但她的爱与暴力纠缠在一起。" },
    { name: "西蒙", role: "男孩", description: "一个在海难中幸存后失语的白人男孩。他无法说话却以激烈的方式表达自己——他的暴躁与脆弱将克雷文和毛利工人乔都卷入了爱与暴力的循环。" },
    { name: "乔", role: "毛利工人", description: "被克雷文雇用的毛利工人，后成为这个'三口之家'的第三个成员。他有着温柔的本性，但酒精唤醒了他内在的暴力。" },
  ],
  "oscar-and-lucinda": [
    { name: "奥斯卡·霍普金斯", role: "男主角", description: "一个英国牧师，却是一个无可救药的赌徒。他相信上帝掌管一切——包括骰子的点数。在驶往澳大利亚的船上和悉尼，他与露辛达的赌局从信仰延伸到爱情。" },
    { name: "露辛达·勒普拉斯特莉", role: "女主角", description: "一个继承了玻璃工厂的澳大利亚女继承人，也是一个沉迷赌博的女性。她与奥斯卡打赌——赌他能否将一座玻璃教堂完好无损地沿河运送到目的地。" },
  ],
  "the-tree-of-man": [
    { name: "斯坦·帕克", role: "男主角", description: "一个澳大利亚拓荒者，在悉尼远郊荒野中开辟了自己的农场。他的沉默与坚韧是澳洲移民精神的写照——在自己的土地上活过了一生。" },
    { name: "艾米·帕克", role: "女主角", description: "斯坦的妻子，以女性的韧性和对美的渴望在荒野中守护着家。她的内心世界——那些斯坦无法理解的情感和欲望——是她个人的秘密花园。" },
  ],
  "once-were-warriors": [
    { name: "杰克·赫克", role: "主人公之一", description: "一个失业的毛利工人，曾经是'战士'——在祖先曾以矛作战的地方，他现在以拳头在酒吧中'战斗'。他的暴力和自毁使整个家庭陷入痛苦。" },
    { name: "贝丝·赫克", role: "女主角", description: "杰克的妻子，毛利部落首领的后代。她挣扎于对杰克的爱与恐惧之间——失去一个女儿后终于觉醒：必须为剩下的孩子们而战斗。" },
  ],
  "true-history-kelly-gang": [
    { name: "内德·凯利", role: "叙述者/主人公", description: "澳大利亚最著名的丛林大盗，在给女儿写的'信'中讲述了自己的全部人生。在彼得·凯里笔下，这个民间英雄有了完全属于自己的声音——粗野、温柔、令人心碎。" },
  ],
  "carpentaria": [
    { name: "诺姆·凡特姆", role: "主人公", description: "卡彭塔利亚湾小镇德斯珀兰斯的原住民老人。他以混合了原住民神话和现代意识的声音讲述原住民社区与矿业公司之间的斗争。" },
  ],

  // ============================================
  // 扩充库 — 亚洲
  // ============================================

  "manyoshu": [
    { name: "额田王", role: "歌人", description: "飞鸟时代最杰出的宫廷女歌人，以恋爱赠答歌闻名。《万叶集》中收录了她的十二首长歌和短歌——她与大海人皇子（后来的天武天皇）之间的文学性恋歌是日本和歌最早的经典。" },
    { name: "柿本人麻吕", role: "歌圣", description: "《万叶集》最重要的编纂者和歌人，被誉为'歌圣'。他的挽歌和仪礼歌以宏大的修辞和精准的情感捕捉了日本古代贵族的精神世界。" },
    { name: "大伴家持", role: "编纂者/歌人", description: "《万叶集》最后阶段的编纂者，也是万叶后期最重要的歌人。他以细腻的自然咏叹拉开了平安时代和歌美学的序幕。" },
  ],

  "tsurezuregusa": [
    { name: "吉田兼好", role: "作者/随笔家", description: "镰仓末至南北朝时代的遁世僧，曾担任宫中官职，三十岁后出家隐居。他以'徒然'（无所事事）的心境写成二百四十三段随笔，涵盖无常观、处世智慧与审美趣味——日本三大随笔之一。" },
  ],

  "hojoki": [
    { name: "鸭长明", role: "作者/隐士", description: "平安末至镰仓时代的下鸭神社神官之子，因权力斗争失意后出家，在日野山麓建造一丈见方的草庵。他以京都大火、大地震和饥荒的亲历为背景写下《方丈记》——日本文学'无常观'最凝练的经典表达。" },
  ],

  "heike-monogatari": [
    { name: "平清盛", role: "平家之首", description: "平氏一门的最高权力者，以铁腕手段将平家推至极盛。但他的傲慢和残暴埋下了平家覆灭的种子——他的死亡是全书的转折点——死前高烧不退、身体如炭火般灼热。" },
    { name: "平敦盛", role: "悲剧人物", description: "平家年轻的武士，须磨之战中被迫与熊谷直实对决——这位吹笛的少年被斩首时年仅十六岁。'敦盛之死'是《平家物语》最著名的名场面，也是'诸行无常'的终极象征。" },
    { name: "琵琶法师", role: "叙述者", description: "盲眼的弹唱艺人，以琵琶伴奏在全日本的街头和寺院中传唱平家的兴亡故事。他们既是史诗的保存者也是创造者——'祇园精舍的钟声，有诸行无常的声响'。" },
  ],

  "oku-no-hosomichi": [
    { name: "松尾芭蕉", role: "行者/俳人", description: "日本江户时代最伟大的俳谐师。在四十六岁时踏上了前往奥州（日本东北）的漫长旅途——以脚丈量荒僻小径，以'寂'（さび）之心在旅途中发现最深刻的自然与人生之美。" },
  ],

  "i-am-a-cat": [
    { name: "猫", role: "叙述者", description: "一只无名之猫，被中学教师苦沙弥捡回家后以一双冷漠而幽默的猫眼观察明治时代知识分子的日常生活。它对人类的愚蠢——'猫又不会用当铺，为什么要当东西呢？'——的冷嘲热讽贯穿全书。" },
    { name: "苦沙弥", role: "猫的主人", description: "一位中学英语教师，代表了夏目漱石对明治时代'文明开化'中知识分子的讽刺性自画像——迂腐、易怒又可爱。" },
  ],

  "no-longer-human": [
    { name: "大庭叶藏", role: "主人公/叙述者", description: "一个生来就无法理解人类社会规则的'异类'。他以'丑角'的面具取悦世人以隐藏自己，从酗酒、吸毒到多次自杀未遂——太宰治的半自传体绝笔，写尽了人的'失格'。" },
    { name: "良子", role: "叶藏的妻子", description: "一个天真无邪到近乎圣洁的年轻女性，是叶藏生命中唯一的信任对象。但她的纯真在被人玷污后——叶藏对人性最后的信仰也随之崩塌。" },
  ],

  "kinkakuji": [
    { name: "沟口", role: "主人公/叙述者", description: "一个从小口吃的年轻僧徒，被金阁寺的'美'所深深吸引——但这种美在他的心中逐渐变成了无法忍受的压迫。他最终放火烧毁了金阁寺——三岛由纪夫以这个真实事件探索了美与毁灭的哲学。" },
    { name: "柏木", role: "沟口的朋友", description: "一个天生畸足的大学生，以尼采式的虚无主义影响沟口——教他用'恶'来报复这个排斥他的世界。他是沟口走向毁灭的推手。" },
  ],

  "woman-in-the-dunes": [
    { name: "仁木顺平", role: "主人公", description: "一个爱好昆虫采集的学校教师，在一次旅行中被骗入沙丘底部的村庄，被迫与一个寡妇一同铲沙。他一次次试图逃离却一次次失败——安部公房以卡夫卡式的寓言追问：被困于重复劳作的我们，是否其实已经'适应'了囚笼？" },
    { name: "沙中女人", role: "女主人公", description: "已经在沙坑中生活了多年的寡妇，她将无止境的铲沙劳作视为理所当然的命运。她与仁木之间的性爱与对抗贯穿全书——她是囚笼本身，也是唯一的伙伴。" },
  ],

  "silence-endo": [
    { name: "塞巴斯蒂安·罗德里斯", role: "主人公", description: "葡萄牙耶稣会传教士，潜入江户时代禁教的日本。当日本基督徒被倒吊在'穴'中遭受酷刑时，他被迫在'踩踏圣像'与'让他人继续受苦'之间做出选择——上帝为什么沉默？远藤周作以这部作品追问了信仰的终极困境。" },
    { name: "吉次郎", role: "重要人物", description: "一个反复叛教又反复忏悔的日本信徒——他的懦弱和背叛与罗德里斯形成对照。'弱者'的信仰是否可能？远藤笔下的吉次郎是最令人心碎的神学追问。" },
  ],

  "rig-veda": [
    { name: "佚名祭司", role: "颂诗作者群", description: "三千多年前的印度-雅利安祭司法系，以口头传承的方式在火祭、月祭和苏摩祭中吟唱这些献给诸神的颂诗。他们不是'作者'而是'看见者'（ṛṣi）——不是发明了这些诗句，而是在冥想中'看见'了永恒的真理。" },
  ],

  "bhagavad-gita": [
    { name: "黑天（克里希纳）", role: "导师/神", description: "毗湿奴的化身，以阿周那的御者身份出现在俱卢之野战场上。他在大战前夕向阿周那揭示了三瑜伽——业瑜伽、智瑜伽与虔信瑜伽——影响了从甘地到奥本海默的无数人。" },
    { name: "阿周那", role: "学生/战士", description: "般度族最伟大的弓箭手，在大战前夕面对将要亲自杀死的亲人、师长与朋友陷入道德瘫痪。他向黑天提出的'为什么要战斗'的追问引出了全书——乃至整个印度哲学——最深邃的回答。" },
  ],

  "the-cloud-dream": [
    { name: "性真", role: "主人公", description: "一位严守戒律的年轻僧人。在梦中他变成了金榜题名的状元，娶了两位佳人，享尽了一生的荣华富贵与悲欢离合——醒来后发现一切不过是一场大梦。金万重以这部朝鲜古典小说的巅峰之作探索了佛教的'色空'主题。" },
  ],

  "the-sound-of-thunder": [
    { name: "周朴园", role: "主人公", description: "煤矿公司董事长，一个封建大家长。三十年前抛弃了使女鲁侍萍，三十年后真相暴露——他的罪恶不仅毁掉了两个家庭，更毁掉了下一代。" },
    { name: "繁漪", role: "女主人公", description: "周朴园的继室，被压抑在封建家庭中像一株在雷雨夜里疯长的藤蔓。她对继子周萍的禁忌之恋和最终的疯狂，使她成为现代戏剧中最惊心动魄的女性形象之一。" },
    { name: "鲁侍萍", role: "悲剧女性", description: "三十年前被周朴园抛弃的使女，三十年后阴差阳错再度进入周公馆——发现自己的一双儿女正重蹈自己的命运。她的隐忍与不幸是旧中国底层女性的缩影。" },
  ],

  "noli-me-tangere": [
    { name: "克里斯托莫·伊瓦拉", role: "主人公", description: "一个从欧洲留学归来的菲律宾青年，怀抱着改革社会的理想。但他很快发现——在西班牙殖民统治和教会权力面前，和平的改良只通往更深的迫害。他是黎刹本人的理想化投影。" },
    { name: "玛利亚·克拉拉", role: "女主角", description: "伊瓦拉的恋人，一个在庇护下长大的美丽少女。她被迫在爱情与家庭的'名誉'之间做出选择——她的悲剧是所有被殖民社会牺牲的女性的象征。" },
  ],

  "truyen-kieu": [
    { name: "翠翘", role: "女主人公", description: "一位才貌双全的少女，为救父亲和弟弟卖身还债——从此坠入妓院、骗局与流亡的十五年苦难。她的'才'与'命'之间的悖论是越南文学最深沉的哀叹。" },
    { name: "金重", role: "翠翘的初恋", description: "翠翘的青梅竹马和终生爱人，在翠翘失散后一生等待。两人最终的'团圆'不是甜蜜的——十五年的沧桑已经让他们永远失去了最初的爱。" },
  ],

  "lusiad": [
    { name: "达·伽马", role: "主人公", description: "葡萄牙航海家，率船队绕过好望角抵达印度。在卡蒙斯笔下，他不仅是历史人物更是民族英雄的史诗原型——众神在奥林匹斯山上争论他远征的命运——荷马与维吉尔的史诗传统被移植到了大航海时代的海洋之上。" },
  ],

  "layla-majnun": [
    { name: "盖斯", role: "男主人公", description: "因爱蕾莉而疯——'马杰农'意为'疯人'。他的疯狂不是病态，而是爱的极致状态——他在荒野中与野兽为伍、为蕾莉吟诗，而人类世界无法容纳这种过于纯粹的爱。" },
    { name: "蕾莉", role: "女主人公", description: "盖斯的挚爱，被家族强行嫁给了另一个男人。她在对盖斯的思念中憔悴死去——波斯文学中最凄美的爱情悲剧，影响了从中东到南亚的所有爱情叙事。" },
  ],

  "divan-hafez": [
    { name: "哈菲兹", role: "诗人/叙述者", description: "波斯最伟大的抒情诗人，设拉子的夜莺。他的诗歌可以在同一时刻被解读为醉酒的情诗或神秘主义的天启——这种'双关'本身就是波斯诗歌美学的最高境界。伊朗人家家户户都备有一本哈菲兹诗集以占卜未来。" },
  ],

  "conference-of-birds": [
    { name: "戴胜鸟", role: "引导者", description: "百鸟的领袖，引导鸟儿们踏上寻找凤凰（Simorgh）的旅程。他既是苏菲导师的象征，也是每个追寻者内心向导的投射。" },
    { name: "三十只鸟", role: "集体主人公", description: "千千万万只鸟踏上寻找凤凰的旅途，穿越七座峡谷后只剩下三十只——当它们最终抵达时发现：'Simorgh'（凤凰）在波斯语中正是'三十只鸟'（si-morgh）——寻找者就是被寻找者本身。" },
  ],

  "quran": [
    { name: "穆罕默德", role: "接受启示者", description: "伊斯兰教的先知，在希拉山洞中接受了大天使吉卜利勒传来的安拉启示——'你应当奉你的创造主的名义而宣读'。这些在二十三年间陆续降示的经文构成了《古兰经》，也是阿拉伯散文无与伦比的文学典范。" },
  ],

  "gulistan": [
    { name: "萨迪", role: "作者/旅行者", description: "十三世纪波斯诗人，一生游历了从埃及到印度的广大地区。他以散文与诗歌交替的形式写成的《蔷薇园》将旅行见闻与道德智慧编织为波斯文学中最富有人文精神的经典——'亚当的子孙都是身体的一部分'刻在了联合国总部的入口。" },
  ],

  // ============================================
  // 扩充库 — 欧洲
  // ============================================

  "oresteia": [
    { name: "阿伽门农", role: "悲剧主人公", description: "远征特洛伊归来的希腊联军统帅，被妻子克吕泰涅斯特拉和她的情夫埃吉斯托斯谋杀了洗澡桶中。他的死亡是第一部的核心事件——复仇的链条由此开始。" },
    { name: "俄瑞斯忒斯", role: "复仇者", description: "阿伽门农之子，被阿波罗神谕命令为父报仇——杀死了自己的母亲克吕泰涅斯特拉。复仇之后他被复仇女神追逐至疯狂，最终在雅典娜主持的法庭上获得了审判与净化——从血亲复仇到城邦法治的文明跃迁。" },
    { name: "克吕泰涅斯特拉", role: "复仇者/王后", description: "阿伽门农的妻子，因丈夫将女儿伊菲革涅亚献祭而怀恨十年。她以'正义'之名杀死了阿伽门农——但她的'正义'不过是复仇循环中的又一环。" },
  ],

  "antigone": [
    { name: "安提戈涅", role: "女主人公", description: "俄狄浦斯之女。国王克瑞翁下令禁止埋葬她的哥哥波吕涅刻斯——因为他是城邦的叛徒。安提戈涅违抗禁令为哥哥行葬礼——'自然法'与'人定法'的不可调和冲突使她成为西方文学中最伟大的女性英雄。" },
    { name: "克瑞翁", role: "对立者", description: "忒拜国王，坚持执政者之法的绝对性——任何违反城邦法令的人都必须被惩罚。他的悲剧在于：他所坚持的'正义'最终吞噬了他自己的家庭。" },
  ],

  "beowulf": [
    { name: "贝奥武夫", role: "主人公", description: "耶阿特人的英雄，渡海到丹麦斩杀了食人巨魔格兰戴尔和它的母亲。五十年后，年老的贝奥武夫独自面对一头毁灭家园的火龙——他的最后一战以生命换来了族人的安全。古英语文学中最伟大的英雄形象。" },
    { name: "格兰戴尔", role: "怪物", description: "该隐的后代，每晚从荒野中潜入丹麦国王赫罗斯加的'鹿厅'吞噬沉睡中的武士。他的孤独和愤怒是黑暗——对光明的大厅中人类欢歌的黑暗反抗。" },
  ],

  "canterbury-tales": [
    { name: "巴斯妇", role: "讲述者之一", description: "一个嫁过五个丈夫的泼辣妇人，以圣经为依据论证'多次婚姻'的合法性。她讲述了一个关于'女人最想要什么'的故事——答案不是美、不是富、而是'主权'。" },
    { name: "磨坊主", role: "讲述者之一", description: "一个粗俗的醉汉，以低俗的性喜剧回应骑士的高雅罗曼史——乔叟以众多来自不同阶层的'朝圣者'构建了一部中世纪的英国社会全景图。" },
    { name: "乔叟", role: "叙述者/朝圣者", description: "作为朝圣者之一的'乔叟'本人，以天真而笨拙的叙述者形象出现——他的'笨'是一种天才的叙事策略，使他能够'客观地'记录所有人的故事。" },
  ],

  "jane-eyre": [
    { name: "简·爱", role: "女主人公/叙述者", description: "一个瘦小贫穷的家庭教师，从小在洛伍德孤儿院学会了忍耐，但她拥有一个'不屈服于任何人'的灵魂。'你以为，因为我穷、低微、不美、矮小，我就没有灵魂、没有心吗？'——她说出了维多利亚时代女性的独立宣言。" },
    { name: "爱德华·罗切斯特", role: "男主人公", description: "桑菲尔德庄园的主人，一个饱经沧桑的拜伦式英雄。他将疯妻关在阁楼里，向简隐瞒了这个秘密——当真相在婚礼上被揭露时，简选择了离开。最终，在一场大火中失去了视力和一只手的罗切斯特获得了简的回归。" },
  ],

  "the-red-and-the-black": [
    { name: "于连·索雷尔", role: "主人公", description: "一个出身木匠之家的外省青年，记忆力超群、野心无限。他用拉丁文圣经作为进驻上流社会的敲门砖——先成为市长夫人德·瑞那的情人，后征服了贵族小姐马蒂尔德。但在即将获得爵位之际，一封揭发信毁掉了一切。他在法庭上的最后陈述是他一生最真实的时刻。" },
    { name: "德·瑞那夫人", role: "于连的第一个情人", description: "市长夫人，一个温柔虔诚的已婚女性。她对年少于连的爱情是她平静生活中第一次也是唯一一次的真正激情——这激情最终毁了她也救了于连的灵魂。" },
  ],

  "the-count-of-monte-cristo": [
    { name: "爱德蒙·唐泰斯", role: "主人公", description: "一个年轻的马赛海员，在婚礼当天被诬陷入狱，在伊夫堡地牢中度过了十四年。越狱后他获得了基督山岛上巨大的宝藏，化身为'基督山伯爵'——一场精心策划的复仇在巴黎上流社会徐徐展开。但复仇的尽头是虚空——'等待与希望'才是他的终极领悟。" },
    { name: "法利亚神父", role: "唐泰斯的导师", description: "伊夫堡狱中的意大利神父，将唐泰斯从一个无知水手培养为博学之士，并透露了基督山岛的宝藏秘密。他在狱中去世——他的死给了唐泰斯越狱的契机。" },
  ],

  "the-three-musketeers": [
    { name: "达达尼昂", role: "主人公", description: "一个来自加斯科涅的穷青年，骑着黄马、带着父亲的三件礼物来到巴黎——'以你的剑求取前程'。他与三位火枪手不打不相识——'人人为我，我为人人'——从此卷入法国宫廷的重重阴谋之中。" },
    { name: "米莱迪", role: "反派", description: "红衣主教黎塞留的秘密特工，一个美貌而致命的女性。她曾是阿多斯的妻子——在左肩上的百合花烙印暴露后，她以全部的智力和魅力展开了复仇。" },
  ],

  "candide": [
    { name: "老实人", role: "主人公", description: "一个头脑简单的德国青年，被莱布尼茨式的乐观主义哲学老师邦葛罗斯教导'我们生活在所有可能世界中最好的那个'。在被逐出城堡后，他遍览了里斯本地震、宗教裁判所、南美奴役——在经历了一切荒谬的苦难后，他说：'应该耕种我们的花园。'" },
    { name: "邦葛罗斯", role: "哲学老师", description: "老实人的老师，不论遭遇任何灾难——从染上梅毒到差点被绞死——都坚定地相信'一切都会好起来'。他的乐观主义是伏尔泰对莱布尼茨神正论最辛辣的讽刺。" },
  ],

  "pere-goriot": [
    { name: "高老头", role: "主人公", description: "一个退休的面粉商，将自己的全部财产分给了两个嫁入上流社会的女儿。他住在伏盖公寓最便宜的房间里，一边节衣缩食一边被女儿们榨干最后一点积蓄——临终前女儿们都没来看他一眼。巴尔扎克以此写出了父爱的极致与盲目。" },
    { name: "拉斯蒂涅", role: "观察者", description: "一个从外省来到巴黎读法律的穷学生，寄居在伏盖公寓中，亲眼目睹了高老头的悲剧。在埋葬了高老头之后，他站在拉雪兹神父公墓的山顶上俯瞰巴黎——'现在，是咱俩较量的时候了！'" },
  ],

  "germinal": [
    { name: "艾蒂安·朗迪耶", role: "主人公", description: "一个失业的机械师，来到北方矿井寻找工作。在蒙苏煤矿的最深处他亲眼目睹了矿工们非人的生活——他组织了一场大罢工，但罢工的血腥镇压使他的理想主义遭遇了最残酷的考验。左拉以'萌芽'命名——革命的种子在黑暗的地下孕育。" },
    { name: "马赫一家", role: "矿工家庭", description: "蒙苏煤矿的矿工家庭，祖祖辈辈在井下劳作。马赫老爹的肺里全是煤尘、女儿卡特琳在井下被强暴——他们是左拉笔下'资本之恶'最直接的受害者。" },
  ],

  "the-little-prince": [
    { name: "小王子", role: "主人公", description: "来自B-612小行星的男孩，以孩子的纯真视角质疑成人世界的逻辑——'大人们从来不肯自己去理解任何事'。他的玫瑰花、他的三座火山、他与狐狸的对话——都在提醒每个'长大了'的人：'只有用心才能看清——本质的东西是眼睛看不见的。'" },
    { name: "狐狸", role: "智者", description: "教会小王子什么是'驯服'——驯服就是建立联系：'对我来说，你只是一个小男孩，就像其他千万个小男孩。但是，如果你驯服了我，我们就彼此需要了。'" },
  ],

  "animal-farm": [
    { name: "拿破仑", role: "猪/独裁者", description: "农场的猪领袖，在革命后逐渐篡夺了全部权力——他用九条恶犬清洗了反对者，修改了'七诫'，最终站起两条腿、穿上人的衣服、与人类农场主推杯换盏——'四条腿好，两条腿更好。'他是斯大林最直接的文学讽刺形象。" },
    { name: "雪球", role: "猪/理想主义者", description: "另一位猪领袖，列宁式的理想主义革命者。在被拿破仑驱逐后，他被系统地塑造成一切坏事的'内部敌人'——'雪球一直在为琼斯先生工作'是奥威尔对极权主义宣传机制的精辟解剖。" },
    { name: "拳击手", role: "马/劳动者", description: "一匹忠诚而强壮的马，口号是'我会更努力地工作'。当他太过年老被送到屠马场时，他的命运是对所有被革命背叛的天真劳动者的默哀。" },
  ],

  "brave-new-world": [
    { name: "伯纳德·马克斯", role: "主人公", description: "一个'新世界'中的异类——身体矮小使他在基因完美的社会中格格不入。他对睡眠教学式的条件反射产生了质疑——但他的反抗不过是另一种形式的'社会不适应'。" },
    { name: "约翰", role: "'野人'", description: "在'保留地'中长大的白人青年，读过莎士比亚。当他被带到'新世界'时，他的道德感和人性与这个没有痛苦、没有艺术、没有自由的世界发生了致命的碰撞。他最终的结局是对'快乐乌托邦'最猛烈的反驳。" },
  ],

  "lord-of-the-flies": [
    { name: "拉尔夫", role: "理性领袖", description: "被选为领袖的男孩，代表着秩序、民主和文明。他坚持要维持篝火以作为求救信号——但火焰最终失控，吞噬了整个岛屿。他与杰克的冲突是'文明'与'野蛮'之间的缩影。" },
    { name: "杰克", role: "暴力领袖", description: "唱诗班领队，以狩猎和暴力赢得了男孩们的追随。他的面绘、他的'杀猪'呐喊、他对西蒙和猪崽子的残忍——代表了人性中被文明压抑的原始暴力。" },
    { name: "西蒙", role: "先知/殉道者", description: "一个安静而通灵的男孩，第一个理解到：'也许野兽就是咱们自己。'当他带着真相走出丛林时，被正在疯狂跳舞的全体男孩当作'野兽'活活打死——全书最令人心碎的场景。" },
    { name: "猪崽子", role: "理性之声", description: "一个戴着眼镜的胖男孩，以海螺（理性的象征）为说话的工具。他的眼镜是生火的唯一工具——当杰克抢走他的眼镜时，文明彻底崩塌。他在试图用海螺呼吁秩序时被巨石砸死。" },
  ],

  "doctor-zhivago": [
    { name: "尤里·日瓦戈", role: "主人公", description: "一个诗人兼医生，在俄国革命和内战的洪流中努力守护个人的尊严、艺术与爱。他的诗——作为小说最后的'日瓦戈组诗'——是他被历史撕裂的灵魂留下的唯一完整之物。" },
    { name: "拉拉", role: "女主角", description: "日瓦戈一生深爱的女性，美丽而坚强。她的命运被战争和革命反复抛掷——从被迫成为科马罗夫斯基的情妇到在寻找日瓦戈中死去——她是那个时代的'俄罗斯之魂'。" },
  ],

  "the-master-and-margarita": [
    { name: "沃兰德", role: "魔鬼", description: "来到1930年代莫斯科的魔鬼——优雅、博学、冷酷又幽默。他以黑魔法表演和精准的惩罚揭露了苏联文人官僚的贪婪与虚伪。他不是传统的'恶'——他是揭露虚伪的真理之镜。" },
    { name: "大师", role: "主人公", description: "一个被苏联文学体制封杀的作家，烧毁了自己关于彼拉多与约书亚的小说手稿后自我囚禁在精神病院。布尔加科夫的自画像——'手稿是烧不掉的。'" },
    { name: "玛格丽特", role: "女主角", description: "大师的情人，为了救他在一夜之间变成了女巫——裸身飞行在莫斯科上空、在地狱舞会上担任女主人。她代表了超越一切困境的爱与忠诚。" },
  ],

  "one-day-ivan": [
    { name: "伊万·杰尼索维奇·舒霍夫", role: "主人公", description: "斯大林劳改营中的一个普通囚犯，编号Shcha-854。索尔仁尼琴以最简洁紧凑的叙事追踪了他在西伯利亚零下四十度的'平常一天'——这一天的所有细节——面包、砌砖、搜身——构成了古拉格群岛最真实的见证。" },
  ],

  "a-hero-of-our-time": [
    { name: "毕巧林", role: "主人公", description: "一个年轻的俄国军官，聪明、冷酷、自我毁灭。他在高加索驻军中玩弄女人、冒险走私、以冷漠面对死亡——他是俄国文学中'多余的人'谱系中最迷人也最黑暗的标本。莱蒙托夫说：'这是一代人全部的恶习在一个人身上的肖像。'" },
  ],

  "dead-souls": [
    { name: "乞乞科夫", role: "主人公", description: "一个外表优雅的中年绅士，在俄国大地上巡回收购'死魂灵'——那些已经去世但尚未注销户籍的农奴。他要以这些'纸面上的财产'为抵押骗取巨额贷款。果戈理以这个荒诞的梗概创造了一部关于俄国灵魂最奇异也最深刻的讽刺小说。" },
  ],

  "fathers-and-sons": [
    { name: "巴扎罗夫", role: "主人公", description: "一个自封的'虚无主义者'——拒绝一切权威、传统和浪漫情感，只接受'有用'和'事实'。但当他爱上美丽的贵妇奥金佐娃时，他的'理论'在他身体的情感面前不堪一击。他是俄国文学中'新人'的第一次被书写。" },
    { name: "阿尔卡季", role: "朋友", description: "巴扎罗夫的大学同学和追随者，一个温和的理想主义者。他在巴扎罗夫激进的虚无主义与父辈温情的传统之间摇摆——最终选择了家庭与爱情。" },
  ],

  "the-idiot": [
    { name: "梅什金公爵", role: "主人公", description: "一个从瑞士疗养院回到俄国的年轻公爵，单纯、善良、对所有人怀有宽广的同情——上流社会的人说他是一个'白痴'。他爱着两个女人——娜斯塔西娅和阿格拉娅——但因为他的'善良'无法做出选择，最终失去了两者。陀思妥耶夫斯基试图创造一个'完全美好的人'，并在彼得堡的社会泥沼中看着他被粉碎。" },
    { name: "娜斯塔西娅·菲利波夫娜", role: "女主角", description: "一个被收养她的男贵族自幼性侵的绝美女性，灵魂已经破碎。她在对拯救的渴望与自我毁灭的冲动之间撕裂——最终被罗戈任杀死。她是陀思妥耶夫斯基笔下最令人心碎的'被侮辱与被损害者'。" },
  ],

  "robinson-crusoe": [
    { name: "鲁滨逊·克鲁索", role: "主人公/叙述者", description: "一个违抗父命出海冒险的英国青年，在船只触礁后独自流落荒岛。他以日记、工具和宗教信仰在荒岛上重建了'文明'——二十八年后重返人类社会。笛福以'纪实'笔法创造了英语第一部真正意义上的小说。" },
    { name: "星期五", role: "仆人/同伴", description: "被克鲁索从食人族手中救出的土著青年。克鲁索给他取名'星期五'、教他英语、让他改信基督教——两个人的关系既是友谊也是殖民者与被殖民者之间不平等的镜像。" },
  ],

  "gullivers-travels": [
    { name: "格列佛", role: "主人公/叙述者", description: "一个英国船医，在四次航行中分别到了小人国、大人国、飞岛国和智马国。在智马国里，他遇到了完全理性的马（慧因姆）和完全被欲望驱使的类人兽（野猢）——当慧因姆将他驱逐出境时，他已经无法再忍受与任何'人类'生活在一起。" },
  ],

  "emma": [
    { name: "爱玛·伍德豪斯", role: "女主人公", description: "一个聪明、富有、美貌但有些被宠坏的年轻女子。她一心想做媒人——为朋友哈丽埃特牵线搭桥——但她的每一次'撮合'都因为自己的偏见而犯下错误。奥斯汀笔下的爱玛是最早也最成功的'成长中的女主角'：她终于发现，最不了解的人其实是自己。" },
    { name: "奈特利先生", role: "男主角", description: "爱玛家的老朋友，唯一一个敢于批评爱玛的人。他的诚实与他最终对爱玛的感情构成了奥斯汀笔下最成熟的爱情——不是一见钟情的浪漫，而是在彼此看清缺点之后的接纳。" },
  ],

  "tess-of-the-durbervilles": [
    { name: "苔丝·德伯菲尔德", role: "女主人公", description: "一个美丽而贫穷的乡村女子，被富家少爷亚历克诱奸后生下并失去了一个私生子。多年后她遇见了真爱安吉尔·克莱尔——但当安吉尔在新婚之夜听到苔丝的过去时选择了逃离。哈代为这部小说的副标题写了'一个纯洁女人的真实写照'——对维多利亚道德的最强烈抗议。" },
    { name: "安吉尔·克莱尔", role: "苔丝的丈夫", description: "一个自由思想者，牧师的儿子，自认为超越了社会偏见。但他新婚之夜听到苔丝被诱奸的过去时，他的'自由思想'在一个具体女性面前坍缩为了最普通的男性占有欲——他的离开杀死了苔丝。" },
  ],

  "heart-of-darkness": [
    { name: "马洛", role: "叙述者", description: "一个在泰晤士河口的船上讲述自己在刚果经历的商船船长。他溯刚果河而上——同时也溯入了人心最深处的'黑暗'——去寻找那个失踪的象牙贩子库尔茨。" },
    { name: "库尔茨", role: "关键人物", description: "一个在白人文明中被视为'天才'的象牙贩子，在刚果丛林的绝对权力中变成了一个被原住民当作神膜拜的存在。他的临终遗言——'恐怖！恐怖！'——是二十世纪文学中最令人难忘的声音之一，至今仍在追问殖民、权力与人性的边界。" },
  ],

  "buddenbrooks": [
    { name: "托马斯·布登勃洛克", role: "第三代家主", description: "布登勃洛克商号的第三代继承人，仪表堂堂、能力出众。但他外在的成功掩盖了内在的枯竭——他对生活的热情在维持'体面'中被耗尽。他的死亡标志着一个家族的生命力彻底耗尽。" },
    { name: "汉诺·布登勃洛克", role: "第四代", description: "托马斯的儿子，一个敏感而纤弱的男孩，对商业毫无兴趣，只沉迷于音乐。他的早夭是家族没落的终章——托马斯·曼二十五岁时就以这部家族史奠定了诺贝尔奖的地位。" },
  ],

  "steppenwolf": [
    { name: "哈里·哈勒尔", role: "主人公", description: "一个自称'荒原狼'的中年知识分子——一半是人、一半是狼。市民的体面与狼的野性在他体内持续交战，使他无法在任何一个世界中安居。黑塞以这部'灵魂的自传'写尽了现代知识分子的精神分裂。" },
    { name: "赫尔米娜", role: "向导", description: "一个在舞厅中认识的神秘女性，教哈利跳舞、大笑、享受生活的感官快乐——她的'魔法剧场'是哈利精神疗愈的最高峰。她是对哈里的理性主义的反向导师。" },
  ],

  "the-tin-drum": [
    { name: "奥斯卡·马策拉特", role: "主人公/叙述者", description: "一个在三岁时决定不再长大的侏儒——他用铁皮鼓击打出二十世纪德国最黑暗的节奏，他的尖叫声能震碎玻璃。在精神病院中，他以最反叛的视角讲述了从纳粹崛起到战后德国的整个德国悲剧。" },
  ],

  "the-good-soldier-svejk": [
    { name: "帅克", role: "主人公", description: "一个在第一次世界大战期间被征召入伍的捷克士兵，以傻里傻气的'绝对服从'将奥匈帝国的军事官僚机构变成了一个巨大的笑话机器。他的'愚蠢'究竟是伪装的智慧还是纯粹的运气——这是文学史上最快乐的悬案之一。" },
  ],

  "the-unbearable-lightness": [
    { name: "托马斯", role: "主人公", description: "一个布拉格的外科医生和不可救药的浪子，相信人生'轻如鸿毛'——因为只活一次，所有选择都没有'永恒轮回'的重量。但他对特蕾莎的爱情使他逐渐意识到：在偶然相遇中有了必须承担的责任。" },
    { name: "特蕾莎", role: "女主人公", description: "一个从捷克小镇来的女招待，偶然进入了托马斯的生活。她爱他爱到痛苦——她随身带着沉重的行李箱（隐喻了生命之'重'），在与托马斯的'轻'之间构成了整部小说的核心张力。" },
    { name: "萨宾娜", role: "女配角", description: "托马斯的情人之一，一个追求绝对自由的画家。她的一生都在'背叛'——背叛家庭、背叛祖国、背叛情人——但她最终发现：背叛的尽头是彻底的虚空。她是'轻'的最极端化身。" },
  ],

  "the-name-of-the-rose": [
    { name: "威廉修士", role: "主人公", description: "一个方济各会修士，曾是宗教裁判所的调查官。他以理性与推理追查一座中世纪修道院中的连环谋杀案——但最终的'凶手'却是亚里士多德失传的《诗学》第二卷（论喜剧）。他是夏洛克·福尔摩斯在中世纪的前身。" },
    { name: "阿德索", role: "叙述者", description: "威廉的徒弟，一个年轻的见习修士。他以暮年回忆的形式讲述这个故事——他是华生，也是整部小说'知识'与'信仰'之争的年轻见证者。" },
  ],

  // ============================================
  // 扩充库 — 非洲、美洲、大洋洲
  // ============================================

  "the-scarlet-letter": [
    { name: "海丝特·白兰", role: "女主人公", description: "清教徒波士顿的一个刺绣女工，因通奸罪被迫在胸前佩戴红色的'A'字。她独自抚养女儿珠儿，以沉默和坚忍将'A'从'通奸'（Adultery）重新定义为'能干'（Able）——美国文学第一位伟大的女性英雄。" },
    { name: "亚瑟·丁梅斯代尔", role: "牧师/秘密情人", description: "海丝特的秘密情人，一个备受爱戴的年轻牧师。他在公众面前是圣徒，在内心却因隐藏罪孽而燃烧——他胸口的'红字'是隐形的但比海丝特更痛。他的临终忏悔是全书的高潮。" },
    { name: "罗杰·齐灵沃斯", role: "海丝特的丈夫", description: "一个年老的医生，海丝特的合法丈夫，以假名潜入波士顿。当他发现海丝特的'罪'后，他将全部生命投入到对丁梅斯代尔的精神折磨之中——复仇使他从受害者变成了恶魔。" },
  ],

  "walden": [
    { name: "亨利·大卫·梭罗", role: "作者/栖居者", description: "一个美国超验主义者，在瓦尔登湖畔亲手建造了一间小屋，在那里住了两年两个月零两天。他以'我到林中去，是因为我希望审慎地生活'为宣言——将极简的生活写成了关于自然、孤独与公民不服从的不朽经典。" },
  ],

  "the-grapes-of-wrath": [
    { name: "汤姆·乔德", role: "主人公", description: "乔德家的长子，刚从监狱假释出来。在大萧条中被银行从俄克拉荷马的土地上驱逐，随全家前往加利福尼亚——'应许之地'。他从只为自己活着到加入更大规模的社会抗争——他的告别之辞承载了斯坦贝克对底层人尊严的全部信仰。" },
    { name: "乔德妈妈", role: "家庭支柱", description: "乔德家的母亲，一个坚如磐石的女性。在饥饿、逃亡与死亡的重压下，她以'一个家庭必须团结'的信念把所有人凝聚在一起——'女人比男人更能承受苦难，因为女人的生命在细节中延续。'" },
    { name: "前牧师凯西", role: "精神导师", description: "一个放弃信仰的前牧师，在流亡中找到了新的'宗教'：所有劳动者都是同一个灵魂的一部分。他被副警长打死——他的死使汤姆接过了他的精神火炬。" },
  ],

  "death-of-a-salesman": [
    { name: "威利·洛曼", role: "主人公", description: "一个六十多岁的推销员，被'美国梦'吞噬的普通人。他的'受人喜欢就是成功'的信仰在现实中不堪一击——他被公司辞退、被儿子们视为失败者。阿瑟·米勒以这部美国悲剧追问：当一个人不再'有用'时，他还值什么？" },
    { name: "比夫·洛曼", role: "长子", description: "威利寄予厚望的长子，一个高中橄榄球明星。但当他发现父亲在旅馆与另一个女人在一起时，他的整个世界崩塌了——从此拒绝成为父亲想要他成为的那个人。" },
  ],

  "catch-22": [
    { name: "尤索林", role: "主人公", description: "美国空军投弹手，驻扎在地中海的一个小岛上。他疯狂地试图证明自己'疯了'以便免于飞行——但'第二十二条军规'说：如果你担心自己的安全而申请免于飞行，就证明你没疯。他以这部黑色幽默的杰作揭示了战争和官僚体制的荒谬。" },
  ],

  "slaughterhouse-five": [
    { name: "比利·皮尔格林", role: "主人公", description: "一个在时间中'脱臼'了的美国军医。他从二战德累斯顿轰炸的火海中被外星特拉法玛多人绑架到动物园中展览——'事情就是这样'。冯内古特以科幻的外壳和反讽的反复咏叹写出了关于战争创伤的最深刻的反战小说。" },
  ],

  "the-handmaids-tale": [
    { name: "奥芙弗雷德", role: "叙述者/主人公", description: "在基列共和国——一个神权男性极权国家——她沦为了'使女'：一个被分配给统治精英做生育工具的女性。她的真名已被抹去，她的身体已不属于她——但她的叙述本身就是一条地下铁路式的抵抗。" },
    { name: "瑟琳娜·乔伊", role: "夫人", description: "大主教的妻子，一个曾经倡导传统女性价值观的公众人物。当她亲手建造的体制将她自己囚禁为'非生育者'时，她以最残酷的方式将痛苦转嫁给她的使女。" },
  ],

  "on-the-road": [
    { name: "萨尔·帕拉迪斯", role: "叙述者/主人公", description: "以杰克·凯鲁亚克本人为原型的年轻作家，在1940年代末与迪安·莫里亚蒂一起横穿美洲大陆——从纽约到丹佛到旧金山到墨西哥城。他在公路上寻找美国灵魂的狂喜——凯鲁亚克在三周内在一卷120英尺长的打字机纸上打出了这部'垮掉的一代'圣经。" },
    { name: "迪安·莫里亚蒂", role: "疯狂伙伴", description: "以尼尔·卡萨迪为原型的'圣狂人'——一个无法在任何地方停留的公路圣徒。他的疯狂与自由是'垮掉的一代'的全部精髓——'燃烧，燃烧，像罗马蜡烛那样燃烧。'" },
  ],

  "2666": [
    { name: "本诺·冯·阿琴波尔迪", role: "核心人物", description: "一个隐居的德国作家，他的神秘行踪是小说第五部分的焦点——他的德国二战背景与墨西哥边境城市的大量女性谋杀案在文本的深处交汇。波拉尼奥的遗作以五部曲的宏大结构探入了二十世纪最黑暗的深渊。" },
  ],

  "wide-sargasso-sea": [
    { name: "安托瓦内特·科斯威", role: "女主人公/叙述者", description: "后来成为《简·爱》中被关在阁楼里的'疯女人'伯莎·梅森。里斯赋予了她自己的声音、童年、欲望与创伤——在牙买加湿热的后奴隶制社会中，一个白种克里奥尔女性在两个世界之间的无处容身。" },
    { name: "罗切斯特", role: "丈夫", description: "《简·爱》中那个拜伦式的英雄在此被重新审视——从他（一个无名的英国青年公子）的视角，我们看到了他如何以'理性'和'法律'将一个不驯服的女人关进了阁楼。" },
  ],

  "cry-the-beloved-country": [
    { name: "斯蒂芬·库马洛", role: "主人公", description: "一位来自纳塔尔乡村的祖鲁圣公会牧师，前往约翰内斯堡寻找失踪的儿子。在城市的贫民窟和种族隔离制度下，他找到了儿子——但也发现自己生活的南非正在从根基上被撕裂。佩顿以圣经般的庄严散文写下了这部关于哀伤与希望的杰作。" },
  ],

  "no-longer-at-ease": [
    { name: "奥比·奥孔库沃", role: "主人公", description: "《瓦解》中奥孔库沃的孙子，在殖民教育下成为尼日利亚第一批留学英国归来的公务员。他在传统与现代、道德与贪欲之间无法自持——他收受了贿赂，因为他要维持一个'体面'的生活。阿契贝以此追问：独立后的非洲人真的比殖民时代更'自由'吗？" },
  ],

  // ============================================
  // 扩充库 — 批量扩展（bulk-expansion.ts 命名条目）
  // ============================================

  "bk-ch-001": [
    { name: "杜丽娘", role: "女主人公", description: "南安太守之女，在春日游园后梦见一位书生持柳枝而来——这一梦让她思念成疾、因病而死，死后三年又因情而复生。'情不知所起，一往而深'——汤显祖以杜丽娘创造了中国戏曲史上最动人的'至情'形象。" },
    { name: "柳梦梅", role: "男主人公", description: "岭南书生，在梦中与杜丽娘相遇并深爱。他后来在梅花树下发现了丽娘的自画像，两人共同经历了从死到生的奇迹——他的名字'梦梅'就是这场超越了生死的爱情的注脚。" },
  ],

  "bk-ch-004": [
    { name: "张生", role: "男主人公", description: "一位年轻的书生，在普救寺偶遇崔莺莺后一见钟情。他以琴声传情、以诗书寄意——最终在红娘的帮助下突破了老夫人的阻挠。'愿普天下有情的都成了眷属'是王实甫写给所有恋人的祝福。" },
    { name: "崔莺莺", role: "女主人公", description: "已故崔相国之女，美丽而端庄。她在礼教的约束与内心的爱意之间反复挣扎——她的'赖简'（明明写了约会信却当面否认）是中国古典文学中对恋爱心理最微妙的刻画。" },
    { name: "红娘", role: "关键人物", description: "崔莺莺的丫鬟，聪明机敏、勇敢仗义，不惜冒险为张生与莺莺牵线搭桥。'红娘'后来已成为汉语中'媒人'的代名词——她的形象是对森严礼教最生动的民间反抗。" },
  ],

  "bk-ch-005": [
    { name: "窦娥", role: "女主人公", description: "一个年轻的寡妇，被无赖张驴儿诬告毒死其父——在贪官的酷刑逼供下，她为保护婆婆而屈打成招。临刑前她发下三大誓愿：血溅白练、六月飞雪、大旱三年——关汉卿以这个悲剧写下了对天地不仁的最强有力的控诉。" },
  ],

  "bk-ch-009": [
    { name: "翠翠", role: "女主人公", description: "湘西茶峒渡口的孤女，与爷爷相依为命。她在端午节的龙舟会后同时被两兄弟爱上——天保和傩送——但命运将她卷入了一场她完全无法理解的悲剧中。沈从文以最纯净的散文写出了一个关于等待的'中国式牧歌'。" },
    { name: "爷爷", role: "翠翠的祖父", description: "茶峒渡口的老船夫，一生在酉水河上摆渡。他一心为翠翠的婚事操劳，却在对两个兄弟的试探与等待中耗尽了自己——他的死是全书最令人心痛的转折。" },
  ],

  "bk-ch-010": [
    { name: "祥子", role: "主人公", description: "一个从乡下来的北平洋车夫，年轻、强壮、有梦想——他想拥有一辆自己的洋车。但三次买车三次破灭：第一次车被大兵抢了，第二次积蓄被侦探诈了，第三次为葬妻卖了车。他从一个自尊自爱的劳动者堕落为行尸走肉——老舍以京味儿十足的语言写出了底层中国的残酷。" },
    { name: "虎妞", role: "祥子的妻子", description: "车厂老板刘四爷的女儿，又老又丑又泼——但她是唯一主动选择祥子的人。她以欺骗的方式嫁给了祥子，最终难产而死。她对祥子既有爱也有毁灭性——是全书最复杂的人物之一。" },
  ],

  "bk-ch-011": [
    { name: "白流苏", role: "女主人公", description: "一个离了婚回到娘家的上海女性，被家族嫌弃。她在香港遭遇战中与范柳原——一个风流倜傥的华侨——玩了一场精于算计的爱情博弈。'香港的陷落成全了她'——但张爱玲笔下的'成全'渗透着一种深不见底的苍凉。" },
    { name: "范柳原", role: "男主人公", description: "一个在英国长大的华侨，有钱有闲、阅女无数。他要的是'不用负责的浪漫'——但在战争轰炸中，他最终给了流苏婚姻。张爱玲说这不是浪漫的爱情，而是一场精于算计的'倾城之恋'。" },
  ],

  "bk-ch-012": [
    { name: "王利发", role: "主人公", description: "裕泰茶馆的掌柜，一个圆滑而善良的北京小商人。他在清末、北洋军阀和国民党统治的三个时代中不断'改良'自己的茶馆以求生存——但最终这个'大茶馆里的小社会'连同他本人一起被时代碾碎。" },
    { name: "常四爷", role: "常客", description: "一个正直的旗人，因说了一句'大清国要完'而被捕入狱。他从尊贵的旗人变成了自食其力的卖菜人——他那句'我爱咱们的国呀，可是谁爱我呀？'是老舍对国家与个人命运最沉痛的追问。" },
  ],

  "bk-ch-013": [
    { name: "孙少安", role: "主人公", description: "陕北黄土高原上的农民长子，十三岁辍学回家种地，以一己之力支撑着全家的生计。在改革开放初期，他抓住机遇办了砖厂——但每一次成功都伴随着更沉重的代价。路遥写出了一个'平凡的世界'中最不平凡的尊严。" },
    { name: "孙少平", role: "第二主人公", description: "少安的弟弟，一个怀着文学梦想的农村青年。他离开家乡到煤矿挖煤——在黑暗的井底他找到了属于自己的精神世界。他与田晓霞的爱情是全书最动人的希望之光。" },
  ],

  "bk-uk-005": [
    { name: "道林·格雷", role: "主人公", description: "一个拥有惊世美貌的伦敦青年，在画像前许愿：'让画像替我衰老，让我永葆青春。'他的愿望实现了——从此他的脸永远纯净无瑕，而阁楼中的画像越来越狰狞腐烂。王尔德唯一的'小说'是关于美、青春与道德沦丧的唯美主义宣言。" },
    { name: "亨利勋爵", role: "诱惑者", description: "一个以俏皮话为武器的享乐主义者，教导道林'治疗灵魂的唯一方法就是感官'。他是伊甸园中的那条蛇——他以最优雅的语言引诱道林走向无底的堕落。" },
  ],

  "bk-uk-008": [
    { name: "史蒂文斯", role: "主人公/叙述者", description: "达林顿府的前管家，以一种近乎偏执的'尊严'追求将他的一生奉献给了'服务'。当他晚年驱车穿越英格兰乡间时，他开始回忆起那场他从未敢于承认的爱情——以及他在历史关键时刻选择'不介入'的代价。石黑一雄以这个管家的声音写出了一部关于自我欺骗的杰作。" },
    { name: "肯顿小姐", role: "史蒂文斯爱过的女性", description: "达林顿府的女性管家，与史蒂文斯共事多年。她曾一再暗示对他的感情——而他每一次都以'专业'为借口回避。当她最终嫁给另一个男人后，史蒂文斯才敢在暮年承认自己失去的是什么。" },
  ],

  "bk-fr-002": [
    { name: "梅尔特伊侯爵夫人", role: "反派/核心", description: "一个以操纵他人为乐的贵族女性，与旧情人瓦尔蒙子爵将诱惑和背叛当作一场智力游戏。她是文学史上最令人着迷的'女性恶魔'——以全部才智和冷酷对抗一个将女性限制在婚姻中的社会。" },
    { name: "瓦尔蒙子爵", role: "梅尔特伊的同谋", description: "梅尔特伊唯一的对手和搭档——一个以猎艳征服了无数女性的浪子。但他最终的毁灭是因为他居然爱上了自己的猎物——这违反了梅尔特伊的'游戏规则'。" },
  ],

  "bk-fr-004": [
    { name: "弗雷德里克·莫罗", role: "主人公", description: "一个从外省来到巴黎的青年，将全部的生命热情投入到对阿尔努夫人的不可能的爱情之中。他经历了1848年革命、投机买卖、以及各种半途而废的计划——福楼拜以此写了一代人——不再有英雄的时代中那些平庸而忧伤的青春。" },
    { name: "阿尔努夫人", role: "弗雷德里克的缪斯", description: "一个画商的妻子，弗雷德里克一生的挚爱——但他一生都没能真正得到她。她是福楼拜本人对爱丽莎·施莱辛格的终生单恋的文学投射——最美好的爱情也许是永远没有实现的那场。" },
  ],

  "bk-fr-005": [
    { name: "娜娜", role: "女主人公", description: "一个街头妓女以她的肉体征服了巴黎上流社会——她毁掉了每一个接近她的男人。左拉以自然主义的冷酷精确描绘了第二帝国腐化堕落的欲望世界——'一只苍蝇落在了一堆粪便上'。" },
  ],

  "bk-fr-007": [
    { name: "西西弗", role: "核心形象", description: "希腊神话中的科林斯国王，因欺骗诸神被罚永远推着一块巨石上山——石头每一次滚落，他又重新开始。加缪将这一形象作为荒谬英雄的原型：'我们必须想象西西弗是快乐的'——在无意义的重负中找到意义就是人对荒谬宇宙的最高反抗。" },
  ],

  "bk-ru-006": [
    { name: "格里高利·麦列霍夫", role: "主人公", description: "顿河哥萨克，在第一次世界大战和俄国内战中被迫在红军与白军之间反复摇摆。他是一个天生的战士却厌恶一切意识形态——他只想回到顿河边的土地上和他的阿克西尼娅身边。肖洛霍夫以这部史诗写出了俄罗斯哥萨克在革命中遭受撕裂的全部痛苦。" },
    { name: "阿克西尼娅", role: "麦列霍夫的情人", description: "麦列霍夫的邻居之妻，两人之间的爱情自始至终贯穿全书。她在乱世的尽头被一颗流弹打死——麦列霍夫抱起她的尸体时，整个世界空了。" },
  ],

  "bk-ru-004": [
    { name: "幻想家", role: "叙述者/主人公", description: "一个孤独的彼得堡青年，生活在自己的幻想世界中。在彼得堡的白夜里，他与一个等待恋人的少女娜斯坚卡相遇了四个夜晚——他爱上了她，但当她的恋人终于出现时，他选择了退出。陀思妥耶夫斯基最温柔的作品。" },
    { name: "娜斯坚卡", role: "女主人公", description: "一个等待未婚夫归来的少女。她与幻想家在四个白夜中的对话是全书的核心——她的天真与温暖是对孤独的暂时治愈，但她的离去也让'幻想家'意识到：他最终的伴侣永远是'孤独'。" },
  ],

  "bk-ru-007": [
    { name: "奥列格·科斯托格洛托夫", role: "主人公", description: "一个被斯大林体制折磨了多年的政治犯，在癌症病房中一面与疾病搏斗一面品尝着刚刚获得的自由。癌症是肉体的疾病也是苏联社会的隐喻——索尔仁尼琴在赫鲁晓夫'解冻'期间出版的这部小说是古拉格最有力的一次'病历报告'。" },
  ],

  "bk-nord-003": [
    { name: "伊萨克·迪内森（卡伦·布里克森）", role: "叙述者/作者", description: "一个丹麦女贵族，在肯尼亚经营咖啡农场十七年。她以优雅而哀伤的笔调写下了'我在非洲有一座农场'的传奇——关于狮子、索马里仆人、马赛族战士和最终失去的一切。海明威说她应当获得诺贝尔奖而不是自己。" },
  ],

  "bk-it-001": [
    { name: "萨利纳亲王", role: "主人公", description: "西西里最古老的贵族萨利纳家族的首领，在意大利统一运动中亲眼目睹了旧贵族世界的不可逆转的消亡。他的名句——'如果我们希望一切保持原样，就必须改变一切'——是关于旧制度在革命年代中的生存策略的最深刻洞见。" },
    { name: "唐克雷迪", role: "亲王的侄子", description: "萨利纳亲王的外甥，一个年轻英俊的机会主义者。他先加入了加里波第的革命军，后又转向了萨伏依王室——他代表了那只'从旧世界里爬出来的豹'：改变皮毛颜色但并不改变本性。" },
  ],

  "bk-af-001": [
    { name: "阿扎罗", role: "主人公", description: "一个'阿比库'——在约鲁巴神话中，一个在灵界与人间之间反复往返的孩子。他拒绝按照'灵界同伴'的要求死去，选择留在人间——但他的'活着'是一次穿越腐败、暴力与魔幻的当代尼日利亚的旅程。本·奥克里以这部小说获得布克奖。" },
  ],

  "bk-am-001": [
    { name: "汤姆叔叔", role: "主人公", description: "一个忠厚善良的肯塔基黑奴，在主人破产后被卖给南方的暴虐奴隶主。他承受了种种非人的虐待却始终以基督式的宽恕面对——他的被鞭打致死是十九世纪美国最强大的反奴隶制文学武器。林肯说：'就是这本小书引发了这场大战。'" },
    { name: "伊莱扎", role: "重要人物", description: "一个勇敢的奴隶母亲，带着幼儿越过俄亥俄河浮冰逃亡——她跨越冰块的那个场景是全书最扣人心弦的画面，象征了所有奴隶对自由的绝望渴求。" },
  ],

  "bk-am-002": [
    { name: "乔·马奇", role: "核心人物", description: "马奇家二女儿，一个假小子般的女孩，梦想成为作家。她卖掉了自己的头发，在阁楼上不停地写作——'乔'是无数女性读者心中的文学原型：一个在最阻碍女性的时代仍然拒绝传统婚姻、追求独立灵魂的女孩。" },
    { name: "贝丝·马奇", role: "三女儿", description: "马奇家最温柔的女儿，一个弹得一手好钢琴的安静天使。她感染猩红热后衰弱而死——她的死亡是全书最令人流泪的章节，也是所有读者心中永远的伤痕。" },
  ],

  "bk-oc-001": [
    { name: "梅吉·克利里", role: "女主人公", description: "克利里家的独女，从少女时代就深爱着神父拉尔夫——一个永远不可能属于她的男人。他们的禁忌之恋跨越了澳大利亚三代人的悲欢，梅吉一生都在等待和失去——'荆棘鸟一生只歌唱一次，当它把胸膛刺入最尖的荆棘时。'" },
    { name: "拉尔夫·德·布里卡萨", role: "男主人公", description: "一个英俊且有野心的天主教神父，在上帝与梅吉之间痛苦挣扎。他最终选择了教会的权力——以梅吉的巨额遗产为自己铺设通往红衣主教的道路。但他的一生都在为自己的选择付出代价。" },
  ],

  "bk-oc-002": [
    { name: "莉赛尔·梅明格", role: "女主人公", description: "一个被送到德国慕尼黑郊区寄养家庭的九岁女孩。她在纳粹的阴影下偷了人生的第一本书——《掘墓人手册》——然后一本接一本地偷下去。死神作为叙述者讲述了她被文字喂养的灵魂如何在焚书的大火中坚守。" },
    { name: "汉斯·胡贝尔曼", role: "莉赛尔的养父", description: "一个瘦削的粉刷匠，以手风琴和无限的耐心教会了莉赛尔识字。他在犹太人游行中递给一个将死的老人一块面包、在防空洞里为惊恐的人群拉手风琴——他是纳粹德国中那些沉默的'好人'。" },
  ],

  // ============================================
  // 扩充库 — 真实扩展（real-expansion.ts）
  // ============================================

  "re-ch-05": [
    { name: "叙述者'我'", role: "主人公/叙述者", description: "以童年萧红的视角回忆了在呼兰河小城的生长岁月。'呼兰河这座小城，住着我的祖父'——萧红以诗意而哀伤的笔触写尽了故乡的人与事，也写尽了一个孩子眼中成人世界的荒凉。" },
    { name: "祖父", role: "核心人物", description: "萧红笔下唯一温暖的存在——一个慈祥的老人在后花园里教她辨认花草蔬菜、念唐诗。祖父的死亡是全书情感的转折点：'我'失去了唯一无条件爱她的人。" },
    { name: "小团圆媳妇", role: "悲剧人物", description: "被卖来做童养媳的十二岁少女，因'不乖'被婆家当众用热水烫身驱鬼——最终惨死。萧红以这一节完成了中国文学中对女性命运最令人窒息的书写。" },
  ],

  "re-ch-06": [
    { name: "王琦瑶", role: "女主人公", description: "1946年上海小姐的季军——一个弄堂里长大的普通女孩。从民国选美到文革后的孤独离世——王安忆以她四十年的浮沉写出了一座城市的灵魂。她的美与哀伤是上海这座城市最私密的传记。" },
  ],

  "re-ch-07": [
    { name: "上官鲁氏", role: "女主人公", description: "高密东北乡的上官家族女族长，一个'丰乳肥臀'的母亲。她在二十世纪中国的所有苦难中生育和抚养了九个孩子和一个'外孙'——莫言以她为全中国的母亲写了一部史诗般的安魂曲。" },
    { name: "上官金童", role: "叙述者", description: "上官家唯一的男孩，一生都依赖女性的'乳房'而无法独立。他是莫言笔下一个病态的'中国男性'的寓言——被宠坏的、软弱的、无法面对历史的。" },
  ],

  "re-ch-08": [
    { name: "傻子少爷", role: "叙述者/主人公", description: "最后一个土司的儿子，被所有人视为'傻子'。但他却以最独特的视角看穿了正在吞噬土司制度的历史洪流——他的'傻'往往比所有人的'聪明'更接近真相。他来以这部小说获得了茅盾文学奖。" },
  ],

  "re-ch-09": [
    { name: "姑姑", role: "主角", description: "一个乡村妇产科医生，前半生是接生了近一万个婴儿的'送子娘娘'，后半生变成了执行计划生育政策的计生干部。莫言以'蝌蚪'给'杉谷义人'写信的形式，书写了这个时代中关于生育、罪与救赎的最沉重的叙事。" },
  ],

  "re-ch-10": [
    { name: "李光头", role: "主人公之一", description: "一个在公共厕所偷看女人而被当众羞辱的孤儿。在改革开放的四十年中，他从最底层的废物变成了刘镇首富——他的崛起是中国当代'原始积累'最野蛮也最真实的一幅漫画。" },
    { name: "宋钢", role: "主人公之一", description: "李光头的异姓兄弟，善良而懦弱。他在急剧变化的时代中找不到自己的位置——最终的结局是对中国传统'老实人'命运的最残酷书写。" },
  ],

  "re-ch-11": [
    { name: "王二", role: "主人公/叙述者", description: "一个在云南农场插队的北京知青，在'革命'的年代里以性爱和幽默对抗荒谬。'那一天我二十一岁，在我一生的黄金时代，我有好多奢望'——王小波以最自由的语言写出了一个最不自由的年代的灵魂。" },
    { name: "陈清扬", role: "女主角", description: "云南农场的女医生，因为被所有人诬为'破鞋'而找到王二，要求他'证明'她的清白——两人因此展开了一段'革命时期的爱情'。她的骄傲和脆弱使她成为王小波笔下最生动的女性形象。" },
  ],

  "re-ch-12": [
    { name: "英子", role: "叙述者", description: "一个生活在民国北京城南的小女孩，以澄澈的童心观察着成人世界的悲欢离合——疯女人秀贞、被枪毙的小偷朋友、被卖掉的宋妈——林海音以儿童的'纯真之眼'看尽了成人世界的全部哀伤。" },
  ],

  "re-jp-06": [
    { name: "渡边彻", role: "主人公/叙述者", description: "一个在东京上大学的青年，在挚友木月自杀后隔绝了自己的情感。他同时爱着两个女性——已故挚友的前女友直子和活泼可爱的绿子——在死与生、过去与未来之间摇摆。" },
    { name: "直子", role: "女主角", description: "渡边死去挚友木月的恋人，精神脆弱、内敛而美丽。她无法从木月之死的阴影中走出来，最终住进了京都深山里的精神疗养院——她的轨迹驶向了黑暗。" },
    { name: "绿子", role: "女主角", description: "渡边的大学同学，一个在不幸家庭中长大的女孩却拥有源源不断的生命力。她以'出奇制胜'的坦率挑战渡边的封闭——她是全书唯一的光，代表着'生'的召唤。" },
  ],

  "re-jp-07": [
    { name: "田村卡夫卡", role: "主人公", description: "一个十五岁的东京少年，离家出走到四国的高松市——为了逃离父亲的俄狄浦斯式诅咒，却在某种意义上一步步走进了命运的陷阱。村上春树以两条叙事线并行讲述了一个关于成长、失落的母亲与自我寻找的故事。" },
    { name: "中田", role: "平行主人公", description: "一个在二战期间因神秘事件丧失了全部智识和识字能力的老人，却获得了能与猫对话的奇异能力。他的旅程与田村卡夫卡的轨迹在命运的深层交汇——是全书最魔术性的书写。" },
  ],

  "re-in-04": [
    { name: "拉塔", role: "女主人公", description: "一位年轻的印度女性，她的母亲苦苦为她寻找'一个适合的男孩'。但她的心属于一个穆斯林青年——在1950年代印巴分治后宗教冲突的背景下，这段爱情面临了来自家庭、社会和国家的三重压力。" },
  ],

  "re-in-06": [
    { name: "巴尔拉姆·哈瓦伊", role: "主人公/叙述者", description: "从比哈尔邦最贫穷村庄的茶馆服务员到班加罗尔的企业家——他如何'杀'出一条生路。在写给中国总理温家宝的一系列信中，他讲述了自己跨越印度种姓制度的传奇——以及成功所需的全部'恶'。布克奖。" },
  ],

  "re-ir-01": [
    { name: "无名叙述者", role: "主人公/叙述者", description: "一个在鸦片烟雾中反复描绘同一场景的孤独画家。希达亚特以超现实主义的笔法将死亡、欲望和宗教禁忌编织为伊朗现代文学中最黑暗也最神秘的中篇小说——'盲猫头鹰'是灵魂在暗夜中的哭声。" },
  ],

  "re-tr-01": [
    { name: "黑", role: "主人公", description: "一个为奥斯曼苏丹编纂图鉴的画家。当他回到阔别十二年的伊斯坦布尔调查一桩谋杀案时，他在被杀画家的遗稿中找到了解开一切的线索——帕慕克以细密画的美学逻辑创作了一部关于'看'的后现代杰作。诺贝尔奖。" },
    { name: "谢库瑞", role: "女主人公", description: "黑的旧爱，一个带着两个孩子的年轻寡妇。她在等待失踪丈夫归来的同时，巧妙地游走于多个追求者之间——她是全书最复杂的权力玩家，也是爱的最终归属。" },
  ],

  "re-tr-02": [
    { name: "卡", role: "主人公", description: "一个在德国流亡十二年的土耳其诗人，回到东部小城卡尔斯调查一系列女性自杀事件。一场暴雪将他困在这座城市中——军队、世俗派、伊斯兰主义者和库尔德民族主义者之间一场微型'内战'在他眼前上演。" },
  ],

  "re-uk-02": [
    { name: "安娜·伍尔夫", role: "主人公", description: "一个离了婚的英国女作家，以四本不同颜色的笔记——黑色（她在非洲的共产主义岁月）、红色（英国共产党中的经历）、黄色（一场婚外情）和蓝色（她的日常生活）——记录了作为一个'自由女性'在二十世纪中期所经历的精神分裂。多丽丝·莱辛以此获诺贝尔奖。" },
  ],

  "re-uk-03": [
    { name: "伯纳德", role: "叙述者之一", description: "六个人物之一，从童年到老年追踪了彼此交错的生命。伍尔夫最实验性的作品——以海浪的涨落为节奏，六个声音轮流响起，像一部文学交响乐。" },
    { name: "罗达", role: "叙述者之一", description: "六个声音中最内向、最脆弱的一个，始终与'存在'保持着陌生人的距离。'我是什么？我是一片空白的黑暗'——她的自我消融是全书中最令人不安的段落。" },
  ],

  "re-fr-01": [
    { name: "费迪南·巴尔达缪", role: "主人公/叙述者", description: "一个法国医学生，从一战战壕到非洲殖民地再到美国福特汽车厂的流水线——塞利纳以他的口吻用粗粝、节奏鲜明的口语颠覆了所有'文学法语'的传统。'这就是生活，它开始于哭泣，结束于呻吟。'" },
  ],

  "re-fr-03": [
    { name: "法国少女", role: "叙述者/主人公", description: "以杜拉斯本人为原型的十五岁半的白人少女，在湄公河渡船上遇见了比她大十二岁的中国富商之子。他们的身体、金钱与种族之间的复杂交换——多年后她已将一切写成了不朽的散文：'与你那时的面貌相比，我更爱你现在备受摧残的面容。'龚古尔奖。" },
  ],

  "re-fr-04": [
    { name: "居伊·罗朗", role: "主人公", description: "一个失忆的私人侦探，在巴黎寻找自己遗忘的过去。莫迪亚诺以冷峻的叙事将身份、记忆与被占领的巴黎的暗影编织为一部存在主义侦探小说——他的'寻找'也许永远不会结束，因为'过去'也许从来就不曾存在过。" },
  ],

  "re-de-01": [
    { name: "弗朗茨·比伯科普夫", role: "主人公", description: "一个从柏林监狱释放的前搬运工人，下定决心要做一个'正派人'。但魏玛时代的柏林是一台吞噬灵魂的机器——他卖报纸、加入黑帮、失去了一条手臂——德布林以蒙太奇手法创造了德国版的《尤利西斯》。" },
  ],

  "re-de-02": [
    { name: "古斯塔夫·冯·阿申巴赫", role: "主人公", description: "一个以自律和勤勉著称的德国老作家，在威尼斯度假时爱上了波兰美少年塔齐奥。当霍乱在城中蔓延时，他明知危险却拒绝离开——他对美的凝视最终成为了一场死亡的朝圣。托马斯·曼以此中篇叩问了美与衰朽、理性与欲望的永恒张力。" },
  ],

  "re-ru-01": [
    { name: "亚历山大·彼得罗维奇·戈良奇科夫", role: "叙述者/主人公", description: "一个因杀妻而被判十年苦役的前贵族。陀思妥耶夫斯基以他在西伯利亚劳改营的亲身经历，记录了'死屋'中那些最底层囚犯的日常生活——而他在这些被社会彻底遗弃的人中，发现了令人震惊的人性深度。" },
  ],

  "re-ru-02": [
    { name: "德米特里·涅赫柳多夫公爵", role: "主人公", description: "一个陪审员在法庭上认出了被诬告的妓女卡秋莎——她就是十年前被他引诱后又抛弃的少女。他的余生都投入到了为了赎罪而追随她去西伯利亚流放的旅程中。托尔斯泰最后的长篇小说——关于罪、忏悔与精神复活的道德寓言。" },
    { name: "卡秋莎·玛丝洛娃", role: "女主人公", description: "被涅赫柳多夫诱奸怀孕后被逐出庄园的使女，在社会的底层一步步沦为妓女，最终被诬告谋杀了嫖客。涅赫柳多夫试图以'复活'她来'复活'自己——但她的'复活'并不应该由他来定义。" },
  ],

  "re-es-02": [
    { name: "巴尔塔萨尔", role: "男主人公", description: "一个在西班牙王位继承战争中失去了左手的葡萄牙士兵。他邂逅了'能看到人的意志'的少女布里蒙达——两人在建造马夫拉修道院的血腥劳动中对彼此的爱超越了国王、教会和理性的全部规则。萨拉马戈的杰作。" },
    { name: "布里蒙达", role: "女主人公", description: "一个'能看到人内在意志'的奇异女性。她在清晨空腹时可以看见——人的意志像一团黑色的云悬浮在体内。她与巴尔塔萨尔的爱是全书最明亮的光——在时代的石头与鲜血中。" },
  ],

  "r2-ch-01": [
    { name: "曹七巧", role: "女主人公", description: "张爱玲笔下最令人毛骨悚然的人物——一个被嫁入姜家的麻油西施，伺候一个软骨病丈夫。她牺牲了自己的青春，换来了金钱——但金钱将她变成了一个'疯子'。她用黄金锁链亲手扼杀了自己一双儿女的幸福。傅雷说这是'中国文坛最美的收获之一'。" },
  ],

  "r2-ch-02": [
    { name: "'他'", role: "主人公/叙述者", description: "以郁达夫本人为原型的一个在日本留学的中国青年。他以令人震撼的坦率自述了在异国他乡的性苦闷与民族屈辱——'祖国啊祖国！我的死是你害我的！你快富起来！强起来罢！'——中国现代文学中第一部有影响力的短篇小说集《沉沦》中的第一篇。" },
  ],

  "r2-ru-02": [
    { name: "地下人", role: "主人公/叙述者", description: "一个从公务员岗位上退休的四十岁男人，自愿将自己封闭在彼得堡的地下室中。他以对'理性'、'进步'和'水晶宫'的诅咒性独白为人的非理性自由辩护——'二乘二等于四已经不是生活，而是死亡的开始。'存在主义哲学的开山之作。" },
  ],

  "r2-ru-03": [
    { name: "赫列斯塔科夫", role: "主人公", description: "一个从彼得堡来的低级官吏，在途经外省小城时被当地官员误认为钦差大臣——他顺势扮演了这个角色，从所有人身上榨取了贿赂和奉承。果戈理以这部喜剧对俄国官僚体制进行了最无情的讽刺——'你们都在笑什么？在笑你们自己！'" },
  ],

  "r2-ru-04": [
    { name: "伊凡·伊里奇·戈洛文", role: "主人公", description: "一个体面的法官，在临终的病床上发现他的一生——所有体面的职位、体面的婚姻、体面的装修——不过是一个精心维护的谎言。托尔斯泰晚期的'灵魂手术'——以一个濒死之人在痛苦中终于醒来的故事，作为对中产阶级'体面生活'最致命的审视。" },
  ],

  "r2-eu-03": [
    { name: "让-巴蒂斯特·格雷诺耶", role: "主人公", description: "十八世纪巴黎最臭的鱼市场上出生的弃婴——但他拥有世界上最灵敏的鼻子。他能嗅出一切气味，却发现自己没有任何气味——他为了制造出能让他人'爱他'的终极香水，走上了一条连环杀手的道路。聚斯金德以这部小说创造了一个关于气味、身份与存在的奇异寓言。" },
  ],

  "r2-af-01": [
    { name: "杜波依斯", role: "作者/思想家", description: "第一个获得哈佛博士学位的非裔美国人。在《黑人的灵魂》中他提出了'双重意识'——一个黑人在美国永远'通过他人的眼睛'看自己，他的灵魂被分裂为不可调和的两半——这种对身份的深刻分析影响了此后一个世纪的种族思想。" },
  ],

  "r2-pr-02": [
    { name: "奶娃·戴德", role: "主人公", description: "一个在中西部城市长大的非裔美国青年。为追寻家族宝藏，他从密歇根一路回到弗吉尼亚的祖先之地——在'所罗门之歌'中，他发现自己家族的神话可以追溯到那个'飞走了'的非洲祖先。莫里森将当代黑人的身份追寻与非洲的口头传统无缝编织。" },
  ],

  "r2-pr-05": [
    { name: "悦子", role: "叙述者", description: "一个住在英国乡间的日本寡妇，在长女自杀后开始回忆战后长崎的生活。她的记忆充满了空缺和矛盾——石黑一雄的处女作以'不可靠的叙述者'让读者在阅读中不断怀疑：悦子真正在隐瞒的是什么？" },
  ],

  "r2-pr-06": [
    { name: "凯西·H", role: "叙述者/主人公", description: "黑尔舍姆寄宿学校的学生，以冷静克制的语调回顾了她和两个朋友——汤米和露丝——在英格兰乡村的成长过程。她在叙述中逐步揭示了他们不可告人的'命运'——石黑一雄以最克制的叙述包裹了最令人心碎的反乌托邦。" },
    { name: "汤米", role: "凯西的朋友", description: "黑尔舍姆学校中情绪易波动的男孩，凯西和露丝都爱着他。他对自己的'命运'一度非常愤怒——但最终他以'从不放弃希望'的天真力量完成了所有捐献，也在凯西的记忆中获得了永恒。" },
  ],

  "r2-pr-10": [
    { name: "亨利·弗莱明", role: "主人公", description: "一个渴望'红色英勇勋章'——即战斗伤口——加入美国内战的年轻士兵。在第一次真正战斗中他恐惧地逃跑了——克莱恩以这部小说探索了战争中恐惧与勇气之间那条最复杂也最真实的界线。" },
  ],

  // ============================================
  // 诺贝尔/布克奖补充
  // ============================================

  "re-nb-01": [
    { name: "忒瑞西阿斯", role: "先知/叙述者", description: "荒原中的核心声音——一个跨越了性别和时代的盲眼先知。从伊丽莎白时代的伦敦桥到现代都市的'精神荒漠'，艾略特以五种语言、数十个典故和破碎的人声拼接出了二十世纪最权威的'文明哀歌'。" },
  ],

  "re-nb-04": [
    { name: "德里纳河上的桥", role: "无声的叙述者", description: "维谢格勒城中那座横跨德里纳河的奥斯曼石桥——它是全书真正的'主角'。在四百年的历史中，桥无声地见证了一代又一代人的出生、爱恋、战争与死亡。安德里奇以一座桥的'传记'为巴尔干复杂的历史写下了最庄严的挽歌。" },
  ],

  // ============================================
  // 新增条目 — 亚洲及其他
  // ============================================

  "noh-plays": [
    { name: "世阿弥", role: "能乐大师/作者", description: "日本能乐的集大成者，室町时代的能乐演员、剧作家和理论家。他撰写了《风姿花传》等秘传书，创立了'幽玄'美学——将能乐从庶民娱乐升华为日本最高的舞台艺术。在足利义满将军的庇护下，他以一生的舞台实践将'序破急'的理论注入了每一部能乐作品。" },
    { name: "仕手", role: "能乐主角", description: "能乐中的主角（シテ），戴着面具在舞台上以极限缓慢的动作和吟唱表达亡魂、神灵或疯女的内心世界。他们不是'表演'一个角色——他们是被超自然的存在所'附体'，在梦境般的舞台上将往世的记忆呈现给观众。" },
  ],

  "in-praise-of-shadows": [
    { name: "谷崎润一郎", role: "叙述者/美学思想家", description: "日本唯美派文学巨匠，以感官性的笔触探索日本美学的本质。在《阴翳礼赞》中他从厕所、漆器、能乐面具到羊羹，以对'暗'的礼赞批判了现代文明对阴影的驱逐——'美不在于物体本身，而在于物体与物体之间产生的阴翳'——为东方美学在工业时代的存续发出了最优雅的宣言。" },
  ],

  "the-setting-sun": [
    { name: "和子", role: "女主角/没落贵族女儿", description: "战后日本的华族千金，在大宅被卖、父亲去世和母亲日益衰弱的阴影下，她以日记形式记录了一个阶级的消亡。她执着地爱上弟弟的朋友——酗酒颓废的作家上原——并决定生下他的孩子，以'革命'抵抗'斜阳'的命运。她是太宰治对战后日本'新人'的想象。" },
    { name: "直治", role: "弟弟/战后迷茫青年", description: "和子的弟弟，二战后复员归来深陷鸦片成瘾和精神虚无。他既无法像贵族那样活也无法'融入'平民——夹在两个时代之间，他在遗书中写道：'人就是为了恋爱和革命才生下来的'——然后以自杀结束了这种悬浮。直治是太宰治本人的自画像。" },
    { name: "上原", role: "作家/颓废象征", description: "一个自称'文学殉教者'的作家，酗酒、滥情、自我毁灭。和子向他献上了不顾一切的爱情，而他在酒精中诅咒一切——他是战后日本道德真空的具象化，也是太宰治对自我最不留情的解剖。" },
  ],

  "upanishads": [
    { name: "佚名古代哲人", role: "森林中的思想者", description: "两千五百年前隐居于恒河平原森林中的印度古代思想家们。他们不是'作者'而是'看见者'（ṛṣi）——在冥想与口传中叩问存在的终极问题：'我是谁？'（Tat tvam asi，汝即是那）。《奥义书》的一百余篇对话和诗篇将吠陀祭祀宗教转向了内在哲学的探索——每一篇都是人类最古老也最深刻的灵魂追问。" },
  ],

  "panchatantra": [
    { name: "毗湿奴·沙尔玛", role: "叙述者/婆罗门智者", description: "传说中《五卷书》的作者——一位受国王委托在六个月内将治国之术教给三位愚笨王子的婆罗门智者。他以一百多个动物寓言编织了'计谋、友谊、战争、损失与行动'五卷智慧——每一个故事都是嵌套在另一个故事中的'套盒'结构，从印度出发影响了从《一千零一夜》到《坎特伯雷故事集》的世界叙事传统。" },
  ],

  "kathasaritsagara": [
    { name: "月天", role: "作者/迦湿弥罗诗人", description: "十一世纪克什米尔的梵语诗人，婆罗门出身。他以诗体编撰的《故事海》收录了从天神、妖魔到商人、妓女的两万余则故事——这是印度叙事文学的汪洋大海，'所有故事之母'。月天声称他的故事来自湿婆对妻子帕尔瓦蒂的讲述——将人间一切悲欢都包裹在神圣的框架之中。" },
  ],

  "gitagovinda": [
    { name: "黑天（克里希纳）", role: "牧神/毗湿奴化身", description: "在温达文森林中与牧女们嬉戏的牧神。胜天笔下的黑天不再是《薄伽梵歌》中威严的导师——他是爱人、牧笛手、偷走牧女衣裳的淘气少年。他的'神圣游戏'（līlā）将肉欲与虔信融合为印度教'虔诚运动'最炙热的诗歌。" },
    { name: "拉达", role: "牧女/黑天的恋人", description: "黑天最爱的牧女，她的嫉妒、等待、喜悦与痛苦构成了《牧童歌》的情感核心。当黑天与其他牧女调情时，拉达的哀怨在胜天的梵语中升华为灵魂对神的渴慕——'拉达-克里希纳'从此成为印度想象中最神圣的爱情图式。" },
  ],

  "ramakien": [
    { name: "罗摩（帕拉兰）", role: "主人公/毗湿奴化身", description: "泰国的罗摩——对应印度史诗《罗摩衍那》的罗摩，但在泰国语境中被赋予了更多帝王品格。他远征楞伽、救回王妃希达的旅程构成了这部泰国民族史诗的核心——泰国国王至今以'拉玛'为号，将自身追溯至这一神圣谱系。" },
    { name: "哈奴曼", role: "神猴/忠诚的追随者", description: "风神之子、白猴将军，以不可阻挡的力量和绝对的忠诚助罗摩战胜魔王。在泰国版本中他的形象比印度原版更为活跃和色彩缤纷——他是泰国古典舞剧'孔剧'最受欢迎的角色，其面具和身段是泰国国宝级的艺术符号。" },
    { name: "托萨坎", role: "魔王/十首罗刹", description: "楞伽的魔王——印度史诗中罗波那的泰国对应。他有十个头、二十只手，以苦修获得了梵天赐予的'不被天神或妖魔所杀'的祝福——但他傲慢地忘记了人的可能性。他掳走希达的罪行最终引来了罗摩的复仇，使他成为泰国文学中傲慢与毁灭的终极象征。" },
  ],

  // ================================================================
  // 补遗 — 核心库遗漏 + 全部扩展库真实角色
  // ================================================================

  "hundred-years-solitude": [
    { name: "何塞·阿尔卡蒂奥·布恩迪亚", role: "家族始祖", description: "马孔多的创建者，一个被好奇心与想象力驱动的巨人。从炼金术到冰块，他痴迷于一切新鲜事物，最终因疯狂被绑在栗树上，与幽灵为伴度过余生。他是人类求知欲的象征——也是孤独的第一位继承者。" },
    { name: "乌尔苏拉·伊瓜兰", role: "家族支柱", description: "布恩迪亚家族跨越六代的真正核心。她活了一百多岁，以不可思议的精力与务实精神维系着这个注定孤独的家族。当她失明后，她凭着对家中每一个声音、气味和位置的记忆继续'看见'一切。" },
    { name: "奥雷里亚诺·布恩迪亚上校", role: "主人公", description: "乌尔苏拉的次子，一生发动了三十二次起义、躲过了十四次暗杀、与十七个女人生了十七个儿子。但这一切喧嚣之后，他回到马孔多的工作室，日复一日地制作小金鱼——做好又熔化、熔化再做——在重复中寻找他在战场上从未找到的平静。" },
    { name: "阿玛兰塔·布恩迪亚", role: "关键人物", description: "乌尔苏拉的女儿，一生被爱与嫉妒的烈焰灼烧。她拒绝了所有追求者，自己缝制寿衣——拆了又缝、缝了又拆——以这种方式与死神谈判。她是家族中最孤独的灵魂，因为她主动选择了孤独。" },
    { name: "蕾梅黛丝（美人儿）", role: "象征人物", description: "布恩迪亚家族第四代中最美的女子——美到致命。她天真到活在另一个维度：她不理解任何社会规范，最终在晾晒床单时被一阵风吹上了天空——马尔克斯坚持说她是'升天'的，不是飞走的。她是这部现实主义小说中最纯粹的魔幻。" },
  ],

  // ================================================================
  // 扩展库 — asia.ts 补遗
  // ================================================================

  "jerusalem-delivered": [
    { name: "戈弗雷", role: "主人公", description: "第一次十字军东征的领袖，虔诚而刚毅的基督教骑士。他以信仰的力量率领十字军解放了耶路撒冷——但塔索的同情并不只在基督教一方。" },
    { name: "克洛琳达", role: "关键人物", description: "穆斯林一方的女战士，英勇、高贵。她与十字军骑士坦克雷德在战场上相遇并相恋——最终被坦克雷德在不知情中杀死。她临终受洗的场景是文艺复兴史诗中最哀婉的篇章。" },
  ],
  "le-morte-darthur": [
    { name: "亚瑟王", role: "主人公", description: "英格兰的传奇国王，圆桌骑士的创立者。他从石中拔出宝剑建立王国，却因妻子与挚友的背叛而失去一切。马洛礼笔下的亚瑟不仅是理想的君主——更是一个在理想崩塌时依然保持高贵的人。" },
    { name: "兰斯洛特", role: "关键人物", description: "圆桌骑士中最勇武的一位，亚瑟最信任的骑士——也是亚瑟王后桂妮薇儿的情人。他的双重忠诚（对王的忠诚与对后的爱情）最终撕裂了整个圆桌。" },
    { name: "莫德雷德", role: "反派", description: "亚瑟的私生子（或外甥），圆桌的叛徒。在最后的卡姆兰战役中，他与亚瑟同归于尽——一个黄金时代的终结在此被定格。" },
  ],
  "lysistrata": [
    { name: "吕西斯特拉忒", role: "主人公", description: "一位雅典妇女，组织全希腊的女性发动了一场'性罢工'以迫使男人们结束伯罗奔尼撒战争。阿里斯托芬以她创造了一个关于性别、政治与和平的永恒喜剧原型——两千多年后，反战喜剧的典范依然是它。" },
  ],
  "mother-gorky": [
    { name: "佩拉格娅·尼洛夫娜", role: "主人公", description: "一个普通的俄国工人之母，在儿子投身革命后从恐惧、担忧逐渐走向觉醒。她的转变是缓慢的、有血有肉的——高尔基以她的双眼呈现了20世纪初俄国工人阶级的精神觉醒。" },
  ],
  "mrs-dalloway": [
    { name: "克拉丽莎·达洛维", role: "主人公", description: "一位上流社会的中年女性，在准备当晚派对的寻常一天中回顾了自己的一生——她选择了稳妥的婚姻而非热烈的爱情，而在表面光鲜的伦敦六月清晨下，死亡与衰老的意识从未真正离开过她。" },
    { name: "赛普蒂默斯·史密斯", role: "平行主人公", description: "一战退伍军人，因弹震症而在伦敦街头经历着与克拉丽莎完全平行却永远不相交的精神崩溃。他是达洛维夫人的'影子自我'——她通过他的死亡理解了生命的意义。" },
  ],

  "nibelungenlied": [
    { name: "齐格弗里德", role: "主人公", description: "尼德兰王子，屠龙者，拥有不死之身——除了后背被一片椴树叶遮住的地方。他的英勇为他赢得了勃艮第公主克里姆希尔德的婚约，也为他招来了哈根的长矛——因为英雄的荣耀本身就是死亡的邀请。" },
    { name: "克里姆希尔德", role: "女主角", description: "从勃艮第的温柔公主到匈奴王后的毁灭性复仇者。她为齐格弗里德之死而策划的复仇最终吞噬了所有的尼伯龙根人——她是中世纪文学中最令人震撼的女性角色，从被保护的对象转变为末日浩劫的发动机。" },
  ],
  "orlando-furioso": [
    { name: "奥兰多（罗兰）", role: "主人公", description: "查理大帝麾下最勇武的骑士，因发现恋人安杰丽嘉爱上他人而陷入疯狂。阿里奥斯托以四千多行八行体编织了一幅骑士、魔法、爱情与战争构成的瑰丽画卷——'疯狂'在此不是贬义词，而是爱之极致的证明。" },
  ],
  "peloponnesian-war": [
    { name: "修昔底德", role: "作者/史家", description: "雅典将军出身，因军事失败被流放，转而成为第一个'科学'的历史学家。他以冷酷的精确记录了雅典与斯巴达之间毁灭性的战争——'强者做他们能做的，弱者受他们必须受的。'他至今仍在教导我们什么是权力。" },
  ],
  "sir-gawain": [
    { name: "高文爵士", role: "主人公", description: "亚瑟王的侄子，圆桌骑士中最谦逊的一位。他接受了绿骑士的'砍头游戏'——一年后必须接受对方的回击。在赴约途中，他经历了城堡女主人的三重诱惑——一首关于骑士美德与人性脆弱的精美诗篇由此展开。" },
  ],
  "song-of-roland": [
    { name: "罗兰", role: "主人公", description: "查理大帝麾下最勇猛的骑士，法兰西最伟大的史诗英雄。在龙塞斯瓦列斯山口的伏击战中，他三次拒绝吹响号角求援——'罗兰是勇者，但勇者也会犯错。'他的死是法兰西文学最庄严的时刻。" },
    { name: "奥利维耶", role: "重要人物", description: "罗兰的战友，理智与勇气的对照。他三次催促罗兰吹响号角——'罗兰，理智一些！'——但都被拒绝。他的死亡与罗兰的死亡是史诗中最动人的友谊篇章。" },
  ],
  "the-bacchae": [
    { name: "狄俄尼索斯", role: "主角/神", description: "酒神、狂欢与迷狂之神。他回到忒拜城，以女性追随者（酒神伴侣）的疯狂报复了不信他的国王彭透斯。他是理性的对立面——但不是敌人，而是补充。欧里庇得斯提出了一个至今未解的难题：理性拒绝本能将招致毁灭。" },
    { name: "彭透斯", role: "悲剧主角", description: "忒拜国王，以法律与秩序之名拒绝酒神的崇拜。他的理性傲慢最终导致了他被自己的母亲和酒神伴侣们在迷狂中撕碎——欧里庇得斯在此展现了一种'未被邀请的神'将如何摧毁拒绝他的城邦。" },
  ],
  "the-betrothed": [
    { name: "伦佐", role: "主人公", description: "伦巴第的丝织工，一个朴实的农村青年。在十七世纪米兰大瘟疫和社会动荡中，他与未婚妻露琪亚被命运的洪流一次次冲散——但他们的坚贞最终获得了回报。曼佐尼以他们为中心刻画了一个时代的全景。" },
    { name: "露琪亚", role: "女主角", description: "伦佐的未婚妻，虔诚而温柔的农村女子。她遭受了恶霸堂罗德里戈的绑架与迫害——但她以信仰和不可动摇的道德力量对抗了一切强暴。她是意大利文学中最纯洁的女性形象之一。" },
  ],
  "the-histories": [
    { name: "希罗多德", role: "作者/叙述者", description: "被西塞罗同时称为'历史之父'和'谎言之父'。他游历整个已知世界——从波斯帝国到埃及、从斯基泰草原到尼罗河——以永不疲倦的好奇心记录了各个民族的风俗、历史与传说。他的'历史'既是严谨的考证也是迷人的故事。" },
  ],
  "the-immoralist": [
    { name: "米歇尔", role: "主人公/叙述者", description: "一个年轻学者在重病之后抛弃了一切道德规范，追寻感官与存在的'真实'。纪德以第一人称让读者无法简单审判——我们每个人都潜藏着一个'背德者'。这不是关于堕落，而是关于另一种可能的生命。" },
  ],
  "the-mill-on-the-floss": [
    { name: "玛吉·塔利弗", role: "主人公", description: "一个充满激情的聪慧女子，在维多利亚时代的狭隘环境中挣扎了一生。她深爱着哥哥汤姆——但他的道德审判比社会的更沉重。她在洪水中划向被困的哥哥做最后的和解——这个结局至今是英语文学中最有争议也最催人泪下的场景之一。" },
  ],
  "the-prince": [
    { name: "尼可罗·马基雅维利", role: "作者/思想者", description: "被放逐的佛罗伦萨政治家，在乡间夜晚换上朝服与'古人的王国'对话。他写下了五百年来的政治哲学都无法回避的著作——将政治从道德神学中剥离。'被畏惧比被爱戴更安全'——这不是玩世不恭，而是一种对人性冷峻的认识。" },
  ],
  "the-second-sex": [
    { name: "西蒙娜·德·波伏瓦", role: "作者/思想者", description: "存在主义哲学家，萨特的伴侣。'女人不是天生的，而是后天形成的'——从这句话出发，她以哲学、生物学、精神分析和历史学的多重视角解构了几千年来对女性的建构。这本书开启了第二波女性主义——至今仍是关于性别问题最重要的思想资源。" },
  ],
  "the-sorrows-of-young-werther": [
    { name: "维特", role: "主人公", description: "一个敏感、热情的年轻艺术家，爱上了已经订婚的绿蒂。他的书信记录了从欣喜到绝望的整个过程——他的自杀震动了整个欧洲。歌德创造了第一个现代'受难艺术家'的形象——但他自己后来写道：'我杀了维特来拯救我自己。'" },
  ],
  "the-symposium": [
    { name: "苏格拉底", role: "核心发言者", description: "在一场酒宴上，他转述了女先知狄奥提玛关于爱欲（Eros）的教导：爱不是神而是精灵——一个在贫乏与丰盈之间永远的追求者。'柏拉图式的爱'不是对性的否定，而是一架从可感之美通向可知之美的阶梯。" },
  ],
  "to-the-lighthouse": [
    { name: "拉姆齐夫人", role: "核心人物", description: "一个维多利亚时代的母亲——以无限的温柔维系着整个家庭和所有来访者。伍尔夫问：'一个人的生命中有多少个瞬间，能像拉姆齐夫人吩咐仆人把烤肉端进餐厅的瞬间那样，可以被凝固下来成为永恒？'她在'时间流逝'的中段中去世——但她留下的温暖贯穿始终。" },
    { name: "拉姆齐先生", role: "重要人物", description: "哲学家，一个以逻辑和真理为信仰却终身受困于自我怀疑的人。他需要拉姆齐夫人无条件的支持——但他永远无法说出他的需要。在最后一章中他终于与儿子詹姆斯一起到达了灯塔——这是全书最沉默也最动人的和解。" },
    { name: "莉莉·布里斯科", role: "关键人物", description: "一个画家，全书最终完成了她的画。她见证了拉姆齐夫人是如何'创造'一个世界——而她以另一媒介（绘画）回应了同一种创造冲动。在完成最后一笔时，她'有了她的幻象'——这是关于艺术本质最深刻的表达。" },
  ],
  "tom-jones": [
    { name: "汤姆·琼斯", role: "主人公", description: "被富翁奥尔沃西收养的弃儿，一个好心肠但行事鲁莽的青年。他在十八世纪英国社会中的荒唐冒险——从乡间到伦敦、从监狱到婚床——构成了一幅关于人性的全景画卷。菲尔丁以机智的叙述声音直接对读者说话——这是元小说的最早实践之一。" },
  ],
  "tristram-shandy": [
    { name: "项狄", role: "叙述者/'作者'", description: "一个在整本书中始终无法出生的婴儿——他试图讲述自己的生平和见解，却永远被离题、联想和偶然打断。斯特恩比后现代主义早了两百年——黑色页面、空白页面、曲线图——'小说'这个形式在他的任性中被彻底解放。" },
  ],
  "vanity-fair": [
    { name: "蓓基·夏泼", role: "主人公", description: "文学史上最迷人的'恶女'之一。一个穷画家的女儿，凭着自己的智慧、魅力与彻底的道德弹性在英国上流社会中攀爬。萨克雷说这是一部'没有英雄的小说'——你无法赞同蓓基的行为，但你也无法移开你的目光。" },
  ],

  "doctor-faustus": [
    { name: "浮士德博士", role: "主人公", description: "一个已达到人类知识极限的学者，与魔鬼梅菲斯特签订血契以换取二十四年的无限知识与权力——但代价是他的灵魂。马洛的无韵诗将浮士德的欲望与恐惧升华为英语文学中最激越的声音。'这就是那张引起千帆竞发的脸庞吗？'——在赴死之前他渴求时间凝固。" },
  ],
  "effi-briest": [
    { name: "艾菲·布里斯特", role: "主人公", description: "十七岁嫁给比她年长一倍的因斯特滕男爵，在无聊和孤独中与另一位军官产生了一段轻率的感情。多年后这段'轻佻'被冷酷地揭露——冯塔纳以最精确的笔触呈现了普鲁士社会的道德体系如何将一个小小的过错变为毁灭性的悲剧。" },
  ],
  "gargantua": [
    { name: "高康大", role: "主人公", description: "巨人国王，拉伯雷式身体与智慧的化身。他的食量与排泄都是史诗级的——因为他代表的是生命本身的充盈与狂欢。拉伯雷以他的大笑瓦解了中世纪经院哲学的全部严肃性。" },
    { name: "庞大固埃", role: "主人公（续集）", description: "高康大之子，一位更'文明'但仍然巨人的王子。他继续着父亲的冒险——在拉伯雷手中，这对父子是'民间笑文化'的载体，也是文艺复兴人文主义的欢呼。" },
  ],
  "if-on-a-winters-night": [
    { name: "你（读者）", role: "主人公", description: "'你正要开始阅读伊塔洛·卡尔维诺的新小说《如果在冬夜，一个旅人》。'卡尔维诺以第二人称让你——读者——成为小说的主角。你在追寻一本永远无法完成的书的过程中遇到了十本只有开头的小说……同时也遇到了爱情。" },
    { name: "柳德米拉", role: "女读者", description: "另一位读者——也是你的追寻对象。她的阅读方式是'直接的、身体的'——与学院派的阐释形成鲜明对比。你们两人的相遇和共同追寻将'阅读'变成了一场最亲密的冒险。" },
  ],
  "lives": [
    { name: "普鲁塔克", role: "作者/传记家", description: "希腊出身的罗马公民，以《希腊罗马名人传》开创了一种独特的传记体裁——将希腊与罗马的伟人两两对照（亚历山大与凯撒、狄摩西尼与西塞罗）。莎士比亚的罗马剧几乎全部取材于此书——普鲁塔克比任何人更深地塑造了西方对古典世界的想象。" },
  ],
  "the-glass-bead-game": [
    { name: "约瑟夫·克乃西特", role: "主人公", description: "卡斯塔里亚省的'玻璃球游戏大师'——这一精英精神王国的最高职位。他以一生的精神修炼达到了智力与审美的极致——然后他选择离开。黑塞以自己的精神自传追问：纯粹的精神生活是否本身就是一种逃避？" },
  ],
  "the-reader": [
    { name: "米夏埃尔·伯格", role: "主人公/叙述者", description: "十五岁时与三十六岁的汉娜发生了一段夏日之恋。多年后作为法学院学生在法庭上重新见到了她——她作为纳粹战犯受审。他始终无法向任何人倾诉：她不仅是他的初恋，还是一个文盲——而这一秘密可能改变审判的结果。" },
    { name: "汉娜·施米茨", role: "女主角", description: "一个比她所能承认的更脆弱的前纳粹看守。她宁愿被判处终身监禁也不愿在法庭上暴露自己不识字的秘密——因为对于她来说，'文盲'是比'纳粹战犯'更大的耻辱。施林克以她撕开了德国战后一代与父辈之间所有未愈合的伤口。" },
  ],
  "confessions-augustine": [
    { name: "奥古斯丁", role: "作者/自传者", description: "从北非浪子到希波主教的灵魂之旅。他以少年时代一次'偷梨'事件为起点，进行了西方文学史上第一次深度的心理与神学分析——'人心是为祢而造的，除非安息于祢，否则永无安宁。'这部自传是西方'自我'意识的出生证明。" },
  ],
  "essais-montaigne": [
    { name: "米歇尔·德·蒙田", role: "作者/'我'", description: "'我本身就是我的书的材料。'他以'我知道什么？'（Que sais-je?）为座右铭，发明了'随笔'（essai）这一体裁——不是体系的建构，而是思想在纸上的试验。他写拇指、睡眠、友谊、食人——在自我解剖中发现了普遍的人性。所有随笔作家的祖师爷。" },
  ],

  // ================================================================
  // 扩展库 — africa-americas-oceania.ts + bulk-expansion.ts + real-expansion.ts 补遗
  // ================================================================

  "as-i-lay-dying": [
    { name: "安斯·本德伦", role: "核心人物", description: "一个密西西比农民，在妻子艾迪去世后带着孩子们用骡车拉着她的棺材去杰弗逊城——实现她'葬在娘家'的遗愿。全书有十五个不同的叙述者，安斯自己是最令人恼火也最可笑的一个——他在埋葬了妻子后当天就给自己买了一副新假牙和一个新老婆。" },
    { name: "达尔·本德伦", role: "关键叙述者", description: "安斯的次子，全书最敏锐也最被疏离的声音。他能'看见'别人的内心——这使他成为最不可靠也最可靠的叙述者。在试图焚烧母亲的棺材以结束这荒唐旅程后，他被送进了精神病院——以第三人称叙述自己。" },
  ],
  "atonement": [
    { name: "布里奥妮·塔利斯", role: "主人公", description: "一个十三岁时以错误的指控毁掉了姐姐塞西莉亚和罗比一生的女孩。全书就是她作为小说家的'赎罪'——以小说重构她无法在现实中修复的过去。麦克尤恩追问：文学能成为对现实所犯之罪的赎罪吗？" },
    { name: "罗比·特纳", role: "男主角", description: "管家之子，剑桥毕业，因布里奥妮的诬告被判入狱——然后从监狱直接送上了二战战场。他与塞西莉亚的爱情是全书最温暖的火焰——也是布里奥妮终身无法熄灭的火焰。" },
  ],
  "bleak-house": [
    { name: "以斯帖·萨默森", role: "叙述者之一", description: "一个被慈善家贾迪斯先生收留的孤女，以温柔的理性和沉静的勇气成为了狄更斯所有小说中最成熟的第一人称叙述者。她的故事与戴德洛克夫人的秘密平行展开——构成了双重叙事的精妙结构。" },
    { name: "戴德洛克夫人", role: "关键人物", description: "高傲的贵族夫人，隐藏在冰冷外表下的是一段不可告人的过去——一个婚前的情人和一个私生女。当秘密被揭露时，她在暴风雪中倒在所爱之人的墓前——狄更斯以她写出了维多利亚社会中最令人心碎的女性悲剧。" },
    { name: "约翰·詹狄士", role: "重要人物", description: "一场横跨几十年的遗产诉讼案的当事方之一——但也是唯一一个拒绝被这件案子吞噬的人。他将以斯帖收为养女，在所有人都在疯狂中保持了一种珍贵的理智与善意。" },
  ],
  "blindness": [
    { name: "医生的妻子", role: "主人公", description: "全书唯一没有失明的人——她在所有人都'盲'了的世界中装作自己也看不见，以保护自己和丈夫。萨拉马戈以她追问：当所有人都不再'看见'，唯一能看见的人就必须承担全部的重负——但她能够坚持多久？" },
  ],
  "cairo-trilogy": [
    { name: "艾哈迈德·阿卜杜勒·贾瓦德", role: "家族之父", description: "开罗的一个商人，在家中是严苛的家长——在外面却是尽情享乐的花花公子。马哈福兹以他和他三个儿子的命运浓缩了埃及社会从1919年革命到1952年政变的全部变迁——这就是阿拉伯世界的《布登勃洛克一家》。" },
    { name: "凯末尔", role: "关键人物", description: "贾瓦德的小儿子，全书最核心的意识中心。他从虔诚的宗教学生变为无神论的存在主义者，从一个被动的观察者变为革命的参与者和幻灭者——他的精神历程就是埃及现代知识分子的精神历程。" },
  ],
  "chaka": [
    { name: "恰卡", role: "主人公", description: "祖鲁帝国的创立者，非洲最伟大的军事天才。莫弗洛以莎士比亚般的笔触刻画了他从英雄到暴君的转变——他的权力欲望最终吞噬了他所爱的每一个人和他自己。这是非洲现代文学的第一部杰作——一个关于权力与疯狂的非洲悲剧。" },
  ],
  "chekhov-stories": [
    { name: "德米特里·古罗夫", role: "《带小狗的女人》主人公", description: "一个在雅尔塔度假时以为自己只是在经历又一次风流韵事的银行职员——但这次他爱上了一个带小狗的女人安娜·谢尔盖耶夫娜。契诃夫让两个平凡的人在彼此身上发现了真正的爱——而他们所能做的最勇敢的事就是继续等待。" },
  ],
  "chronicle-of-a-death-foretold": [
    { name: "圣地亚哥·纳萨尔", role: "死者", description: "一个在婚礼后的清晨被两兄弟用屠刀在广场上当众杀死的人——全镇的人都提前知道他会被杀，但每一个人都以各自的理由'不阻止'。马尔克斯从第一句就告诉读者他死了——然后追问他为什么必须死。" },
    { name: "安赫拉·维卡里奥", role: "关键人物", description: "被新郎在新婚之夜退回的新娘——因为她不是处女。她在被逼问时说出了纳萨尔的名字——是真话还是掩护？三十八年后她拒绝给出答案。她是全书沉默的中心——而整个小镇的荣誉谋杀由此展开。" },
  ],
  "civil-disobedience": [
    { name: "亨利·大卫·梭罗", role: "作者/思想者", description: "因拒付人头税而入狱一夜的'隐士'——他从牢房中发出了美国思想史上最具影响力的政治宣言。'在一个不公正地关押任何人的政府之下，公正的人真正的位置也是监狱。'甘地和马丁·路德·金都直接继承了他的'非暴力抵抗'。" },
  ],
  "cloudstreet": [
    { name: "莱斯特·兰姆", role: "家族父亲", description: "兰姆家的父亲，在珀斯买了云街一号——一栋有鬼魂出没的大房子。他与妻子和六个孩子在二十年时光中与皮克尔斯家共享这栋房子——怀特以这两家人的命运谱写了澳大利亚最温暖也最坚韧的家族史诗。" },
  ],
  "conversation-in-the-cathedral": [
    { name: "圣地亚哥·萨瓦拉", role: "主人公/提问者", description: "一个秘鲁富家子弟，在奥德里亚独裁统治下的利马向一个前司机问了一个无法回答的问题：'秘鲁是什么时候开始完蛋的？'四个小时的'谈话'逐层揭开了秘鲁社会每个阶层的腐败——略萨以这部小说证明了小说可以是整个国家的一面镜子。" },
  ],
  "death-and-kings-horseman": [
    { name: "埃莱辛", role: "主人公", description: "约鲁巴国王的马夫长——根据传统，国王死后三十天，马夫长必须自杀以陪伴国王前往祖先的世界。但埃莱辛在最后关头犹豫了——索因卡以约鲁巴宇宙观追问：当一个仪式性的死亡被殖民者以'谋杀'的名义阻止，谁才是真正的正义？" },
  ],
  "demons": [
    { name: "尼古拉·斯塔夫罗金", role: "核心人物", description: "俄国文学中最令人不安的人物之一——一个俊美、富有、无所不能的人，却因灵魂的空虚而逐渐走向毁灭。他的'忏悔'（因审查被删除的一章）是对虚无主义最彻底的解剖——他做恶不是因为信仰什么，而是因为什么都不信仰。" },
    { name: "彼得·维尔霍文斯基", role: "阴谋家", description: "一个革命阴谋的组织者——他操纵、恐吓和谋杀，不是出于任何政治信仰，而是出于对权力的纯粹渴望。陀思妥耶夫斯基以他最尖锐地预言了二十世纪的极权主义——意识形态可能只是权力意志的外衣。" },
  ],
  "el-senor-presidente": [
    { name: "总统先生", role: "独裁者", description: "一个从未被直接命名但无处不在的独裁者。阿斯图里亚斯以表现主义的笔法将他塑造成一个恶魔般的、超自然的存在——他的恐惧笼罩着每一个人。这是拉丁美洲'独裁者小说'传统的开创之作。" },
  ],
  "eugene-onegin": [
    { name: "叶甫盖尼·奥涅金", role: "主人公", description: "俄国文学中第一个'多余的人'——一个厌倦了一切的上流社会青年。他拒绝了塔季扬娜真挚的爱情，在决斗中杀死了好友连斯基——当多年后他终于爱上她时，她已经成为了将军夫人。'但我已被交给了另一个人——我将一生对他忠诚。'" },
    { name: "塔季扬娜·拉林娜", role: "女主角", description: "一个在乡下长大、痴迷于浪漫小说的女孩，勇敢地向奥涅金写信表白——却被拒绝。多年后她成了彼得堡上流社会的王妃，奥涅金反过来追求她。但塔季扬娜不是他——她选择了忠诚而非激情——成为俄国文学中最令人尊敬也最令人心碎的女性形象。" },
  ],
  "a-portrait-of-the-artist": [
    { name: "斯蒂芬·迪达勒斯", role: "主人公", description: "从耶稣会寄宿学校的虔诚男孩到宣布'我不侍奉'的艺术青年——斯蒂芬的精神觉醒是乔伊斯对每一个艺术家的发育史追踪。他最终选择离开爱尔兰——'用在我灵魂的铁匠铺中锻造出的未被创造出来的种族良知'——而斯蒂芬将继续成为《尤利西斯》中的核心人物。" },
  ],

  // ================================================================
  // 扩充库 — bulk-expansion.ts (bk-*) 全部真实作品角色
  // ================================================================

  "bk-ch-002": [ { name: "唐明皇（李隆基）", role: "主人公", description: "大唐帝国的皇帝，因对杨贵妃的深恋而荒废了朝政。安史之乱爆发后，他在马嵬坡被迫赐死杨贵妃——洪昇将这段爱情与亡国交织的悲剧写成了中国戏曲史上最华丽的'皇家爱情挽歌'。" }, { name: "杨贵妃（杨玉环）", role: "女主角", description: "'回眸一笑百媚生，六宫粉黛无颜色。'中国历史上最著名的美人——她的爱情与死亡成为了中国文学中永恒的主题。在洪昇笔下，她不仅是被爱的对象，也是一个有主体性的、深情而高贵的女性。" } ],
  "bk-ch-003": [ { name: "侯方域", role: "主人公", description: "明末复社文人，与秦淮名妓李香君相恋。当江山倾覆，他们个人的爱情在历史巨变中如桃花扇般被撕裂——孔尚任以一把扇子承载了一个时代的悲欢离合。" }, { name: "李香君", role: "女主角", description: "秦淮八艳之一，以血溅桃花扇的刚烈拒绝了奸臣的逼婚。她不仅是侯方域的恋人——更是明朝遗民气节的女性化身。孔尚任借她之口说出：'兴亡百姓苦，桃花扇底歌。'" } ],
  "bk-ch-006": [ { name: "唐敖", role: "主人公", description: "一个落第秀才，随妻弟林之洋出海游历了海外奇国——君子国、女儿国、无肠国……李汝珍以他的航行创造了中国文学中最丰富的幻想世界——同时也是一部温和的'女性主义'乌托邦小说。" } ],
  "bk-ch-007": [ { name: "九死一生", role: "叙述者", description: "吴趼人笔下的'第一人称'叙述者——以'九死一生'为笔名记录了他在晚清中国二十年间的所见所闻。他所目睹的官场腐败、社会黑暗和人性扭曲构成了中国最尖锐的谴责小说之一。" } ],
  "bk-ch-008": [ { name: "各式官员", role: "讽刺对象群体", description: "李宝嘉以连续的短篇故事串联起一幅晚清官场的百丑图——从捐官到收贿、从阿谀到腐败——每一篇都是对官僚体制锋利的一刀。《官场现形记》是中国最系统的政治讽刺小说。" } ],
  "bk-jp-001": [ { name: "伊邪那岐与伊邪那美", role: "创世神", description: "日本神话中的创世兄妹神——从混沌中诞生了日本列岛和众神。《古事记》以他们为起点，将日本的神话、历史和早期诗歌编织为一部'神圣的族谱'——天皇的血脉自此可追溯至天照大神。" } ],
  "bk-jp-002": [ { name: "纪贯之", role: "编纂/序言作者", description: "平安时代最杰出的歌人与文论家。他主持编纂的《古今和歌集》确立了日本古典和歌的美学正统——他在假名序中提出的'心'与'词'的辩证至今仍是日本诗学的核心命题。" } ],
  "bk-jp-003": [ { name: "菅原孝标女", role: "作者/叙述者", description: "平安时代贵族女性，菅原道真的后裔。她的日记跨越近四十年——从少女对《源氏物语》的痴迷到晚年对人生的回顾——是一部以女性内心视角书写的平安时代精神史。" } ],
  "bk-jp-004": [ { name: "各式鬼魂与人物", role: "故事群像", description: "上田秋成以九篇怪谈小说探索了日本文学中'怨灵'、'执念'与'超自然'的主题。每一篇都是一次道德拷问——鬼魂之所以存在，是因为人间的冤屈尚未得到平复。" } ],
  "bk-jp-005": [ { name: "太田丰太郎", role: "主人公", description: "被派往德国留学的日本青年官僚，与德国舞女爱丽丝相恋——却在'名誉'与爱情之间选择了前者。森鸥外以他写尽了明治时代知识分子的精神分裂——'东方的道德'与'西方的自由'之间的撕裂。" } ],
  "bk-jp-006": [ { name: "丑松", role: "主人公", description: "一个隐瞒'部落民'出身的青年教师——在明治日本的等级社会中，他的身份一旦暴露就将失去一切。岛崎藤村以他的挣扎写出了日本文学史上第一部严肃的社会问题小说。" } ],
  "bk-jp-007": [ { name: "莳冈家四姐妹", role: "主人公群像", description: "大阪没落富商家的四姐妹——鹤子、幸子、雪子和妙子——在昭和战前的关西社会中各自寻找爱情与生存之道。谷崎以最精细的笔触刻画了传统日本美学与现代社会之间的碰撞——一幅渐渐褪色的'大和绘'。" } ],
  "bk-jp-008": [ { name: "鸟", role: "主人公", description: "一个年轻的日本知识分子，在他的第一个孩子出生时得知婴儿患有脑疝。大江健三郎以自身的经历为素材——'个人的体验'是对存在、责任与逃避最诚实的文学解剖。" } ],
  "bk-jp-009": [ { name: "御影樱", role: "主人公", description: "一个在祖母去世后独自面对世界的年轻女性。吉本芭娜娜以她在厨房中的平静时刻——一杯茶、一顿饭——来对抗现代都市中的孤独与死亡。'厨房'在此成为了现代人的精神避难所。" } ],
  "bk-in-001": [ { name: "豆扇陀", role: "国王/爱人", description: "仙人的诅咒使他忘记了自己深爱过的净修女沙恭达罗——'戒指'是唯一的凭证。迦梨陀娑以他对记忆、遗忘与爱情本质的探索写出了印度古典文学最完美的戏剧。" }, { name: "沙恭达罗", role: "女主角", description: "在净修林中长大的少女，与来访的国王豆扇陀一见钟情并以'乾闼婆'（自由）方式结婚。当她失去了记忆中的戒指时，她的丈夫遗忘了她——迦梨陀娑以她的等待与最终团聚创造了印度美学中的'爱之理想'。" } ],
  "bk-in-002": [ { name: "查鲁达塔", role: "主人公", description: "一个从富商沦落为穷人的婆罗门，仍然保持着对世人的善心。首陀罗迦以他与名妓春军的爱情故事创造了印度古典戏剧中罕见的社会现实主义——富人与穷人、善与恶在同一座城市中交织。" } ],
  "bk-in-004": [ { name: "戈拉", role: "主人公", description: "一个狂热的印度民族主义者——以印度教正统自居——最终发现自己是被一个爱尔兰家庭收养的孤儿。泰戈尔以这一身份的'地震'追问了民族主义、宗教与人性之间最根本的关系。" } ],
  "bk-in-005": [ { name: "拉朱", role: "主人公", description: "从一个小镇导游变成了'圣人'——不是因为他有智慧，而是因为一个误会（村民以为他在斋戒）。纳拉扬以戏谑的笔触探索了一个深刻的真理：我们扮演的角色最终会成为我们。" } ],
  "bk-in-006": [ { name: "萨利姆·希奈", role: "主人公/叙述者", description: "在印度独立那一夜午夜零时出生的孩子——他的命运与国家的命运被'魔力'绑在了一起。拉什迪以他和他那一代'午夜之子'的命运勾勒了印度从独立到紧急状态的三十年。" } ],
  "bk-in-007": [ { name: "埃斯塔与拉赫尔", role: "主人公", description: "一对印度喀拉拉邦的'双胞胎'——同卵双生的兄妹。洛伊以他们童年一个致命的夏天为核心，以'微物'——一只橘子、一只飞蛾——折射了印度种姓制度中'爱情的法律'如何摧毁了最不应该被摧毁的人。" } ],
  "bk-kr-001": [ { name: "洪吉童", role: "主人公", description: "贵族父亲与婢女生下的庶子，无法被承认身份——最终离开家庭成为'活贫党'的首领，劫富济贫。许筠以他创造了韩国文学第一个'罗宾汉式'英雄——也是对朝鲜时代嫡庶制度的尖锐批判。" } ],
  "bk-kr-002": [ { name: "崔瑞熙", role: "主人公", description: "朴景利长达二十五年创作的史诗巨著《土地》的核心女性——跨越了从十九世纪末到日本殖民时代的半岛历史。她是韩国文学中最壮丽的女性史诗形象。" } ],
  "bk-kr-003": [ { name: "英惠", role: "主人公", description: "一个普通的韩国家庭主妇，一天决定不再吃肉。这个看似微小的拒绝引爆了她的婚姻、家庭和她自己的身体——韩江以她的'素食宣言'追问了在暴力构成的社会中何为'正常'、何为'疯狂'。" } ],
  "bk-pe-001": [ { name: "昂苏尔·玛阿里", role: "作者/父亲", description: "齐亚尔王朝的王子，为儿子写下了这部波斯中世纪最重要的'君主明鉴'——从交友、饮酒到治国、从医，涵盖了波斯-伊斯兰贵族教育的全部内容。这部书是波斯智慧文学的高峰。" } ],
  "bk-pe-002": [ { name: "薇思", role: "女主角", description: "与拉敏从小订婚的公主——却被她未来的丈夫（拉敏之兄）的国王逼迫改嫁。她与拉敏的爱情在波折与分离中最终取得了胜利——古尔冈尼开创了波斯中世纪爱情史诗的传统。它的坦率与热情至今令读者惊讶。" } ],
  "bk-gr-001": [ { name: "赫西俄德", role: "诗人/作者", description: "与荷马齐名的古希腊史诗诗人。在《工作与时日》中他以第一人称教导兄弟如何耕作和做人——这是西方文学中第一部'说教史诗'，但赫西俄德的愤怒和正义感使它远不止于此。" } ],
  "bk-gr-002": [ { name: "俄瑞斯忒斯", role: "主人公", description: "阿伽门农之子——为报父仇而杀死了母亲克吕泰涅斯特拉。埃斯库罗斯以他的审判追问了从血亲复仇到城邦法治的文明跃迁——复仇女神最终成为了雅典城的守护者。" } ],
  "bk-gr-003": [ { name: "狄俄尼索斯", role: "主角", description: "酒神化作凡人下到冥界——不是为了拯救英雄，而是为了带回最'烂'的悲剧诗人欧里庇得斯。阿里斯托芬以这部'文学批评'喜剧在冥界中审判了埃斯库罗斯与欧里庇得斯——而真正的赢家是笑声本身。" } ],
  "bk-uk-001": [ { name: "红十字骑士", role: "主人公", description: "圣洁的化身，踏上了斩杀巨龙拯救王国之旅。斯宾塞以他的冒险将亚瑟王传奇与基督教的道德寓言融合为英语文学中最绮丽的史诗——每一节都是一幅'说话的画面'。" } ],
  "bk-uk-002": [ { name: "约里克牧师", role: "主人公/叙述者", description: "一个善良、易感但无能的牧师，在法国和意大利的旅行中经历了无数可笑的感伤遭遇。斯特恩以他开创了'感伤小说'——但'感伤'在他的手中总是被反讽和自嘲所冲淡，比后来所有的模仿者都更微妙。" } ],
  "bk-uk-003": [ { name: "范妮·普莱斯", role: "主人公", description: "一个被送到富有的叔父家寄养的穷亲戚家的女孩——安静、羞怯、道德坚定。与奥斯汀其他活泼的女主人公相比，范妮是最'不讨喜'也最深刻的一个——她的沉默本身就是一种道德判断。" } ],
  "bk-uk-004": [ { name: "格兰特利主教", role: "核心人物", description: "巴切斯特教区的主教，一个在教会政治和世俗利益之间挣扎的'体面'人。特罗洛普以他为枢纽编织了一张英国教会系统内部的人情与权力之网。" } ],
  "bk-uk-006": [ { name: "阿齐兹医生", role: "主人公", description: "一个印度穆斯林医生，在被诬告性侵一名英国女性后经历了殖民司法的全部荒谬。福斯特以他追问了一个至今未解的问题：'印度人'和'英国人'能否成为真正的朋友？" } ],
  "bk-uk-007": [ { name: "查尔斯·史密森", role: "主人公", description: "维多利亚时代的绅士，在莱姆里吉斯的海堤上爱上了神秘的法国中尉的女人莎拉——但他同时与另一个女人订了婚。福尔斯以元小说的方式（提供了三个不同结局）追问：角色是否有'自由意志'？" } ],
  "bk-fr-001": [ { name: "克莱芙王妃", role: "主人公", description: "十六世纪法王亨利二世宫廷中的绝美女子，嫁给了自己敬爱但不热爱的亲王。当她爱上了内穆尔公爵后，她做出了文学史上最著名的道德选择之一——向丈夫坦白'她爱着别人'——这一'坦白'至今震撼着每个读者。" } ],
  "bk-fr-003": [ { name: "法布里斯·德尔·东戈", role: "主人公", description: "一个痴迷于拿破仑的意大利贵族青年，在滑铁卢战役中见证了他梦想的终结。司汤达以他的旅程追问：在复辟时代，一个向往英雄主义的年轻人还能怎样生活？" } ],
  "bk-fr-006": [ { name: "马塞尔（叙述者）", role: "主人公/叙述者", description: "一个终生追寻时间本质的人。当'玛德莱娜'蛋糕浸入茶水的味道使他整个童年从茶杯中浮现——他终于找到了写作一生的主题：不是找回过去，而是捕捉'永恒'——那些超脱了时间的瞬间。" } ],
  "bk-ru-001": [ { name: "奥涅金", role: "主人公", description: "（参见 eugene-onegin 条目）" } ],
  "bk-ru-002": [ { name: "塔拉斯·布尔巴", role: "主人公", description: "哥萨克老首领，以铁血精神为信仰。当他发现小儿子为了一个波兰女人背叛了哥萨克军——他亲手杀死了自己的儿子。果戈理以他创造了最极致的'忠诚'考验——当忠诚与父子之情冲突时。" } ],
  "bk-ru-003": [ { name: "叶连娜", role: "主人公", description: "一个在俄国贵族家庭中成长但不安于传统的女性。在《前夜》中，屠格涅夫以她选择了一位保加利亚革命者而追问了俄国'新女性'的可能性——以及'行动'与'沉思'之间的张力。" } ],
  "bk-ru-005": [ { name: "波兹德内舍夫", role: "叙述者", description: "在火车上对一个陌生乘客讲述他如何因嫉妒而杀害妻子的故事。托尔斯泰晚年的这部中篇是他对性、婚姻与'高雅艺术'（贝多芬的克莱采奏鸣曲！）所作的最激进的道德批判。" } ],
  "bk-de-001": [ { name: "纳坦", role: "主人公", description: "一个犹太商人，在十字军时代的耶路撒冷以其智慧解决了犹太教、基督教与伊斯兰教之间的一个'寓言性'冲突。莱辛以他弘扬了启蒙运动的核心理念：宗教之间的宽容与友谊。" } ],
  "bk-de-002": [ { name: "威廉·麦斯特", role: "主人公", description: "一个放弃商人生涯投身剧院的青年——但他的'戏剧使命'最终让位于'生命使命'。歌德以他的成长创造了'成长教育小说'（Bildungsroman）的原型——威廉不是通过学习而是通过生活本身而'长大'的。" } ],
  "bk-de-003": [ { name: "诺瓦利斯", role: "诗人/抒情主体", description: "德国浪漫主义最纯粹的声音。在未婚妻索菲去世后，他以《夜颂》将死亡、黑夜和神秘主义转化为德语诗歌中最美的诗篇——'黑夜'不是恐惧而是渴望，是对在日光中被遗忘的无限性的回归。" } ],
  "bk-de-004": [ { name: "米夏埃尔·伯格", role: "（参见 the-reader）" , description: "" } ],
  "bk-east-001": [ { name: "斯蒂芬·茨威格", role: "作者/思想者", description: "以传记家的笔力写下了他对荷尔德林、克莱斯特和尼采的精神剖析。茨威格追问的是：为什么最伟大的创造者往往也是被'魔鬼'（疯狂）所吞噬的人？" } ],
  "bk-east-002": [ { name: "帅克", role: "主人公", description: "一个布拉格狗贩子，在第一次世界大战爆发后被征召入伍。他以'弱智'般的忠诚和天真——或是一种更为高明的'装傻'？——将奥匈帝国军国主义的全部荒谬暴露无遗。哈谢克以他创造了一个不朽的反战争喜剧形象。" } ],
  "bk-es-001": [ { name: "劳伦蒂娅", role: "女主人公", description: "羊泉村的村妇，被驻军指挥官诱拐。她的控诉激怒了整个村子——集体起义杀死了暴君。洛佩·德·维加以她写出了'集体的正义'——当国王追问'是谁干的？'整个村子齐声回答：'羊泉村！'" } ],
  "bk-es-002": [ { name: "唐璜（唐胡安）", role: "主人公", description: "西方文学中最著名的诱惑者与亵渎者的原型。蒂尔索·德·莫利纳以他创造了后来被莫里哀、拜伦和莫扎特不断重写的形象——一个以诱惑为运动的人最终被石像拖入了地狱。" } ],
  "bk-es-003": [ { name: "新娘", role: "主人公", description: "在婚礼前夕与旧情人逃走的安达卢西亚新娘。洛尔迦将个人欲望与社会荣誉的冲突提升为血的仪式——'血婚'是西班牙最深刻的悲剧诗。" } ],
  "bk-it-002": [ { name: "梅达尔多子爵", role: "主人公", description: "在战场上被一颗炮弹劈成了两半——'好的一半'和'坏的一半'各自回到了家乡。卡尔维诺以这则寓言追问了人性的完整性问题——每一个'善人'都包含着一个'恶人'，反之亦然。" } ],
  "bk-nord-001": [ { name: "克里斯汀·拉夫朗", role: "主人公", description: "十四世纪挪威的一个贵族女性——从少女、妻子、母亲到修女的整个人生历程。温塞特以她创造了中世纪北欧文学中最完整的女性史诗——她因此获得了诺贝尔文学奖。" } ],
  "bk-nord-002": [ { name: "尼尔斯·霍尔格松", role: "主人公", description: "一个被变成了小人儿的瑞典男孩，骑在鹅背上跟随大雁飞越了整个瑞典。拉格洛夫以他的飞行将地理课本变成了一部令人难忘的童话——每一个瑞典孩子至今都从尼尔斯的背上'看见'了自己的祖国。" } ],
  "bk-af-002": [ { name: "沃莱·索因卡", role: "作者/叙述者", description: "诺贝尔文学奖得主以童年回忆录的形式记录了他1940年代在尼日利亚阿凯的成长。他以一个孩子的目光——未经意识形态过滤——记录了一个约鲁巴男孩在殖民教育与本土传统之间的童年。" } ],
  "bk-af-003": [ { name: "三毛", role: "作者/叙述者", description: "中国台湾作家，与丈夫荷西在西属撒哈拉沙漠生活的记录。她以最朴素的散文将撒哈拉的血、沙与爱情写成了一代华语读者心中最浪漫的异域梦想。" } ],
  "bk-af-004": [ { name: "行政官", role: "主人公/叙述者", description: "帝国边陲的一个无名行政官，在'文明'与'野蛮'之间开始怀疑他自己所服务的帝国。库切以他追问：在'文明'的帝国施展'酷刑'时，谁才是真正的'野蛮人'？" } ],
  "bk-af-005": [ { name: "奥兰纳", role: "主人公", description: "一个伊博族教授之妻，比夫拉战争夺走了她的一切。阿迪契以她的目光还原了1960年代尼日利亚内战中被主流历史叙事所遮蔽的'日常的毁灭'。" }, { name: "奥登尼博", role: "男主角", description: "奥兰纳的丈夫，伊博族知识分子和革命者。他对'独立'的理想与比夫拉的现实之间的裂痕构成了全书最尖锐的政治追问。" } ],
  "bk-af-006": [ { name: "希沙姆·马塔尔", role: "作者/叙述者", description: "利比亚作家在失踪二十余年后回到祖国寻找父亲的踪迹。这部回忆录将个人的丧父之痛与国家的创伤记忆交织为一部深刻的'返乡'叙事——获得了普利策奖。" } ],
  "bk-am-003": [ { name: "埃德娜·庞特利埃", role: "主人公", description: "一个已婚的克里奥尔资产阶级女性，在一个夏天中觉醒了——她发现了自己的身体、欲望和作为一个独立存在的'我'。她最终游向大海——游向了不被社会所定义的'自由'。肖邦的这部小说在出版后被禁了几十年，因为它太'危险'了。" } ],
  "bk-am-004": [ { name: "乔治·巴比特", role: "主人公", description: "美国中西部一个'典型的'房地产商人——以商业为信仰、以'俱乐部'为教堂、以消费为人生意义。辛克莱·刘易斯以他创造了'巴比特'这个词——一个永远活在标准答案中的人。刘易斯因此成为第一个获得诺贝尔文学奖的美国人。" } ],
  "bk-am-005": [ { name: "尤金·甘特", role: "主人公", description: "托马斯·沃尔夫的'另一个我'——一个在北卡罗来纳山区长大的敏感少年，在家庭的爱与暴力、小镇的温馨与窒息中挣扎着要成为作家。沃尔夫以他写出了美国文学中最奔放、最膨胀也最动人的成长小说。" } ],
  "bk-la-001": [ { name: "总统先生（卡布雷拉）", role: "独裁者", description: "（参见 el-senor-presidente）——阿斯图里亚斯以他为拉美文学开创了'独裁者小说'的传统。" } ],
  "bk-la-002": [ { name: "巴特比", role: "主人公", description: "华尔街的一个抄写员——'我宁愿不。'（I would prefer not to.）他以这句温和而不可摧毁的拒绝瓦解了所有常规社会的逻辑。麦尔维尔以他创造了一个至今无人能完全解释的谜——他是反抗者、抑郁症患者还是某种存在主义圣人？" } ],
  "bk-la-003": [ { name: "莫利纳", role: "核心人物", description: "一个因同性恋入狱的橱窗设计师——在狱中他给政治犯瓦伦丁讲述电影故事以消磨时光。普伊格以两人的对话在最黑暗的牢房中创造了一束关于欲望、革命和电影的人性之光。" } ],
  "bk-la-004": [ { name: "克拉拉", role: "家族核心", description: "（参见 house-of-spirits）" } ],
  "bk-oc-003": [ { name: "艾达", role: "主人公", description: "一个哑巴的苏格兰女性，带着钢琴和私生女被送到新西兰嫁给一个陌生男人。在以钢琴为唯一表达工具的世界中，她的'沉默'本身就是最大的声音——关于欲望、意志和女性在殖民地边缘的生存。" } ],
  "bk-sea-001": [ { name: "胡志明", role: "作者/诗人", description: "在国民党监狱中写下的诗篇——以古典汉诗的形式承载了一位革命者的灵魂。'狱中日记'不仅是政治文献，更是一个在最恶劣环境中依然能'看见'月光的人的诗性证明。" } ],
  "bk-sea-002": [ { name: "明克", role: "主人公", description: "爪哇土著青年，在荷属东印度殖民地接受了荷兰教育——'现代'的知识使他觉醒，但这个'现代'世界从一开始就拒绝了他的进入。普拉姆迪亚以他书写了印尼民族觉醒的史诗。" } ],

  // ================================================================
  // 扩充库 — real-expansion.ts (re-* / r2-*) 全部真实作品角色
  // ================================================================

  "re-ch-01": [ { name: "阿Q", role: "主人公", description: "未庄的雇农，以'精神胜利法'面对一切屈辱和失败——'儿子打老子'。鲁迅以他创造了中国现代文学中最深刻的文化批判符号——一个连自己的姓名都没有的人，却有一整套自我欺骗的哲学。" } ],
  "re-ch-02": [ { name: "老通宝", role: "主人公", description: "江南蚕农，在'丰收成灾'的1930年代亲眼看着一整个春天的劳作化为乌有。茅盾以他的命运追问了中国农村经济崩溃的结构性原因。" } ],
  "re-ch-03": [ { name: "汪文宣", role: "主人公", description: "抗战时期重庆的一个小职员，在战争、贫困和肺病中挣扎求生。巴金以他的'寒夜'写出了普通人在大历史中的无声消亡。" } ],
  "re-ch-04": [ { name: "祁老人", role: "家族核心", description: "北京小羊圈胡同的祁家老太爷，在日军占领北平的八年中守护着四世同堂的家。老舍以他和他的儿孙们追问了一个民族在沦陷中如何保持尊严。" } ],
  "re-ch-13": [ { name: "柳县长", role: "主人公", description: "一个为了政绩购买列宁遗体来建纪念馆的县长。阎连科以他书写了当代中国最荒诞的政治寓言——'受活'村全部残疾人的悲喜剧。" } ],
  "r2-ch-03": [ { name: "徐文霞", role: "主人公", description: "解放后被从旧社会'拯救'出来的妓女——在新的社会中试图重新做人、寻找爱情。陆文夫以她的故事追问了一个深刻的问题：'新中国'能否真正接纳这些'旧社会'的牺牲者？" } ],
  "r2-ch-04": [ { name: "林震", role: "主人公", description: "一个充满理想主义的年轻干部来到区委组织部——却发现'官僚主义'不是坏人的阴谋，而是一整套日常的惰性。王蒙以他的'天真的眼睛'解剖了新社会体制中最早出现的'疾病'。" } ],
  "re-jp-01": [ { name: "猫（无名）", role: "叙述者/主人公", description: "一只没有名字的猫，以冷眼旁观明治时代知识分子——苦沙弥先生、美学家迷亭、理学士寒月——的全部荒诞和自恋。漱石以猫的视角将日本知识界的'现代病'进行了最温柔的解剖。" } ],
  "re-jp-02": [ { name: "画家", role: "主人公", description: "一个隐居山中的年轻艺术家，以'非人情'的态度——将世界作为艺术品来观看——试图超越人间的痛苦与执念。漱石以他写了日本文学中关于'艺术'与'生活'之关系最深刻的小说。" } ],
  "re-jp-03": [ { name: "坊っちゃん", role: "主人公", description: "一个江户（东京）出身的直性子青年，到四国松山当中学教师——他的'江户气'与'乡下'的一切发生了连续不断的喜剧冲突。漱石以他写出了一部最可爱的'教育小说'。" } ],
  "re-jp-04": [ { name: "春琴", role: "主人公", description: "大阪药商家的盲女琴师——美丽、高傲、残酷——与她的仆人兼情人佐助之间构成了一段关于施虐、受虐与极致之美的'变态'关系。谷崎以她追问了美与残酷的边界。" } ],
  "re-jp-05": [ { name: "新治", role: "主人公", description: "伊势湾歌岛上的年轻渔夫——强壮、单纯、沉默——与富家女初江的爱情在风暴和谣言中生长。三岛以这部'牧歌式'的小说展现了日本传统美学的最后也最纯净的变奏。" } ],
  "re-jp-08": [ { name: "家将", role: "《罗生门》主人公", description: "京都罗城门下避雨的家将——在'饿死还是做贼'之间——迈出了走向黑暗的一步。芥川以他的瞬间道德崩溃解剖了人性最脆弱的边界。" } ],
  "re-jp-09": [ { name: "岛村", role: "（参见 snow-country）" , description: "" } ],
  "re-jp-10": [ { name: "菊治", role: "主人公", description: "被父亲的情人太田夫人引向了一段跨越两代的'不伦'之恋——在茶道之美的掩盖下是混乱的欲望。川端以千羽鹤的洁白对比了人类最黑暗的'情'。" } ],
  "r2-jp-01": [ { name: "女生", role: "叙述者", description: "一个东京女学生以日记体的内心独白记录了从早晨起床到入睡的一天的全部意识波动。太宰治以女性的声音捕捉了青春期的全部敏感、羞耻和自我厌恶。" } ],
  "r2-jp-02": [ { name: "阿铃婆", role: "主人公", description: "在贫困的山村中，七十岁的老人被儿子背着去楢山——按习俗应该被遗弃在山中等死。深泽七郎以她的沉默和接受追问了一个文明无法回答的问题：生存与尊严如何两全？" } ],
  "r2-jp-03": [ { name: "月岛", role: "主人公", description: "一个中年独身女性在居酒屋与退休的高中国语老师重逢——开始了以酒、文学和沉默的陪伴构成的一段微妙'黄昏恋'。川上弘美以极其内敛的笔触写出了中年之爱的温柔。" } ],
  "re-in-02": [ { name: "比马拉", role: "主人公", description: "一个接受了西方教育的孟加拉地主，在爱国'运动'与个人良知之间的冲突中挣扎。泰戈尔以他和妻子（她是传统、隐秘的虔信者）的张力追问了印度现代性中最深刻的矛盾。" } ],
  "re-in-03": [ { name: "拉朱", role: "主人公", description: "（参见 bk-in-005）" } ],
  "r2-in-01": [ { name: "乌米拉", role: "主人公", description: "德赛笔下在德里的家庭生活中逐渐窒息的印度中产阶级女性——她以沉默和最终的出走抗议了被定义的角色。德赛是印度女性文学的开拓者。" } ],
  "r2-in-02": [ { name: "赛伊", role: "主人公", description: "殖民时期法官的孙女——在后殖民印度的喜马拉雅山区中经历了爱情、民族冲突和'正义'的全部歧义。德赛以她的'继承失落'追问了全球化时代中民族的、阶级的、私人的所有伤痛。" } ],
  "re-kr-01": [ { name: "叙述者", role: "主人公", description: "李箱以第一人称碎片化地呈现了一个知识分子在殖民时代朝鲜的精神崩溃——'翅膀'是他渴望却不能飞翔的隐喻。李箱是韩国现代主义文学的开路先锋。" } ],
  "re-kr-02": [ { name: "客主", role: "主人公", description: "朝鲜时代末期在市场间流动的'行商'——黄皙暎以他的命运书写了韩国现代化过程中被碾碎的底层生活。" } ],
  "re-kr-03": [ { name: "东浩", role: "主人公", description: "1980年光州事件的少年受害者——韩江以他的死亡和生者的记忆追问了韩国民主化运动中最深的创伤。《少年来了》是献给所有'不在场'的死者的悼词。" } ],
  "r2-kr-01": [ { name: "金裕贞", role: "作者", description: "韩国殖民时代的短篇小说作家，以乡土语言和幽默书写了朝鲜农村的贫穷与人性——'金裕贞式幽默'是韩国现代文学最独特的声音之一。" } ],
  "re-ir-02": [ { name: "扎里", role: "主人公", description: "设拉子的地主夫人——在二战占领时期的伊朗，她以韧性守护了家庭和'萨维松'（春天的仪式），成为了波斯文学中女性力量的象征。达内什瓦尔是伊朗第一位出版小说的女性。" } ],
  "re-sea-01": [ { name: "明克", role: "（参见 bk-sea-002）" , description: "" } ],
  "re-sea-02": [ { name: "阿宣", role: "主人公", description: "越南战争中的一个南方士兵——阮玉四以他的视角呈现了战争的荒诞和普通人在意识形态夹缝中的困境。" } ],
  "re-uk-01": [ { name: "克拉丽莎·达洛维", role: "（参见 mrs-dalloway）" , description: "" } ],
  "re-uk-04": [ { name: "马洛", role: "（参见 heart-of-darkness）" , description: "" } ],
  "re-uk-05": [ { name: "玛格丽特·施莱格尔", role: "主人公", description: "一个热爱艺术与思想的英国中产阶级女性——试图以'联结'（只有联结！）对抗爱德华时代英国的阶级分裂。福斯特以她追问了：谁有权利继承英格兰？" } ],
  "re-uk-06": [ { name: "亨利·佩罗恩", role: "主人公", description: "一个神经外科医生在2003年2月15日伦敦反战游行的一天中经历了从撞车到亲人团聚的全部'新千年焦虑'。麦克尤恩以'现代主义的一天'致敬了《达洛维夫人》。" } ],
  "re-uk-07": [ { name: "尼古拉斯·厄夫", role: "主人公", description: "一个英国青年在希腊小岛上被一个神秘的百万富翁引入了'上帝的骗局'——一连串的心理游戏模糊了现实与幻觉的全部边界。福尔斯以他追问了：如果上帝是一个艺术家，他是否是一位虐待狂？" } ],
  "re-fr-02": [ { name: "陈", role: "主人公", description: "1927年上海工人起义中的革命者——马尔罗以他的行动和牺牲追问了革命的意义：是为了'人'还是为了'人类'？在历史的暴力中个人尊严是否可能？" } ],
  "re-de-03": [ { name: "奥斯卡·马策拉特", role: "（参见 the-tin-drum）" , description: "" } ],
  "r2-pr-04": [ { name: "君特·格拉斯", role: "诗人", description: "诺贝尔奖得主晚年的诗作——以'十一月'的意象书写了德国统一后的幻灭与记忆。格拉斯以诗歌继续着他毕生的使命：用语言对抗遗忘。" } ],
  "r2-ru-01": [ { name: "柳波芙·拉涅夫斯卡娅", role: "（参见 cherry-orchard）" , description: "" } ],
  "re-it-02": [ { name: "卡洛·列维", role: "作者/叙述者", description: "一个被法西斯流放到意大利南部卢卡尼亚的画家兼作家——他在这个'基督也没到过'的荒凉山区发现了另一种文明的深层人性。他的'流放'变成了一次'人类学'的发现之旅。" } ],
  "r2-eu-04": [ { name: "威廉修士", role: "（参见 the-name-of-the-rose）" , description: "" } ],
  "r2-eu-05": [ { name: "大卫·马丁", role: "主人公", description: "在战后的巴塞罗那，一个年轻的作家被一个神秘出版人引入了一本'诅咒之书'的谜团中。萨丰以他的追寻将哥特小说、政治记忆与文学之爱融合为一部献给书的'爱情告白'。" } ],
  "r2-eu-06": [ { name: "彼得·范登贝尔赫", role: "作者", description: "荷兰作家，以凡·艾克兄弟的《根特祭坛画》为核心展开了一部关于艺术、信仰与历史的'画作传记'。" } ],
  "r2-pr-07": [ { name: "六个角色", role: "戏中戏剧角色", description: "皮兰德娄最著名的元戏剧——六个被'作者'遗弃的角色闯入排练中的剧团，要求演员完成他们的故事。'现实'与'表象'的界限在此被彻底打破。" } ],
  "re-nb-02": [ { name: "T.S. 艾略特", role: "诗人", description: "在二战期间写下的四首长诗——'空气、土、水、火'四种元素分别对应四个'四重奏'。艾略特以它们追问了时间、永恒与言语的可能性——'在我的开始是我的结束。'" } ],
  "re-nb-03": [ { name: "拉尔夫", role: "（参见 lord-of-the-flies）" , description: "" } ],
  "re-nb-05": [ { name: "斯梅尔斯一家", role: "主人公", description: "南非种族隔离崩溃后的'镜像'小说——白人家庭在黑人仆人的村庄中寻求庇护。戈迪默以最不舒适的追问逼问了南非白人在'新南非'中的位置。" } ],
  "re-nb-06": [ { name: "泰伦家族", role: "核心群体", description: "奥尼尔的自传体戏剧——以一天一夜浓缩了一个美国家庭的全部黑暗：吗啡成瘾的母亲、吝啬的父亲、酗酒的哥哥和患肺结核的弟弟——'长日入夜'是全部美国戏剧中最令人心碎的夜晚。" } ],
  "re-nb-07": [ { name: "克拉拉", role: "（参见 house-of-spirits）" , description: "" } ],
  "re-am-01": [ { name: "亨利·大卫·梭罗", role: "作者/叙述者", description: "在马萨诸塞州瓦尔登湖畔的木屋中独自生活了两年两个月——以'简朴'为实验、以'自然'为导师。梭罗以他证明了'隐居'不是逃避社会——而是为了更有力量地批评社会。" } ],
  "re-am-02": [ { name: "艾斯佩兰萨·科尔德罗", role: "主人公/叙述者", description: "芝加哥拉美裔社区的一个女孩——她发誓要有一栋'自己的房子'——不是芒果街上的小屋，而是一个她可以写作的房间。西斯内罗丝以她的'片段叙事'创造了美国奇卡诺文学最纯真的声音。" } ],
  "re-am-03": [ { name: "阿曼达·温菲尔德", role: "母亲", description: "被丈夫抛弃的'南方美女'——在圣路易斯的贫民公寓中以'绅士来访者'的幻想维系着自己的尊严。田纳西·威廉斯以她和他笔下的'玻璃动物园'追问了美国南方梦想的全部脆弱性。" } ],
  "re-am-04": [ { name: "布兰奇·杜波依斯", role: "主人公", description: "一个从衰败的南方贵族庄园来到新奥尔良贫民区的'优雅'女性——她总是依赖陌生人的善意。布兰奇的崩溃是美国戏剧史上最令人心碎的'心灵死亡'——她与现实之间的战争以现实的完胜告终。" } ],
  "re-am-06": [ { name: "杰伊·盖茨比", role: "（参见 great-gatsby）" , description: "" } ],
  "re-am-07": [ { name: "汤姆·乔德", role: "主人公", description: "俄克拉何马州的佃农，在大萧条的'尘埃碗'中被逐出土地——开着卡车带着全家去加利福尼亚寻找'应许之地'。斯坦贝克以他的旅程写出了美国文学中最愤怒也最温暖的'愤怒'。" } ],
  "re-am-08": [ { name: "杰克·巴恩斯", role: "主人公/叙述者", description: "一战中受伤的退伍军人——在巴黎和西班牙的酒吧中与一群'迷惘的一代'一起饮酒、看斗牛、逃避伤痛。海明威以他的'冰山'叙事——八分之七在水下——写出了现代主义最冷静也最炙热的声音。" } ],
  "r2-pr-01": [ { name: "安东尼娅·希默达", role: "主人公", description: "波希米亚移民的女儿——在内布拉斯加州的大草原上以她的坚强和生命力成为了一个'神话式'的女性。凯瑟以安东尼娅书写了美国西部最纯粹的史诗——土地与人之间的'婚姻'。" } ],
  "r2-pr-09": [ { name: "老妇", role: "叙述者", description: "舍伍德·安德森以一个小镇的视角记录了美国普通人的'畸零'生活——《林中之死》是《小城畸人》作者晚期最凝练的短篇小说集。" } ],
  "re-af-01": [ { name: "埃泽乌鲁", role: "（参见 arrow-of-god）" , description: "" } ],
  "re-af-02": [ { name: "恩古吉", role: "作者/思想者", description: "以散文和回忆录记录了肯尼亚后殖民时代的语言之争——用英语还是基库尤语写作？恩古吉以自己放弃英语改用母语写作的决断成为了非洲'语言去殖民化'最激进的倡导者。" } ],
  "re-af-03": [ { name: "叙述者", role: "主人公", description: "索马里作家努鲁丁·法拉赫的小说——以该国持续的战争和流散为背景，追问了'家园'对于一个索马里流亡者意味着什么。" } ],
  "re-af-05": [ { name: "达琳", role: "主人公", description: "一个津巴布韦女孩在祖国的崩溃和移民美国的'新名字'之间迷失。布拉瓦约以她的声音——幽默而悲伤——书写了全球化时代中所有'流离失所'的孩子的故事。" } ],
  "re-la-01": [ { name: "无名镇长", role: "核心人物", description: "马尔克斯早期作品——一个哥伦比亚小镇被'匿名信'的传播所撕裂，每个人都被拉入了集体的恐惧和猜疑。'恶时辰'不是某一个人的作恶——而是'谣言'作为一种社会力量的恶。" } ],
  "re-la-03": [ { name: "胡安·普雷西亚多", role: "《佩德罗·巴拉莫》主人公", description: "（参见 pedro-paramo）" } ],
  "re-la-04": [ { name: "阿尔特米奥·克罗斯", role: "（参见 death-of-artemio-cruz）" , description: "" } ],
  "r2-la-01": [ { name: "美洲豹", role: "关键人物", description: "利马军事学校中最暴烈的学生——在暴力和恐惧中建立了自己的'秩序'。略萨以他和他的'狗'们解剖了拉丁美洲独裁主义的微观起源——军校就是整个社会的'培养皿'。" } ],
  "r2-la-02": [ { name: "伊雷内", role: "主人公", description: "一个记者在智利独裁统治下调查一桩失踪案——与失踪者的恋人（一个女摄影师）一起——在恐惧中发现了爱情。阿连德以她书写了最黑暗的政治恐怖中的人性光芒。" } ],
  "re-es-01": [ { name: "何塞·阿尔卡蒂奥·布恩迪亚", role: "（参见 hundred-years-solitude）" , description: "" } ],
  "re-ca-01": [ { name: "爱丽丝·查斯", role: "（参见 the-blind-assassin）" , description: "" } ],
  "re-ca-02": [ { name: "艾尔马西伯爵", role: "（参见 the-english-patient）" , description: "" } ],
  "re-oc-01": [ { name: "奥斯卡·辛德勒", role: "主人公", description: "一个德国纳粹党商人在克拉科夫以'工厂'为掩护救下了一千一百个犹太人的性命。基尼利以'纪实小说'的笔法还原了'辛德勒的方舟'——一个投机商人如何变成了'义人'。" } ],
  "re-oc-02": [ { name: "拉姆齐夫人", role: "（参见 to-the-lighthouse）" , description: "" } ],
  "re-am-05": [ { name: "斯蒂芬·迪达勒斯", role: "（参见 a-portrait-of-the-artist）" , description: "" } ],

  // ================================================================
  // 扩充库 — expansion-1000.ts (exp-* / x3-* / x4-* / x5-*) 全部作品角色
  // ================================================================

  // --- 非洲 ---
  "exp-af-001": [ { name: "阿扎罗", role: "（参见 bk-af-001）" , description: "" } ],
  "exp-af-002": [ { name: "奥兰纳", role: "（参见 bk-af-005）" , description: "" } ],
  "exp-af-003": [ { name: "行政官", role: "（参见 bk-af-004）" , description: "" } ],
  "exp-af-004": [ { name: "柯伦太太", role: "主人公", description: "在种族隔离的南非，一个被诊断为癌症的退休教授给她疏远的女儿写了一封长信——库切以她的临终叙事审视了南非的全部道德破产。" } ],
  "exp-af-005": [ { name: "达琳", role: "（参见 re-af-05）" , description: "" } ],
  "x3-af-001": [ { name: "沃莱·索因卡", role: "（参见 bk-af-002）" , description: "" } ],
  "x3-af-002": [ { name: "W.E.B. 杜波依斯", role: "作者/思想者", description: "美国黑人知识分子的奠基者——以'双重意识'（同时是黑人和美国人）的洞察开启了一整个世纪的非裔美国人思想。'二十世纪的问题就是肤色界限的问题。'" } ],
  "x3-af-003": [ { name: "三毛", role: "（参见 bk-af-003）" , description: "" } ],
  "x3-af-004": [ { name: "希沙姆·马塔尔", role: "（参见 bk-af-006）" , description: "" } ],
  "x3-pr-013": [ { name: "戴维·卢里", role: "主人公", description: "开普敦大学的白人教授，因与一名女学生的'丑闻'被迫辞职。在后种族隔离时代的南非，他与女儿露西在乡村遭遇了暴力的'清算'。库切以他的'耻'追问了南非白人在新南非中最不舒适的位置。" } ],
  "x4-af-001": [ { name: "埃莱辛", role: "（参见 death-and-kings-horseman）" , description: "" } ],
  "x4-af-002": [ { name: "瓦伊阿基", role: "主人公", description: "被传教士教育出来的肯尼亚青年，在两个村庄——一个皈依了基督教、一个坚守传统——之间被撕裂。恩古吉以他的'河'拆解了殖民主义对非洲社会最深刻的破坏。" } ],
  "x4-af-003": [ { name: "穆尼拉", role: "关键人物", description: "四个以不同方式被独立后的肯尼亚社会所背叛的人——恩古吉以他们的命运追问了：'独立'之后的新殖民主义与旧殖民主义有何不同？" } ],
  "x4-af-004": [ { name: "史蒂芬·库马洛", role: "主人公", description: "一个祖鲁牧师从乡村来到约翰内斯堡寻找失踪的儿子——帕顿以他的目光看见了种族隔离制度下南非的全部伤痛。这是一部以'爱'来对抗'恐惧'的小说。" } ],
  "x4-af-005": [ { name: "斯梅尔斯一家", role: "（参见 re-nb-05）" , description: "" } ],
  "x4-af-006": [ { name: "恰卡", role: "（参见 chaka）" , description: "" } ],
  "x5-af-001": [ { name: "埃格博", role: "核心人物", description: "拉各斯的青年知识分子群体——索因卡以他们五人之间的友谊与冲突绘制了独立后尼日利亚知识界的全部精神地图。" } ],
  "x5-af-002": [ { name: "艾哈迈德·阿卜杜勒·贾瓦德", role: "（参见 cairo-trilogy）" , description: "" } ],
  "x5-af-003": [ { name: "卡马拉·莱伊", role: "作者/叙述者", description: "以童年回忆录的形式记录了法属几内亚乡村中一个铁匠家庭的男孩如何在传统与殖民现代性之间成长——这是非洲童年文学最美的作品之一。" } ],
  "x5-af-004": [ { name: "法马", role: "主人公", description: "一个前殖民地酋长的后裔，在独立后的象牙海岸以'伪通灵者'为业。库鲁马以他的荒诞旅程创造了非洲文学中最独特的'图景'——以马林凯式法语重写了非洲独立后的全部幻灭。" } ],
  "x5-af-005": [ { name: "玛格丽特", role: "主人公", description: "一个在博茨瓦纳的'流亡'的南非混血女性——以她的画笔和沉默对抗了一个将种族歧视内化为'常识'的村庄。海德是非洲女性文学中被忽视的先驱。" } ],

  // --- 中国 ---
  "exp-ch-001": [ { name: "干宝", role: "作者/编纂者", description: "东晋史官，以'发明神道之不诬'为信念编纂了中国最早的神怪小说集。从鬼魂到狐仙、从预知梦到还阳——《搜神记》为后世所有中国志怪文学提供了母题库。" } ],
  "exp-ch-002": [ { name: "张华", role: "作者", description: "西晋博物学家，以《博物志》记载了当时所知的地理、生物、异闻和神话——是中国'博物学'传统的开山之作。" } ],
  "exp-ch-003": [ { name: "郭茂倩", role: "编纂者", description: "宋代学者编选的《乐府诗集》收录了从汉魏到唐代的乐府民歌——包括《孔雀东南飞》与《木兰诗》。这部书是中国叙事诗传统最完整的档案。" } ],
  "exp-ch-004": [ { name: "温庭筠", role: "代表诗人", description: "《花间集》是晚唐五代词的总集——温庭筠是其中最绮丽的声音。'梳洗罢，独倚望江楼'——花间词派将词的美学推向了极致的华丽与幽深。" } ],
  "exp-ch-005": [ { name: "纪昀（纪晓岚）", role: "作者", description: "清代最大的学者——《四库全书》总编纂官——晚年以《阅微草堂笔记》记录了数百则关于鬼狐、奇闻与人性的笔记。'阅微'——在最微小的故事中发现最深刻的道理。" } ],
  "exp-ch-006": [ { name: "沈复", role: "作者/叙述者", description: "以《浮生六记》记录了与妻子陈芸的日常——种花、喝茶、游山——在太平盛世的表象之下是最深沉的人间真情。林语堂说陈芸是中国文学中最可爱的女性。" } ],
  "exp-ch-007": [ { name: "老残", role: "（参见 lao-can-you-ji）" , description: "" } ],
  "exp-ch-008": [ { name: "顾曼桢", role: "主人公", description: "与沈世钧在上海的弄堂中相识、相恋——然后在命运的拨弄下被迫分离十四年。张爱玲以她写出了最令人扼腕的'错过'——'半生缘'，但那一半已经足够改变一生。" } ],
  "exp-ch-009": [ { name: "苏青", role: "作者/叙述者", description: "以自传体记录了民国时期一个离婚女性在上海独自谋生的经历——她的坦率至今令读者惊讶。苏青与张爱玲齐名，她的声音代表了1940年代中国女性最诚实的自我表达。" } ],
  "exp-ch-010": [ { name: "杨绛", role: "作者/叙述者", description: "以最平和的语调记录了文革期间被下放'干校'的经历——她是钱锺书的夫人——她在最屈辱的环境中保持了最优雅的尊严。'六记'是中国当代文学中最克制的'伤痕'。" } ],
  "exp-ch-011": [ { name: "杨绛", role: "作者", description: "以'洗澡'（思想改造运动中的知识分子'自我批判'）为切入口，杨绛以智者的幽默审视了一代知识分子的精神荒诞剧。" } ],
  "exp-ch-012": [ { name: "九月", role: "核心人物", description: "张炜以'九月'——一个理想主义者的名字——在当代中国农村的变迁中追问了：'大地'消失之后，人还能在哪里安放自己的灵魂？" } ],
  "exp-ch-013": [ { name: "白嘉轩", role: "主人公", description: "白鹿原上的族长，在二十世纪中国最动荡的半个世纪中坚守着'仁义'的传统信仰。陈忠实以他书写了一部关于民族脊梁的史诗。" } ],
  "exp-ch-014": [ { name: "白雪", role: "核心人物", description: "贾平凹以'秦腔'——中国最古老的地方戏曲——的衰落，作为整个中国农村文明消亡的影像。白雪是一个秦腔演员——也是即将消失的'声音'的最后载体。" } ],
  "exp-ch-015": [ { name: "叙述者", role: "主人公", description: "迟子建以一位九十岁的鄂温克老妇人的声音，回溯了额尔古纳河右岸的驯鹿民族在二十世纪中失去森林和传统的全部故事——一部中国式的《百年孤独》。" } ],
  "x3-ch-001": [ { name: "鲁迅", role: "编纂者", description: "鲁迅校录的《唐宋传奇集》收集了中国最精美的文言短篇小说——从《柳毅传》到《霍小玉传》——为中国小说史的'自觉'时代立传。" } ],
  "x3-ch-002": [ { name: "窦娥", role: "（参见 bk-ch-005）" , description: "" } ],
  "x3-ch-003": [ { name: "黄仁宇", role: "作者", description: "以'大历史'的视野聚焦于万历十五年——一个'无事发生'的年份——揭示了明朝乃至整个中华帝国体系运转的深层逻辑。这是中国历史书写最畅销也最具争议的经典。" } ],
  "x3-ch-004": [ { name: "史铁生", role: "作者/思想者", description: "在轮椅上的作家——以对生命、残疾与信仰的沉思成为了当代中国最受敬重的思想者之一。'职业是生病，业余在写作'——他以最诚实的态度面对了人类最根本的困境。" } ],
  "x3-ch-005": [ { name: "许三观", role: "主人公", description: "一个丝厂工人在三十年间以'卖血'的方式一次次将家庭从灾难中拯救出来——饥饿、疾病、政治运动。余华以最朴素的语言写出了一个底层中国人的史诗——他的血是中国半个世纪的'血史'。" } ],
  "x3-ch-006": [ { name: "眉娘", role: "核心人物", description: "莫言以1900年义和团运动为背景——'孙丙神鞭'、'檀香刑'——将酷刑'升华为'民间戏曲。眉娘是刽子手的女儿、革命者的情人——在历史的血腥中是一个温柔的声音。" } ],
  "x3-ch-007": [ { name: "阿宝", role: "主人公", description: "从1960年代到1990年代，一个上海男人在'花花世界'中的一生。金宇澄以沪语写成的《繁花》是上海这座城市最私密也最全面的文学肖像——每一个细节都在传达'上海之所以是上海'。" } ],
  "x3-ch-008": [ { name: "叶文洁", role: "关键人物", description: "文革中目睹父亲被批斗致死的天体物理学家，在红岸基地向宇宙发出了人类的第一声'呼叫'——'三体人'因此知道了地球的存在。刘慈欣以她启动了一个跨越四百年的宇宙史诗。她是拯救者还是毁灭者？" } ],
  "x4-ch-001": [ { name: "韩愈", role: "核心人物", description: "唐宋八大家之首——以'文以载道'的古文运动改变了中国散文的方向。茅坤编纂的《唐宋八大家文钞》是中国散文传统最核心的'正典'。" } ],
  "x4-ch-002": [ { name: "洪应明", role: "作者", description: "明代隐士以《菜根谭》将儒家、道家与禅宗的智慧浓缩为格言——'咬得菜根，百事可做'——每一则都是对中国人精神世界的一次便携式沉思。" } ],
  "x4-ch-003": [ { name: "张潮", role: "作者", description: "清代文人的'清言'小品——在'幽梦影'中他以诗意的断片沉思了人生、艺术、读书与自然之美。每一段都是一幅可以挂在墙上的水墨画。" } ],
  "x4-ch-004": [ { name: "史铁生", role: "作者", description: "（参见 x3-ch-004）" } ],
  "x4-ch-005": [ { name: "史铁生", role: "作者", description: "在地坛公园的四季中沉思生、死与信仰——这篇散文是中国当代文学中最珍贵的'灵魂自白'。'死是一件不必急于求成的事。'" } ],
  "x4-ch-006": [ { name: "隋抱朴", role: "主人公", description: "张炜以《古船》——一座小镇、三个家族、半个世纪——书写了中国乃至世界上关于'苦难'与'宽恕'的最深邃的叙事。" } ],
  "x4-ch-007": [ { name: "尤四婆", role: "核心人物", description: "阎连科以'丁庄'——一个因卖血而集体感染艾滋病的村庄——为背景，尤四婆是那些被遗忘在'发展'阴影中的中国农村最哀伤的女性形象。" } ],
  "x4-ch-008": [ { name: "杨百顺", role: "主人公", description: "刘震云以他的一生——从杨百顺到杨摩西到吴摩西——追问了一个终极命题：一个人穷尽一生只是想找到一个'能说得上话'的人——但为什么这么难？" } ],
  "x4-ch-009": [ { name: "孙光林", role: "叙述者", description: "余华以童年碎片回忆了一个被'死亡'和'冷漠'所统治的中国小镇家庭——'在细雨中呼喊'——每一个人都在各自的孤独中大喊却永远不被听见。" } ],
  "x4-ch-010": [ { name: "颂莲", role: "主人公", description: "一个上过大学的女子在嫁给陈佐千做四姨太后逐渐走向疯狂——苏童以她创造了关于中国封建家庭最黑暗的'女性地牢'寓言。" } ],
  "x5-ch-001": [ { name: "袁枚", role: "作者", description: "清代大诗人兼美食家——以《随园诗话》系统地阐发了'性灵'诗学：诗不是学问的堆砌，而是'性情'的直接流露。这部著作是中国古典诗学最活泼的遗产。" } ],
  "x5-ch-003": [ { name: "各式官员", role: "（参见 bk-ch-008）" , description: "" } ],
  "x5-ch-004": [ { name: "唐敖", role: "（参见 bk-ch-006）" , description: "" } ],
  "x5-ch-005": [ { name: "金圣叹", role: "作者/批评家", description: "中国文学史上最伟大的批评家之一——他评点《水浒传》《西厢记》等'六才子书'——以狂人的热情重新定义了'阅读'这一行为。'不亦快哉！'是他给人间的签名。" } ],
  "x5-ch-006": [ { name: "柳县长", role: "（参见 re-ch-13）" , description: "" } ],
  "x5-ch-007": [ { name: "孔明亮", role: "核心人物", description: "阎连科以'炸裂志'——一个中国村庄在三十年内'炸裂'为一座超级城市——书写了当代中国最疯狂的'发展'寓言。" } ],
  "x5-ch-008": [ { name: "葛亮", role: "作者", description: "以民国家族为背景的近年力作——在动荡中书写了中国'匠人精神'的代际传承。葛亮是当代中国文学中最优雅的声音之一。" } ],
  "x5-ch-009": [ { name: "苏童", role: "作者", description: "以三个青年和一件罪案为核心——苏童以'黄雀记'在当代中国社会的道德荒原中追问了'罪与罚'的现代版本。这部小说获得了第九届茅盾文学奖。" } ],


// ================================================================
// 补充人物数据 — 327 部作品缺失的真实角色
// 追加至 character-data.ts
// ================================================================

  // ==================== 核心库补充 ====================

  "emily-dickinson": [
    { name: "艾米莉·狄金森", role: "诗人/主体", description: "美国十九世纪最伟大的诗人之一。在阿默斯特的宅邸中隐居大半生，用一千七百多首短诗构建了一个关于死亡、永恒、自然与爱的私人宇宙。'我居住在可能里——一座比散文更美的房子。'" },
  ],
  "song-of-myself": [
    { name: "沃尔特·惠特曼", role: "诗人/叙述者", description: "'我赞美我自己，歌唱我自己'——惠特曼以这首长诗打破了英语诗歌的所有传统，将美洲大陆的全部生命力注入了自由诗行。'我'不是个人，而是民主社会中每一个人的集合。" },
  ],
  "gypsy-ballads": [
    { name: "费德里科·加西亚·洛尔迦", role: "诗人", description: "西班牙'二七一代'的灵魂。他以吉普赛世界为隐喻，将安达卢西亚的深歌、骏马与月光升华为关于死亡、欲望与命运的最纯粹的诗篇。'绿色，我多么爱你绿色。'" },
  ],
  "trilce": [
    { name: "塞萨尔·巴列霍", role: "诗人", description: "秘鲁最伟大的诗人，拉丁美洲先锋派诗歌的先驱。《Trilce》以断裂的语法和全新的词汇创造了一种'前语言'的诗——每一个词都在诗的熔炉中被重新锻造。'我想写，但出来的却是泡沫。'" },
  ],
  "labyrinths-borges": [
    { name: "博尔赫斯", role: "作者/叙述者", description: "永远在图书馆的迷宫中漫步的盲眼诗人。他以'虚构的书籍'、'无限的分岔小径'和'镜中之人'建造了一个关于时间、永恒与身份的奇幻哲学迷宫。" },
  ],
  "the-book-of-sand": [
    { name: "博尔赫斯", role: "叙述者/主人公", description: "一本没有第一页也没有最后一页的书——翻过的页码永远无法找回。博尔赫斯以这则关于'无限之书'的寓言，将读者的恐惧与迷恋一起写入了文学的边界。" },
  ],
  "blow-up-and-other-stories": [
    { name: "胡里奥·科塔萨尔", role: "作者", description: "阿根廷文学爆炸的代表人物。他以'秘密武器'和'南方高速公路'等短篇不断追问：现实的裂缝在哪里？日常生活的表象之下潜藏着什么？科塔萨尔是最会写'故事'的人。" },
  ],
  "the-book-of-disquiet": [
    { name: "贝尔纳多·索阿雷斯", role: "叙述者/半自传", description: "里斯本的一个平凡簿记员——佩索阿给他取了这个'异名'——在道拉多雷斯大街写下关于存在的散文碎片。'我什么都不是——正因如此，我是一切。'这部书的'作者'直到佩索阿死后才被整理出版。" },
  ],
  "confessions-of-zeno": [
    { name: "泽诺·科西尼", role: "主人公/叙述者", description: "一个永远在尝试戒烟却永远失败的特里雅斯特商人。他以精神分析式的自白追溯了他一生中的最后一次香烟、他的父亲、他的妻子和他的商业冒险——现代主义小说中第一个不可靠的叙述者。" },
  ],
  "solaris": [
    { name: "克里斯·凯尔文", role: "主人公", description: "一个心理学家来到绕索拉里斯星运行的太空站——索拉里斯的海洋能将人的记忆实体化。他的亡妻哈莉'复活'了——但她是真的吗？莱姆以科幻形式发出了关于人类认知极限的最深沉的追问。" },
    { name: "哈莉", role: "索拉里斯'访客'", description: "凯尔文已故妻子的复制品——由索拉里斯海洋从凯尔文的记忆中创造。她拥有哈莉的记忆和情感，但知道自己不是真正的哈莉。她的'存在'——既不是人也不是物——是全书关于意识与身份的哲学核心。" },
  ],
  "sister-carrie": [
    { name: "嘉莉妹妹", role: "主人公", description: "一个从威斯康星小镇来到芝加哥的年轻女子——在生存和欲望的驱使下一步步攀爬社会阶梯。德莱塞以自然主义笔法写出了美国梦的另一面：成功的嘉莉坐在摇椅中，依然在渴望着什么。" },
  ],
  "sons-and-lovers": [
    { name: "保罗·莫瑞尔", role: "主人公", description: "矿工之子，劳伦斯的半自传形象。他在母亲格特鲁德的精神占有与两个女人——米丽安和克拉拉——之间挣扎。俄狄浦斯情结在英语文学中最深刻的文学呈现。" },
    { name: "格特鲁德·莫瑞尔", role: "母亲", description: "一个受过教育的中产阶级女性嫁给了一个粗犷的矿工。她把全部的爱和野心都投射到儿子保罗身上——这种窒息的爱既是保罗的艺术源泉也是他情感生活的牢笼。" },
  ],
  "hunger": [
    { name: "无名叙述者", role: "主人公", description: "一个在克里斯蒂安尼亚（今奥斯陆）挨饿的年轻作家——他的饥饿既是身体的也是精神的。汉姆生以第一人称写出了意识流小说的先驱——饥饿使他的幻觉、骄傲和疯狂在街头上演。" },
  ],
  "pippi-longstocking": [
    { name: "皮皮", role: "主人公", description: "全世界最强壮也最自由的女孩——她一个人住在维拉·维洛古拉，有一匹马、一只猴子和一箱金币。林格伦以她创造了一个反对所有成人权威的儿童乌托邦——'我从来没做过，所以我肯定能做到。'" },
  ],
  "peer-gynt": [
    { name: "培尔·金特", role: "主人公", description: "挪威山村的浪子——一个说谎者、梦想家和冒险家。他诱拐新娘、闯荡世界、在沙漠称王、在疯人院遇王——易卜生以这部诗剧追问：'成为自己'真正的意思是什么？'" },
  ],
  "njalssaga": [
    { name: "尼雅尔", role: "主人公", description: "冰岛最睿智的法律家，却无法阻止自己儿子们的命运。冰岛家族传奇中最伟大的作品——尼雅尔和他的家人在烈火中死去，而复仇的循环永无止境。" },
  ],
  "la-celestina": [
    { name: "塞莱斯蒂娜", role: "主角/牵线人", description: "一个老鸨和巫婆，以撮合男女私情为生。她以超越时代的三维人格——狡猾、贪婪、脆弱——成为从'角色类型'到'人物'的关键转折点，预示了塞万提斯和莎士比亚的到来。" },
  ],
  "lazarillo-de-tormes": [
    { name: "拉萨罗", role: "主人公/叙述者", description: "一个来自萨拉曼卡的穷孩子，先后为盲丐、教士、乡绅等七位主人服务。他以'书信'形式自述一生的挣扎——欧洲文学中第一部'流浪汉小说'，从此一个社会底层的人也可以成为故事的主角。" },
  ],
  "life-is-a-dream": [
    { name: "塞希斯蒙多", role: "主人公", description: "一出生就被预言将成为暴君的波兰王子，被父王囚禁在塔中。当他终于被释放并被给予一天的时间——他发现'生命本身就是一场梦'。卡尔德隆以这则寓言将巴洛克戏剧推至哲学的最深层次。" },
  ],
  "quovadis": [
    { name: "维尼奇乌斯", role: "主人公", description: "一个罗马贵族军人，在尼禄时代的罗马爱上了基督徒少女莉吉娅。显克微支以这段跨越宗教鸿沟的爱情将古罗马帝国的堕落与早期基督徒的殉道精神书写为一部历史史诗。" },
    { name: "莉吉娅", role: "女主角", description: "一个从北欧部落来到罗马的基督徒少女——她的信仰和纯洁最终感化了维尼奇乌斯。'Quo Vadis, Domine?'——主啊，你去哪里？——彼得在逃亡的路上遇见耶稣的故事贯穿全书。" },
  ],
  "wuthering-heights-em": [
    { name: "希斯克利夫", role: "主人公", description: "被利物浦街头捡回的孤儿，在呼啸山庄成长为一场毁灭性的情感风暴。他对凯瑟琳的爱超越死亡——'我不能没有我的灵魂而活！'——但这份爱最终吞噬了两代人。" },
    { name: "凯瑟琳·恩肖", role: "女主角", description: "'我就是希斯克利夫！'她选择了嫁给埃德加·林顿，但她灵魂的每一部分都属于希斯克利夫。艾米莉·勃朗特以她创造了一个拒绝驯化的女性灵魂——既残忍又令人心碎。" },
  ],
  "for-whom-the-bell-tolls": [
    { name: "罗伯特·乔丹", role: "主人公", description: "一个美国志愿者在西班牙内战中奉命炸毁一座桥——三天三夜中他找到了与玛丽亚的爱情和死亡的意义。'不要问丧钟为谁而鸣——它就为你而鸣。'" },
    { name: "玛丽亚", role: "女主角", description: "一个被法西斯分子伤害过的西班牙少女。在乔丹生命的最后三天中，他们的爱在战争的废墟上短暂绽放——海明威以她书写了战争中人性最温柔的可能。" },
  ],
  "the-sun-also-rises": [
    { name: "杰克·巴恩斯", role: "叙述者/主人公", description: "一个在战争中丧失了性能力的美国记者，在巴黎和潘普洛纳之间徘徊，爱上了布雷特却无法拥有她。海明威以他命名了'迷惘的一代'。" },
    { name: "布雷特·阿什利", role: "女主角", description: "一个美丽、放纵而无法安定下来的英国女性——她是整个'迷惘的一代'的灵魂象征：受过伤、渴望爱、却永远在追逐下一个不可能的对象。" },
  ],
  "like-water-for-chocolate": [
    { name: "蒂塔", role: "主人公", description: "墨西哥革命时代一个被传统绑缚的少女——作为最小的女儿，她被禁止结婚以照顾母亲。她把所有的情感都注入了她所做的每一道菜——吃她玫瑰花瓣鹌鹑的人会坠入爱河——魔幻现实主义的厨房版。" },
  ],
  "the-english-patient": [
    { name: "阿尔马西伯爵", role: "'英国病人'", description: "一个全身烧伤、没有身份的人在意大利别墅中由护士汉娜照料。他在吗啡的迷蒙中回忆着北非沙漠中的禁忌之爱——'英国病人'所属的帝国和时代都已随风而去。" },
  ],
  "the-color-purple": [
    { name: "西莉", role: "主人公/叙述者", description: "一个受尽虐待的黑人女性，以写给上帝的信开始讲述自己的一生。在另一个女人——莎格——的爱中，她终于发现了自己的价值和声音。艾丽丝·沃克以书信体完成了一部从沉默到赋权的灵魂史诗。" },
  ],
  "july-people": [
    { name: "斯梅尔斯一家", role: "白人家庭", description: "在南非种族隔离制度崩溃后的内战中，一个约翰内斯堡的白人家庭被迫逃到乡下——而接纳他们的是他们家曾经的黑人佣人'七月'。戈迪默以角色的彻底反转写下了关于权力的最冷峻的寓言。" },
  ],
  "the-dark-child": [
    { name: "卡马拉·莱伊", role: "叙述者/作者", description: "一个在法属几内亚库鲁萨村长大的非洲男孩——他的自传以最温柔的记忆书写了父子之间、传统与现代之间的断裂与传承。在殖民与非殖民化之间的非洲见证。" },
  ],
  "the-river-between": [
    { name: "瓦伊亚基", role: "主人公", description: "肯尼亚基库尤族的一个年轻领袖，在两个分裂的村庄和两种信仰——基督教与传统——之间寻找第三条道路。恩古吉以他预言了一个正在消失的非洲。" },
  ],
  "petals-of-blood": [
    { name: "穆尼拉", role: "叙述者之一", description: "四个被卷入谋杀案调查的人——教师、妓女、商人和学生——各自讲述他们在后殖民肯尼亚新伊尔莫洛波的遭遇。恩古吉以'花瓣'之血——火焰般的花朵——隐喻了革命的火种。" },
  ],
  "the-interpreters": [
    { name: "埃格博", role: "核心人物之一", description: "五个从欧洲和美国留学归来的尼日利亚青年在拉各斯和伊巴丹之间对自己国家的'解读'。索因卡以这部复杂的小说质疑了后殖民非洲的精英与大众之间的断裂。" },
  ],
  "maru": [
    { name: "玛格丽特·卡德莫", role: "主人公", description: "一个马萨瓦（博茨瓦纳的'不可接触者'）女教师，来到迪莱佩村任教。她的存在在两个追求者——玛鲁和莫莱卡——之间揭开了一个关于偏见、权力和爱的种族寓言。" },
  ],
  "the-map-of-love": [
    { name: "伊莎贝尔", role: "当代叙述者", description: "一个美国籍埃及裔女性，在世纪末开罗打开了一只尘封的箱子——里面是她曾祖母安娜在1900年埃及的日记。两段跨越世纪的爱情——在埃及的古老天空下，个人与政治永远交织。" },
  ],
  "the-secret-river": [
    { name: "威廉·桑希尔", role: "主人公", description: "一个被流放到澳大利亚的伦敦船夫，试图在霍克斯伯里河畔开垦属于自己的土地。但这片'无人之地'早已属于达鲁格人——'定居'与'侵占'的界线在他心中日益崩塌。" },
  ],
  "the-rainbow-warrior": [
    { name: "彩虹勇士", role: "象征/叙述者", description: "绿色和平组织的旗舰——一艘名为'彩虹勇士'的船在奥克兰港被法国特工炸沉。这部小说以船为隐喻讲述了一群理想主义者对抗核试验的故事——关于勇气与背叛的海洋史诗。" },
  ],
  "where-we-once-belonged": [
    { name: "阿拉", role: "叙述者", description: "一个萨摩亚女性回顾在群岛上的童年——在被殖民史、传教士与全球化的浪潮中，'我们曾经属于的地方'正在消失。萨摩亚最著名的小说——太平洋岛屿女性的声音。" },
  ],
  "tales-of-the-tikongs": [
    { name: "提孔岛民们", role: "集体主人公", description: "南太平洋提孔岛上的居民——在一个'发展'计划即将吞噬他们家园的前夜，他们以反讽和幽默的智慧对抗外来专家的'援助'。一部关于太平洋岛国后殖民处境的辛辣喜剧。" },
  ],
  "the-chant-of-jimmie-blacksmith": [
    { name: "吉米·布莱克史密斯", role: "主人公", description: "一个混血（半白人半原住民）的澳大利亚青年，试图通过辛勤劳动获得白人的尊重——但被系统性地剥夺了一切后，他开始了一场血腥的复仇。基尼利以真实事件为蓝本——'当一个人被剥夺所有尊严时，暴力还是选择吗？'" },
  ],
  "the-whale-rider": [
    { name: "卡胡", role: "主人公", description: "毛利传说中'骑鲸人'的后裔——但她是个女孩，她的酋长祖父因此拒绝承认她是继承人。当鲸群搁浅时，只有卡胡回应了古老鲸鱼的呼唤。关于性别、传统与海洋之灵的经典。" },
  ],
  "the-sun-independent": [
    { name: "图普阿·塔马塞塞", role: "核心人物", description: "萨摩亚独立运动的精神领袖——他领导了'毛'运动，以非暴力抵抗对抗新西兰的殖民统治。这部小说将太平洋独立运动的历史编织为一部关于希望与牺牲的太平洋叙事。" },
  ],
  "schindlers-ark": [
    { name: "奥斯卡·辛德勒", role: "主人公", description: "一个纳粹党员、战争投机商、酒徒和赌徒——'辛德勒的名单'上的一千一百名犹太人。基尼利以小说的形式记录了这个真实故事——一个'不完美的人'如何成为了道德的英雄。" },
  ],
  "the-kingdom-of-this-world": [
    { name: "蒂·诺埃尔", role: "主人公", description: "一个海地黑奴，经历了从奴隶制到独立到新帝国统治的全部历史。卡彭铁尔以他的一生呈现了'神奇的现实'——海地的奴隶革命中，人的欲望与神的力量一同在历史的舞台上演出。" },
  ],
  "the-autumn-of-the-patriarch": [
    { name: "独裁者", role: "主人公", description: "一个统治了不知多少年、连名字都没有的独裁者——他的衰老、他的孤独、他的绝对权力。马尔克斯以一页接一页的句子洪流写下了关于权力与孤寂的最深邃的文学沉思。" },
  ],
  "the-green-house": [
    { name: "安塞尔莫", role: "核心人物", description: "一个在沙漠中建造了一座绿色妓院的神秘男人。略萨以破碎的时空和多重视角围绕'绿房子'编织了皮乌拉地区数十年的社会史。" },
  ],

  // ==================== 扩充库1000 — 亚洲 (exp-ch/jp/in/kr/tr) ====================


  "exp-jp-001": [
    { name: "山椒鱼", role: "主人公", description: "一只不断长大的山椒鱼被困在越来越狭窄的岩洞里——再也出不去了。井伏鳟二以这则短篇寓言书写了现代人被自身局限与自负所困的存在主义悲剧。" },
  ],
  "exp-jp-002": [
    { name: "田村", role: "主人公", description: "菲律宾莱特岛上一个被军队驱逐的日军肺结核士兵——在饥饿与疯狂中他最后的'任务'是杀戮。大冈升平以自身战争经历写出了一部关于'人为何变成野兽'的残酷证词。" },
  ],
  "exp-jp-003": [
    { name: "仁木顺平", role: "主人公", description: "一个昆虫采集者被困于沙丘底部的村落——被迫每天铲沙以阻止村子被沙子吞噬。安部公房以这则卡夫卡式寓言书写了存在、劳动和自由的终极悖论。" },
  ],
  "exp-jp-004": [
    { name: "蜜三郎", role: "叙述者/兄弟之一", description: "大江健三郎笔下的人物——与弟弟鹰四回到四国的故乡山谷。鹰四用暴力重演百年前的农民暴动——在一场最终悲剧的'灵魂冒险'中，两个兄弟各自面对家族的秘密。" },
  ],
  "exp-jp-005": [
    { name: "樱井美影", role: "主人公", description: "失去所有亲人后在田边家的厨房里找到了'睡觉的地方'。吉本芭娜娜以治愈系的笔触写出了一代日本年轻人在都市中寻找微小温暖的孤独与疗愈。" },
  ],
  "exp-jp-006": [
    { name: "冈田亨", role: "主人公", description: "一个失业的东京男人——妻子和猫同时失踪后，他卷入了一个横跨满洲战争记忆与东京地下暗流的奇异世界。村上春树以这部小说直面了日本在二战中的历史创伤。" },
  ],
  "exp-jp-007": [
    { name: "森口悠子", role: "叙述者/女教师", description: "在四岁女儿被班上两个学生杀害后，她在全班面前做了一次'告白'——平静而致命。凑佳苗以多重独白的形式完成了一部关于少年犯罪与成人世界的残酷拼图。" },
  ],

  "exp-in-001": [
    { name: "黑公主（Draupadi）", role: "叙述者/主人公", description: "《摩诃婆罗多》中最核心的女性——被当作骰子的赌注。在这部重述中，她终于用自己的声音讲述她从火中诞生、嫁给五兄弟、在俱卢之战中失去一切的一生。" },
  ],
  "exp-in-002": [
    { name: "孟奴", role: "主人公", description: "一个印度孤儿——从被遗弃的婴儿到殖民地社会最底层的苦力。安纳德以英语为'不可接触者'写下了第一部现代印度叙事——每一个被这个社会碾压的人都可以是文学的主角。" },
  ],
  "exp-in-003": [
    { name: "村庄", role: "叙述主体", description: "恒河边的一个小村庄——拉贾·拉奥不是线性叙述而是以印度的'往事重述'(puranic)传统，让故事如恒河的潮水般螺旋展开——哲学、神话与日常在此不可分割。" },
  ],
  "exp-in-004": [
    { name: "尼拉德·乔杜里", role: "叙述者/作者", description: "一个孟加拉知识分子以英文书写的自传——他的童年、殖民时期的教育和独立后印度的转变。他的自传是对'什么是印度人'这一问题的长篇沉思——从不回避争议。" },
  ],
  "exp-in-005": [
    { name: "乡村女性", role: "主人公", description: "一个在加尔各答这个'大城市'中迷失的孟加拉乡村女性。萨拉特·钱德拉以通俗的孟加拉语书写了殖民时期印度社会中最普通的女性——她们的渴望和被压抑的梦想。" },
  ],

  "exp-kr-001": [
    { name: "广藏市场的商人们", role: "群像主人公", description: "首尔广藏市场——韩国经济腾飞的中心舞台。崔仁浩以商贩们在大时代中的挣扎、背叛和崛起全景式地记录了韩国从贫困到崛起的产业史诗。" },
  ],
  "exp-kr-002": [
    { name: "严锡大", role: "核心人物", description: "小学班长——以暴力和恐惧统治了整个班级，直到一个转学生挑战他的'统治'。李文烈以一则关于专制与反抗的校园寓言精确地映射了韩国军事独裁时期的政治现实。" },
  ],
  "exp-kr-003": [
    { name: "妈妈（朴素女）", role: "主人公", description: "在首尔地铁站走失的妈妈——全家人第一次听到她的'声音'：丈夫、大儿子、女儿、小儿子各自在回忆中重新发现了这个一生为他们付出的女性。申京淑写给了每一位'不被看见的妈妈'。" },
  ],

  "exp-tr-001": [
    { name: "奥尔罕·帕慕克", role: "叙述者/作者", description: "在伊斯坦布尔旧城长大的男孩——他的个人记忆与博斯普鲁斯海峡上的渡轮、奥斯曼废墟和'呼愁'(hüzün)的灰色光线交织成一本关于城市的集体灵魂传记。" },
  ],
  "exp-tr-002": [
    { name: "拉伊夫", role: "主人公", description: "一个内向的土耳其青年，在1920年代的柏林爱上了一位德国女画家玛丽亚——他在一幅画中看见了她穿着毛皮大衣如圣母般的美。但这段爱情注定无法在两种文化之间存活。" },
  ],

  // ==================== 扩充库1000 — 欧洲 (exp-uk/fr/de/ru/it/es) ====================

  "exp-uk-001": [
    { name: "厄内斯特·庞蒂菲克斯", role: "主人公", description: "一个在维多利亚式虚伪家庭中长大的青年——他对自己被安排的人生——剑桥、神职、婚姻——发出了愤怒的反抗。塞缪尔·巴特勒将他的人生写成了一部'反维多利亚'的宣言。" },
  ],
  "exp-uk-002": [
    { name: "阿齐兹医生", role: "核心人物", description: "一个年轻的印度穆斯林医生，被英国当局以莫须有的罪名指控在马拉巴山洞中对阿黛拉·奎斯特德小姐不轨。他的遭遇——以及永远没有答案的山洞事件——是英印之间那不可跨越的文化鸿沟的隐喻。" },
  ],
  "exp-uk-003": [
    { name: "道尔", role: "叙述者", description: "一个美国人以不可靠的叙述讲述了两对英国夫妇在九年间的爱与背叛——他的叙述本身就充满了不自觉的矛盾。福特以这部小说证明了：所有的'故事'都是被讲述者所重构的。" },
  ],
  "exp-uk-004": [
    { name: "玛格丽特·施莱格尔", role: "主人公", description: "一位理想主义的英国中产阶级女性——她与威尔科克斯家（代表商业与实用主义）的交锋——福斯特以她追问：在一个被金钱支配的世界中，文化与善意如何生存？" },
  ],
  "exp-uk-005": [
    { name: "雅各·弗兰德斯", role: "主人公", description: "一个在一战中死去的年轻英国人——伍尔夫不直接描写他，而是通过他留在他人的记忆、他房间中的物品和他走过的街道来'拼贴'他的一生。现代主义意识流小说的第一个长篇实验。" },
  ],
  "exp-uk-006": [
    { name: "康斯坦丝（康妮）", role: "主人公", description: "查特莱爵士夫人——丈夫克利福德在战争中瘫痪后，她在猎场看守人梅勒斯那里找到了肉体与灵魂的苏醒。劳伦斯以她书写了工业社会中肉体与精神分离的悲剧。" },
  ],
  "exp-uk-007": [
    { name: "拉里·达雷尔", role: "主人公", description: "从一战归来后拒绝'正常'的职业生涯和婚姻——他前往印度寻找精神的真理。毛姆以他为徒笔——一个在现代物质主义中追寻精神生活的'圣徒'。" },
  ],
  "exp-uk-008": [
    { name: "史蒂文斯", role: "主人公/叙述者", description: "达林顿府的老管家——在一次驾车旅途中回顾了一生的'尊严'。他牺牲了自己的情感——尤其是对肯顿小姐的爱——以换取'最伟大的管家'这个虚妄的头衔。石黑一雄以他追问：'伟大的尊严'值多少？" },
  ],
  "exp-uk-009": [
    { name: "亨利·佩罗恩", role: "主人公", description: "伦敦的神经外科医生——2003年2月15日（反对伊拉克战争的大游行日）他的一天。麦克尤恩以一日的叙事将后9/11时代的个人焦虑与全球政治微缩在了一个人的意识之中。" },
  ],
  "exp-uk-010": [
    { name: "阿奇·琼斯", role: "核心人物之一", description: "一个英国人——在二战结束时决定活下来并与牙买加移民克拉拉结婚。扎迪·史密斯以他的家庭为棱镜折射出半个世纪以来伦敦从白人都城到多元文化都会的蜕变。" },
  ],

  "exp-fr-001": [
    { name: "阿道尔夫", role: "主人公", description: "一个上流社会的青年，引诱了年长于他的爱蕾诺尔——然后用温柔而残忍的方式让她明白他的爱已经消逝。一部关于情感消逝的无情解剖。" },
  ],
  "exp-fr-002": [
    { name: "冉阿让", role: "主人公", description: "（参见主条目 'les-miserables'）" },
  ],
  "exp-fr-003": [
    { name: "费迪南·巴尔达缪", role: "主人公/叙述者", description: "塞利纳的半自传形象——从一战战壕的恐惧到非洲殖民地的荒诞再到美国底特律的异化——他的'漫游'是一场闯入人类文明暗面的无情的语言爆炸。'这就是生活，它开始于哭泣，结束于呻吟。'" },
  ],
  "exp-fr-004": [
    { name: "米歇尔", role: "《背德者》主人公", description: "一个在重病后决定拥抱感官享受的古板学者——他追随欲望的召唤在北非寻找'真正的生命'——但为此毁掉了妻子的生命。纪德以此探索了欲望解放的道德代价。" },
    { name: "阿莉莎", role: "《窄门》主人公", description: "一个追求精神纯洁到极致的少女——她拒绝了尘世的爱情以换取进入天堂的'窄门'——但她的自我牺牲最终毁灭了她自己和她所爱的人。纪德以此书写了宗教狂热的悲剧。" },
  ],
  "exp-fr-005": [
    { name: "陈", role: "核心人物之一", description: "上海工人起义中的革命者。马尔罗以几个革命者的命运——各自以不同的方式面对死亡——将人的尊严置于历史必然与个人命运的碰撞之中。'人的命运'——一部法国存在主义文学的先驱之作。" },
  ],
  "exp-fr-006": [
    { name: "法国少女", role: "叙述者/主人公", description: "十五岁的她——在湄公河的渡船上，戴着男式呢帽，穿着母亲的旧连衣裙——遇见了一个中国男人。杜拉斯以最简省的语言唤回了半个世纪前在殖民地印度支那的一段禁忌之恋。'我已经老了。'" },
  ],
  "exp-fr-007": [
    { name: "居伊·罗朗", role: "主人公/叙述者", description: "一个失去了记忆的私人侦探——他也在追寻自己的过去。巴黎的每一条街道、每一个名字都可能是线索。莫迪亚诺以冷峻的笔触将身份之谜、被占巴黎的暗影与'我是谁'的追问编织为一部存在主义侦探小说。" },
  ],
  "exp-fr-008": [
    { name: "史密斯先生与夫人", role: "人物", description: "两个正在客厅中进行一场毫无意义的对话的英国中产夫妇——语言在他们嘴里不再传达任何信息，而只是社交的'仪式'。尤内斯库以他们宣告了'荒诞派戏剧'的诞生。" },
  ],

  "exp-de-001": [
    { name: "痴儿西木", role: "主人公", description: "三十年战争中一个淳朴的农家少年——他在战火、欺骗和荒诞的历险中艰难地守护着人性。格里美尔斯豪森以他创造了德国文学中第一个'反英雄'——也是一部关于战争的最全面的史诗。" },
  ],
  "exp-de-002": [
    { name: "艾菲·布里斯特", role: "主人公", description: "十七岁嫁给年长一倍的男爵——七年后一段早年的'暧昧'被发现，她的婚姻和生活随之崩塌。冯塔纳以最冷静的叙事拷问了普鲁士社会的冷酷道德——'艾菲，这没有什么。'" },
  ],
  "exp-de-003": [
    { name: "弗朗茨·比伯科普夫", role: "主人公", description: "一个从监狱出来的杀人犯——决心做一个'正派人'——但魏玛时代的柏林是一台吞噬灵魂的机器。德布林以蒙太奇和大都市交响乐般的叙事创造了德国版的《尤利西斯》。" },
  ],
  "exp-de-004": [
    { name: "阿申巴赫", role: "主人公", description: "一个以自律和秩序著称的德国老作家——在威尼斯爱上了美少年塔齐奥——当霍乱蔓延全城时他拒绝离开，死在丽都海滩的躺椅上。'死于威尼斯'——托马斯·曼以古典的庄严捍卫了美、欲望与死亡。" },
  ],
  "exp-de-005": [
    { name: "让-巴蒂斯特·格雷诺耶", role: "主人公", description: "十八世纪巴黎最臭的鱼市上出生的弃婴——拥有能分辨世间一切气味的绝世嗅觉，但自己却没有任何气味。他为制造让人'爱他'的终极香水而走上了连环杀手的道路——聚斯金德以这则黑暗寓言创造了现代德国文学最成功的国际畅销书。" },
  ],

  "exp-ru-001": [
    { name: "叶甫盖尼·奥涅金", role: "主人公", description: "俄国文学中第一个'多余的人'——一个厌倦了上流社会的贵族青年。他拒绝了塔季扬娜的纯真爱情，在决斗中杀死了好友连斯基——永远无法在这个世界上找到自己的位置。" },
    { name: "塔季扬娜", role: "女主角", description: "乡间长大的少女，在奥涅金面前第一次袒露了自己的爱——被拒绝。多年后她成为将军夫人——当奥涅金反过来追求她时，她拒绝了。普希金以她创造了俄国文学中最受尊敬的女性形象。" },
  ],
  "exp-ru-002": [
    { name: "毕巧林", role: "主人公", description: "'多余的人'谱系中最冷酷也最令人无法抗拒的人物——一个在高加索服役的军官。莱蒙托夫以多重叙事视角构建了他——你会厌恶他，但你无法不怜悯他。" },
  ],
  "exp-ru-003": [
    { name: "乞乞科夫", role: "主人公", description: "一个谜一般的绅士坐着马车在俄罗斯大地上购买'死魂灵'——已去世但尚未从纳税名册上注销的农奴。果戈理以这部未完成的史诗将俄国社会中最卑劣也最可笑的一面——贪婪——写成了文学。" },
  ],
  "exp-ru-004": [
    { name: "巴扎罗夫", role: "主人公", description: "'虚无主义者'的原型——一个学医的年轻人，不相信一切传统和权威。屠格涅夫以他命名了一个时代的精神——并预言了俄国革命的到来——但他也为这个'虚无者'的死写下了最忧伤的挽歌。" },
  ],
  "exp-ru-005": [
    { name: "梅什金公爵", role: "主人公", description: "一个像基督一样'完全美好的人'——从瑞士疗养院回到彼得堡上流社会。他的善良、纯真和同情心在这个世界中被利用、嘲笑、最终被摧毁——'善良在世界上可能吗？'" },
  ],
  "exp-ru-006": [
    { name: "斯塔夫罗金", role: "核心人物", description: "一个以真实的政治谋杀案（涅恰耶夫事件）为素材——陀思妥耶夫斯基以这部'政治预言'小说解剖了虚无主义的逻辑终点：当上帝不存在，一切都允许——魔鬼就进入了人的灵魂。" },
  ],
  "exp-ru-007": [
    { name: "彼拉盖雅·尼洛夫娜", role: "主人公", description: "一个普通的、不识字的俄国母亲——在儿子投身革命的过程中她从恐惧、担忧到最终觉醒并接过儿子的事业。高尔基以她创造了'社会主义现实主义'的第一个不朽形象。" },
  ],
  "exp-ru-008": [
    { name: "尤里·日瓦戈", role: "主人公", description: "一个诗人医生——在革命与内战的洪流中试图守护个人的尊严与爱。帕斯捷尔纳克以他的一生写出了一部关于个体在历史中是否可能保持完整的壮丽追问。" },
    { name: "拉拉", role: "女主角", description: "日瓦戈生命中的两个女性之一——她是他的诗歌的缪斯，也是他在历史的冰雪中唯一的光。她与日瓦戈在荒废的瓦雷金诺庄园中的最后时光是整个俄国文学中最令人心碎的爱情场景之一。" },
  ],
  "exp-ru-009": [
    { name: "叶季盖", role: "主人公", description: "中亚草原上一个铁路小站的工人——在为老友送葬的一天中，他在传统与现代、民间传说与科幻未来的边界上行走。艾特玛托夫将中亚的'曼库特'传说与宇宙探索融合。" },
  ],
  "exp-ru-010": [
    { name: "伊万·杰尼索维奇·舒霍夫", role: "主人公", description: "斯大林劳改营中的一名囚犯——编号Shch-854。索尔仁尼琴以他在营中'平常的一天'——从起床到晚点名——打开了一座巨大的冰山：下面是整个古拉格群岛。" },
  ],
  "exp-ru-011": [
    { name: "沃兰德", role: "魔鬼/核心人物", description: "带着随从来到苏维埃的莫斯科——以黑魔术、冷笑话和致命的游戏揭开了这个'无神论'社会的伪善。布尔加科夫以他创造了二十世纪最迷人的文学魔鬼。" },
    { name: "大师", role: "小说中的小说作者", description: "一个因写作关于本丢·彼拉多的小说而被苏联文学界摧毁的作家——他在疯人院中得到了玛格丽特的拯救。布尔加科夫以他为自画像——'手稿是烧不掉的。'" },
    { name: "玛格丽特", role: "女主角", description: "为了拯救大师，她答应成为沃兰德盛大舞会的女主人——赤身裸体迎接来自地狱的宾客。她也为了爱接受了魔鬼的诱惑——她与大师的最终安宁是二十世纪文学中最动人的'拯救'。" },
  ],

  "exp-it-001": [
    { name: "亚历山德罗·曼佐尼", role: "诗人", description: "意大利统一运动时期的文学巨匠。《君士坦丁堡的陷落》是他早期宗教颂歌——在民族意识觉醒的时代，他的诗歌唤起了意大利人对民族共同体的想象。" },
  ],
  "exp-it-002": [
    { name: "法布里齐奥·萨利纳亲王", role: "主人公", description: "西西里贵族——当加里波第的红衫军登陆时，他知道旧世界正在消逝。'如果我们希望一切保持原样，就必须改变一切'——他以贵族最后的优雅接受了衰败的必然。" },
  ],
  "exp-it-003": [
    { name: "阿吉鲁尔福爵士", role: "主人公", description: "查理曼大帝麾下最完美的骑士——白色的盔甲下空无一物。他没有身体却有着最坚定的意志。卡尔维诺以他追问了一个终极问题：'存在'需要身体吗？" },
  ],

  "exp-es-001": [
    { name: "羊泉村村民", role: "集体主人公", description: "被领主费尔南·戈麦斯暴虐统治的村民——当他们被问到'是谁杀了骑士团长？'时，全村人齐声回答：'是羊泉村！'洛佩·德·维加以一个真实的农民起义写出了关于集体正义的不朽宣言。" },
  ],
  "exp-es-002": [
    { name: "巴尔塔萨尔", role: "主人公", description: "一个在战争中失去了左手的士兵——外号'七太阳'——他遇见了能看到意志的少女布里蒙达。萨拉马戈以他们之间超越肉体的爱为十八世纪葡萄牙建造了一座魔幻的文学大教堂。" },
  ],
  "exp-es-003": [
    { name: "希拉·基罗加", role: "主人公", description: "一个西班牙女裁缝——在二战期间从马德里到丹吉尔再到里斯本，她从裁缝变成了间谍。杜埃尼亚斯以她书写了一部关于女性力量与历史冒险的现代经典。" },
  ],

  // ==================== 扩充库1000 — 美洲 (exp-am/la/ca) ====================

  "exp-am-001": [
    { name: "海丝特·白兰", role: "主人公", description: "清教徒波士顿的通奸者——胸前被迫永远佩戴红色的'A'字。她拒绝说出情人的名字，在耻辱中独自将女儿珠儿抚养成人——霍桑以她书写了罪恶、骄傲与救赎的最复杂的文学形象。" },
  ],
  "exp-am-002": [
    { name: "以实玛利", role: "叙述者", description: "'叫我以实玛利。'裴廓德号上唯一的幸存者——梅尔维尔以他的声音开始了英语文学中最著名的捕鲸之旅。'白鲸'是一部关于美国式执念的百科全书。" },
  ],
  "exp-am-003": [
    { name: "亨利·大卫·梭罗", role: "叙述者/作者", description: "在瓦尔登湖畔独居两年零两个月——他在那里发现'一个人越能放下，就越富有'。梭罗以这部经典将自然观察、精神自传与公民不服从宣言融为一体。" },
  ],
  "exp-am-004": [
    { name: "汤姆叔叔", role: "主人公", description: "一个虔诚、善良的黑奴——被卖了一次又一次。他的忍耐、他的死亡——在被鞭打至死的最后一刻他说'我原谅你'——斯托夫人以他唤醒了半个美国。这也是一个被后世争议的人物名——'汤姆叔叔'从圣徒变成了'逆来顺受'的文化批评符号。" },
  ],
  "exp-am-005": [
    { name: "乔·马奇", role: "核心人物", description: "马奇家的二女儿——她想当作家，拒绝传统婚姻，剪掉长发换钱——无数代女性读者在她身上看到了自己。奥尔科特以乔创造了美国文学中最著名的女性角色。" },
  ],
  "exp-am-006": [
    { name: "埃德娜·庞特利尔", role: "主人公", description: "一个已婚的新奥尔良上流社会女性——在夏天的大海边觉醒了自己的欲望和自我。1899年因'不道德'被禁——但她的'觉醒'预示了半个世纪后的女性主义运动。" },
  ],
  "exp-am-007": [
    { name: "杰克·巴恩斯", role: "（参见 'the-sun-also-rises'）" , description: "" },
  ],
  "exp-am-008": [
    { name: "邦德伦一家", role: "（参见 'as-i-lay-dying'）" , description: "" },
  ],
  "exp-am-009": [
    { name: "汤姆·乔德", role: "主人公", description: "俄克拉荷马的农民之子——被沙尘暴和银行夺走了家园。他带着家人驶上66号公路前往加利福尼亚——在那里的'应许之地'只有剥削和饥饿。斯坦贝克以他书写了美国大萧条时期最真实的声音——'哪里有人挨饿，我就在哪里。'" },
  ],
  "exp-am-010": [
    { name: "罗伯特·乔丹", role: "（参见 'for-whom-the-bell-tolls'）" , description: "" },
  ],
  "exp-am-011": [
    { name: "威利·洛曼", role: "主人公", description: "一个过了气的推销员——在他生命的最后二十四小时里，他的美国梦在他眼前崩溃。阿瑟·米勒以他发出了二十世纪美国戏剧中最悲伤的提问：'注意必须被给予。'" },
  ],
  "exp-am-012": [
    { name: "布兰奇·杜波依斯", role: "主人公", description: "一个失去了家族庄园的南方美人——'我总是依赖陌生人的善意。'她带着满箱华服和破碎的幻觉来到新奥尔良的妹妹家——与粗野的斯坦利的碰撞注定是悲剧。" },
  ],
  "exp-am-013": [
    { name: "萨尔·帕拉迪斯", role: "叙述者", description: "凯鲁亚克的半自传形象——与迪安·莫里亚蒂一起横穿美洲大陆的'在路上'之旅。他以作家之眼记录了美国的高速公路、爵士酒吧和太阳升起时那片'神圣的土地'。" },
  ],
  "exp-am-014": [
    { name: "尤索林", role: "主人公", description: "一个驻扎在意大利的美国轰炸机投弹手——他想证明自己疯了以停飞，但'第22条军规'让这个愿望永远不可能实现。海勒以他创造了关于战争之荒诞的最持久的文学符号。" },
  ],
  "exp-am-015": [
    { name: "比利·皮尔格林", role: "主人公", description: "一个在德累斯顿轰炸中幸存下来的美国战俘——后来被外星人绑架到一个动物园中。他在时间中'脱臼'——过去、现在和未来同时发生。冯内古特以科幻外壳写出了一部关于战争创伤的经典。'事情就是这样。'" },
  ],
  "exp-am-016": [
    { name: "西莉", role: "（参见 'the-color-purple'）" , description: "" },
  ],

  "exp-la-001": [
    { name: "蒂·诺埃尔", role: "（参见 'the-kingdom-of-this-world'）" , description: "" },
  ],
  "exp-la-002": [
    { name: "安塞尔莫", role: "（参见 'the-green-house'）" , description: "" },
  ],
  "exp-la-003": [
    { name: "圣地亚哥·纳萨尔", role: "主人公/死者", description: "一个即将在早晨被谋杀的年轻男子——而整个小镇都知道却无人阻止。马尔克斯以他的死亡为侦探线的起点——拷问了一整个社区在暴力面前的共谋。" },
  ],
  "exp-la-004": [
    { name: "独裁者", role: "（参见 'the-autumn-of-the-patriarch'）" , description: "" },
  ],
  "exp-la-005": [
    { name: "四位核心学者", role: "核心人物", description: "四个欧洲文学教授在世界各地寻找一个神秘作家阿琴波尔迪的踪迹——而小说的第五部分转向墨西哥圣特雷莎城中数百名被杀害的女性的骇人现实。波拉尼奥的遗作是一部无法归类的'文学黑洞'。" },
  ],
  "exp-la-006": [
    { name: "莫利纳", role: "核心人物", description: "一个因'腐蚀未成年人'入狱的同性恋者——在监狱牢房里他向革命者瓦伦丁讲述一部又一部老电影。在两个人的对话中，普伊格以全对话体书写了一部关于爱与政治的经典。" },
  ],

  "exp-ca-001": [
    { name: "奥芙弗雷德", role: "主人公/叙述者", description: "在基列共和国——一个神权极权的未来美国——她被沦为'使女'：她的存在被简化为她的子宫。阿特伍德以她的声音写下了反乌托邦文学中最强大的女性叙述。" },
  ],
  "exp-ca-002": [
    { name: "艾丽丝·蔡斯", role: "叙述者", description: "一个即将走到人生尽头的老妇人——她以回忆录的形式揭开了妹妹劳拉之死的谜团。小说中嵌套着另一部小说——《盲刺客》——艾丽丝的层层叙述是阿特伍德叙事技巧的巅峰。" },
  ],
  "exp-ca-003": [
    { name: "阿尔马西伯爵", role: "（参见 'the-english-patient'）" , description: "" },
  ],

  // ==================== 扩充库1000 — 大洋洲 (exp-oc) ====================

  "exp-oc-001": [
    { name: "梅吉·克利里", role: "主人公", description: "新西兰牧场主的女儿——一生爱上了不能拥有的人：神父拉尔夫。她的命运如同一只荆棘鸟——'最美好的东西只能用深痛巨创来换取。'" },
  ],
  "exp-oc-002": [
    { name: "吉米·布莱克史密斯", role: "（参见 'the-chant-of-jimmie-blacksmith'）" , description: "" },
  ],
  "exp-oc-003": [
    { name: "奥斯卡·辛德勒", role: "（参见 'schindlers-ark'）" , description: "" },
  ],
  "exp-oc-004": [
    { name: "威廉·桑希尔", role: "（参见 'the-secret-river'）" , description: "" },
  ],
  "exp-oc-005": [
    { name: "皮克尔家与兰姆家", role: "集体主人公", description: "两个家庭在珀斯云街同一座大房子里的二十年——一个是赌徒家族，一个是虔诚的教徒。蒂姆·温顿将最普通的澳洲生活赋予了魔幻的质感——每天的面包与鱼可以成为奇迹。" },
  ],
  "exp-oc-006": [
    { name: "卡胡", role: "（参见 'the-whale-rider'）" , description: "" },
  ],
  "exp-oc-007": [
    { name: "莉赛尔·梅明杰", role: "主人公", description: "纳粹德国，一个被收养的小女孩偷了一本又一本的书——而她的叙述者是死神。'一个被文字喂养的灵魂'——在轰炸、饥饿和死亡中，她发现了语言的力量。" },
  ],

  // ==================== 扩充库1000 — 诺贝尔/布克 (exp-nb) ====================

  "exp-nb-001": [
    { name: "忒瑞西阿斯", role: "先知/叙述声音", description: "荒原的核心声音——一个跨越性别与时代的盲眼先知。艾略特以碎片式的典故和破碎的人声拼贴出了二十世纪关于文明精神废墟的最权威的诗篇。'四月是最残忍的月份。'" },
  ],
  "exp-nb-002": [
    { name: "德里纳河上的桥", role: "沉默的主角", description: "维谢格勒城中那座横跨德里纳河的奥斯曼石桥——它是全书真正的'主角'。从十六世纪到一战，桥以沉默见证了一代又一代人的生、爱与死。安德里奇以一座桥的传记为巴尔干写下了最庄严的历史挽歌。" },
  ],
  "exp-nb-003": [
    { name: "玛丽·蒂龙", role: "母亲", description: "一个吗啡成瘾的母亲——以奥尼尔自己的母亲为模型。在这'一个漫长的一天'中，蒂龙一家人相互折磨、相互谴责、相互爱——美国戏剧史上最令人心碎的家庭。" },
  ],
  "exp-nb-004": [
    { name: "克里斯汀·拉夫朗", role: "主人公", description: "十四世纪挪威——从少女到妻子到母亲到老妇——她的一生是北欧中世纪生活的全景。温塞特以她为基督教与北欧异教传统之间的挪威灵魂写下了最庄严的传记。诺贝尔奖。" },
  ],
  "exp-nb-005": [
    { name: "伊萨克·迪内森（凯伦·布里克森）", role: "叙述者/作者", description: "'我在非洲有一座农场。'迪内森以优雅而哀伤的散文回忆了在肯尼亚的十七年——她的咖啡农场、她的索马里仆人法拉、她的爱人丹尼斯·芬奇-哈顿——一部关于告别与追忆的经典。" },
  ],
  "exp-nb-006": [
    { name: "拉尔夫", role: "主人公", description: "一群流落荒岛的英国学童中选出的小领导——试图维持文明和秩序。但在杰克领导的'猎人'部落面前，文明的外壳迅速剥落——'人制造恶就像蜜蜂制造蜜。'戈尔丁以荒岛寓言写出了二十世纪最冷峻的人性反思。" },
  ],
  "exp-nb-007": [
    { name: "安娜·伍尔夫", role: "主人公", description: "一个离了婚的英国女作家——她的生活被记录在四本不同颜色的笔记本中：黑色（她在非洲的过去）、红色（她的共产主义信仰）、黄色（以自身为原型写的小说）、蓝色（她的私密日记）。莱辛以她书写了二十世纪女性的精神地图。" },
  ],
  "exp-nb-008": [
    { name: "六个人物", role: "叙述者", description: "伯纳德、苏珊、罗达、内维尔、吉妮、路易——六个从童年到老年的声音以海浪般的节奏交替出现。伍尔夫以这六段平行的独白完成了她最大胆的叙事实验——关于时间、自我与终将泯灭的个体生命。" },
  ],

  // ==================== 亚洲扩充 — bk-ch/jp/in ====================

  "bk-in-003": [
    { name: "纳拉扬", role: "作者/叙述者", description: "R.K.纳拉扬以虚构的南印度小镇马尔古迪为舞台——他的所有小说都在这个他发明的小镇中展开。斯瓦米和他的朋友们是其中最受欢迎的一部——关于童年、友谊和一个正在消失的印度。" },
  ],
  "bk-pe-003": [
    { name: "萨迪克·赫达亚特", role: "主人公", description: "伊朗现代文学中最黑暗的天才——以《盲梟》写出了一个画匠在鸦片与死亡的幻觉中坠入疯狂的过程。这部短篇小说是二十世纪波斯文学最具震撼力的作品，也是伊朗现代主义文学的开端。" },
  ],

  // ==================== 真实扩展 — re-* ====================

  "re-af-04": [
    { name: "阿切贝", role: "作者", description: "（参见主条目 'things-fall-apart'）奇努阿·阿切贝以《神箭》进一步探索了在殖民渗透下传统伊博社会的瓦解——部落的最高祭司埃泽乌鲁在基督教与传统信仰之间被撕裂。" },
  ],
  "re-am-09": [
    { name: "约翰", role: "核心人物", description: "鲍德温在《去宣告在山上》中——以哈莱姆一个黑人少年在父亲严厉的宗教管教下的一天为背景——一部关于种族、信仰与同性之爱在1950年代美国激烈碰撞的自传性杰作。" },
  ],
  "re-de-04": [
    { name: "汉斯·卡斯托普", role: "（参见主条目 'magic-mountain'）" , description: "" },
  ],
  "re-ee-01": [
    { name: "格里高尔·萨姆沙", role: "（参见主条目 'metamorphosis'）" , description: "" },
  ],
  "re-ee-02": [
    { name: "约瑟夫·K", role: "（参见主条目 'the-trial'）" , description: "" },
  ],
  "re-ee-03": [
    { name: "K", role: "（参见主条目 'the-castle'）" , description: "" },
  ],
  "re-in-01": [
    { name: "甘地", role: "自传主人公", description: "甘地在狱中以古吉拉特语写成的自传——'我体验真理的故事'——记录了他从一个害羞的英国律师到非暴力抵抗运动领袖的精神旅程。'非暴力'在这本书中不是一个哲学概念，而是一个人的一生实验。" },
  ],
  "re-in-05": [
    { name: "阿伦达蒂·罗伊", role: "作者", description: "以《微物之神》获得了布克奖——两个双胞胎在喀拉拉邦的'爱的法则'中溺毙。罗伊以感官丰富的散文写出了印度社会中最不可言说的禁忌——种姓制度与'被禁止的爱'的交织。" },
  ],
  "re-it-01": [
    { name: "埃莱娜与莉拉", role: "（参见主条目）" , description: "" },
  ],
  "re-la-02": [
    { name: "埃斯特班·特鲁埃巴", role: "主人公", description: "一个智利庄园主——阿连德以三代女性的命运围绕着这个'家长'构建了一座关于爱情、政治与魔法的'幽灵之家'——拉丁美洲版《百年孤独》。" },
  ],
  "re-la-05": [
    { name: "胡安·普雷西亚多", role: "主人公", description: "一个前往科马拉寻找父亲的年轻人——发现整个镇子都是鬼魂。鲁尔福以他创造了一部五十页的中篇小说——这五十页孕育了整个拉丁美洲的魔幻现实主义。" },
  ],
  "re-ru-03": [
    { name: "安娜·卡列尼娜", role: "（参见主条目 'anna-karenina'）" , description: "" },
  ],

  // ==================== r2-* 补充 ====================

  "r2-af-02": [
    { name: "奥康考", role: "（参见 'things-fall-apart' 主条目）" , description: "" },
  ],
  "r2-eu-01": [
    { name: "克拉丽丝", role: "女主角", description: "罗伯特·穆齐尔《没有个性的人》中乌尔里希的'灵魂姐妹'。在这部未完成的巨著中，穆齐尔以一战前奥匈帝国的精神空虚——'卡卡尼亚'——为舞台，进行了一场关于'什么是活过的生命'的终极追问。" },
  ],
  "r2-eu-02": [
    { name: "斯蒂芬·迪达勒斯", role: "（参见 'a-portrait-of-the-artist'）" , description: "" },
  ],
  "r2-pr-03": [
    { name: "利奥波德·布卢姆", role: "（参见 'ulysses' 主条目）" , description: "" },
  ],
  "r2-pr-08": [
    { name: "莫洛伊", role: "主人公", description: "贝克特的同名小说主人公——一个瘫痪的老人以独白讲述了他寻找母亲的旅程——他爬行、跌倒、迷失——但从未停止寻找。贝克特以此将叙事推至'极简'的极限——'我必须继续，我不能继续，我将继续。'" },
  ],

  // ==================== 杂项独立ID ====================

  "the-joke": [
    { name: "卢德维克·扬", role: "主人公", description: "一个捷克斯洛伐克的大学生——因为在一张明信片上写了一个政治笑话而被开除党籍、赶出大学。米兰·昆德拉以他的命运追问：当一个'玩笑'被历史以最严肃的方式回应时，谁才是真正的笑话？" },
  ],

  // ==================== bk-* 更多 (bulk-expansion) ====================

  "bk-am-006": [
    { name: "杰克·巴恩斯", role: "（参见 'the-sun-also-rises'）" , description: "" },
  ],


  // ==================== x3 扩充 ====================


  "x3-jp-001": [
    { name: "鉴真", role: "主人公", description: "唐代高僧——六次东渡日本，五次失败，双目失明后终于到达。井上靖以鉴真的执着为信念写下了最庄严的文学传记。" },
  ],
  "x3-jp-002": [
    { name: "赵行德", role: "主人公", description: "北宋落第书生——在丝路上流浪，最终在敦煌藏经洞中以生命守护了文明的碎片。井上靖以他的传奇为'文明保存'写下了最壮丽的小说。" },
  ],
  "x3-jp-003": [
    { name: "千重子", role: "核心人物", description: "京都一家绸缎批发商的独生女——偶然发现自己在北山杉林中有个孪生妹妹苗子。川端康成以京都的四季——春樱、夏祭、秋枫、冬雪——书写了关于身份与归属的最淡雅的哀歌。" },
  ],
  "x3-jp-004": [
    { name: "我", role: "叙述者", description: "村上春树处女作的叙述者——一个在神户酒吧中消磨夏天的年轻人。'我'和'老鼠'在爵士乐和啤酒中——村上式'轻逸'而深沉的叙事语调在此诞生。" },
  ],
  "x3-jp-005": [
    { name: "箱男", role: "主人公", description: "一个决定放弃正常生活住进一个纸箱的男人。安部公房以这个极端的设定追问了现代都市中'存在'的边界——当你看不见社会，社会也就看不见你。" },
  ],

  "x3-kr-001": [
    { name: "李舜臣", role: "主人公", description: "朝鲜历史上最伟大的海军将领。金薰以极简的笔法重述了壬辰倭乱中他的龟船舰队——一个爱国者的孤独与崇高。" },
  ],
  "x3-kr-002": [
    { name: "金笠", role: "主人公", description: "朝鲜最著名的流浪诗人——戴着竹笠在山水间漂泊。李承雨以他的生平书写了一个在时代夹缝中以诗歌为生、以自由为命的浪漫灵魂。" },
  ],
  "x3-kr-003": [
    { name: "少年东浩", role: "核心人物", description: "1980年光州事件的少年受害者——韩江以多重声音拼贴出民主化运动中普通人的创伤与尊严。'少年来了'——但很多少年再也没能走回去。" },
  ],

  "x3-sea-001": [
    { name: "明克", role: "主人公", description: "普拉姆迪亚·阿南达·杜尔的布鲁岛四部曲主人公——一个爪哇土著青年在殖民时期荷兰教育中成长为一个民族主义记者。印尼文学的第一部世界级小说。" },
  ],
  "x3-sea-002": [
    { name: "明克", role: "核心人物", description: "布鲁岛四部曲之二——明克的故事继续，印尼民族运动在与殖民主义的斗争中步步推进。普拉姆迪亚在囚禁于布鲁岛时以口述完成了这些小说。" },
  ],

  "x3-uk-002": [
    { name: "蓓基·夏泼", role: "主人公", description: "一个父亲是穷画家母亲是舞女的孤女——凭借美貌、机智和彻底的道德灵活性在社会阶梯上向上攀爬。萨克雷以她创造了英语文学中最迷人的'反女主角'——'这部小说没有英雄。'" },
  ],
  "x3-uk-003": [
    { name: "多萝西娅·布鲁克", role: "核心人物", description: "一个充满理想主义的年轻女性在米德尔马契这个外省小镇的婚姻与幻灭。乔治·艾略特以她写出了维多利亚时代最伟大的小说——关于社会、婚姻与个人成长的'全景图'。" },
  ],
  "x3-uk-004": [
    { name: "保罗·莫瑞尔", role: "主人公", description: "（参见 'sons-and-lovers'）劳伦斯以矿工家庭的母子关系深入探测了性、情感与工业文明之间的黑暗地带。" },
  ],
  "x3-uk-005": [
    { name: "查尔斯·莱德", role: "叙述者", description: "一个牛津学生在二战期间回忆他在布莱兹赫德庄园度过的青春——在那个即将消逝的天主教贵族世界中他与塞巴斯蒂安·弗莱特的友谊构成了一部关于美、信仰与衰败的挽歌。'旧地重游'——伊夫林·沃的杰作。" },
  ],
  "x3-uk-006": [
    { name: "布里奥妮·塔利斯", role: "核心人物", description: "一个十三岁的女孩——用她'作家'的想象力对一桩她并不理解的成人事件做出了致命的错误指控。她一生都在试图用写作'赎罪'——但她写的小说能够弥补真实的历史吗？麦克尤恩以她追问了叙事本身的道德性。" },
  ],
  "x3-uk-007": [
    { name: "凯西·H", role: "主人公", description: "（参见主条目）石黑一雄以黑尔舍姆的三个学生——凯西、汤米和露丝——以最克制的叙述包裹了最令人心碎的反乌托邦。" },
  ],

  "x3-fr-001": [
    { name: "艾蒂安·朗捷", role: "主人公", description: "一个被解雇的机械师——在蒙苏煤矿找到了工作，也找到了一场罢工的灵魂。左拉以他写出了自然主义文学的巅峰——矿井在黑暗中吞噬人，而'萌芽'在土壤下悄然生长。" },
  ],
  "x3-fr-002": [
    { name: "默尔索", role: "主人公", description: "（参见主条目 'the-stranger'）加缪以这个在母亲葬礼上没有哭泣的男人——以及他后来在海滩上'因为阳光'而杀人的行为——写出了关于存在之荒诞的最著名的文学宣言。" },
  ],
  "x3-fr-003": [
    { name: "安东尼·罗康坦", role: "主人公", description: "一个在布维尔孤独生活的历史学者。某天他突然被'恶心'击中——鹅卵石、树根、甚至他自己的手——所有存在之物都变得无法忍受的'多余'。萨特以他的日记写出了存在主义最著名的文学宣言。" },
  ],
  "x3-fr-004": [
    { name: "格朗热中尉", role: "主人公", description: "1940年'假战'期间驻守阿登森林地堡的法军中尉——在等待从未到来的德军时，他沉入了森林的静默与自我的深处。格拉克以超现实主义的笔触为'战争中的等待'写下了最奇异的诗篇。" },
  ],
  "x3-fr-005": [
    { name: "她", role: "法国女演员", description: "来到广岛拍摄一部关于和平的电影——在原子弹爆炸后重建的城市中与一个日本建筑师度过了激情与创伤的一夜。杜拉斯为雷乃写下的剧本——关于战争创伤、记忆与遗忘的最美的文学作品。" },
  ],

  "x3-de-002": [
    { name: "哈里·哈勒尔", role: "主人公", description: "一个自称'荒原狼'的中年知识分子——在市民的体面与荒野的狂放之间痛苦分裂。黑塞以他写尽了现代文化精英的精神困境——直到他在'魔术剧院'中找到了笑声。" },
  ],
  "x3-de-003": [
    { name: "汉斯·卡斯托普", role: "主人公", description: "（参见主条目 'magic-mountain'）托马斯·曼以这个在瑞士高山疗养院中'下山'的年轻人——原本计划只待三周却住了七年——写出了关于时间、疾病与欧洲文明衰落的巨著。" },
  ],
  "x3-de-004": [
    { name: "奥斯卡·马策拉特", role: "主人公", description: "（参见 'x3-pr-001'）君特·格拉斯以这个三岁就决定不再长高的侏儒击穿了整个二十世纪德国史。" },
  ],

  "x3-ru-001": [
    { name: "彼得·格里尼奥夫", role: "主人公", description: "一个被父亲送往边疆要塞服役的年轻贵族——在普加乔夫起义的暴乱中他的爱情和勇气都将受到考验。普希金的最后一部散文作品。" },
    { name: "玛莎", role: "女主角", description: "上尉的女儿——在暴乱中失去双亲后被格里尼奥夫所爱。普希金以她创造了最纯朴的俄国文学女性形象。" },
  ],
  "x3-ru-002": [
    { name: "猎人", role: "叙述者", description: "屠格涅夫在《猎人笔记》中的叙述者——一个带着枪在俄国乡村漫游的贵族猎人。他的笔记中记录的每一个农民都栩栩如生——这部短篇集被认为直接推动了俄国废除农奴制。" },
  ],
  "x3-ru-003": [
    { name: "安德烈·包尔康斯基", role: "核心人物", description: "（参见主条目 'war-and-peace'）在奥斯特里茨的天空下负伤倒地的安德烈公爵——看到的'高远的天空'是托尔斯泰全部作品中关于死亡与永恒的最著名的场景。" },
  ],
  "x3-ru-004": [
    { name: "奥尔加", role: "三姐妹之一", description: "普洛佐罗娃家的大姐——一个老姑娘，在县城的无聊中照顾着弟弟妹妹。'去莫斯科！去莫斯科！'——她的呼喊是契诃夫全部戏剧中最令人心碎的声音。" },
    { name: "玛莎", role: "三姐妹之一", description: "嫁给了一个她不爱的中学教师的二姐——她在军旅音乐和无所事事的下午中消耗着青春。契诃夫以她写出了被平庸生活所扼杀的女性的全部哀伤。" },
  ],

  "x3-nord-001": [
    { name: "培尔·金特", role: "主人公", description: "（参见 'peer-gynt'）易卜生以这个永远在逃避自我的浪子——从挪威山谷到摩洛哥沙漠——追问了'成为自己'的真正含义。" },
  ],
  "x3-nord-002": [
    { name: "无名叙述者", role: "主人公", description: "（参见 'hunger'）汉姆生以第一人称意识流——早于乔伊斯三十年——将饥饿如何扭曲人的心智写得入骨三分。" },
  ],
  "x3-nord-003": [
    { name: "卡尔·奥斯卡", role: "主人公", description: "十九世纪的瑞典农民——移民到明尼苏达的荒野中开垦。莫伯格以他和妻子克里斯蒂娜的故事为瑞典移民文学写下了最宏伟的史诗——'移民'四部曲。" },
  ],
  "x3-nord-004": [
    { name: "皮皮", role: "主人公", description: "（参见 'pippi-longstocking'）全世界最强壮也最自由的女孩——以她的超人之力颠覆了成人世界的所有规则。" },
  ],

  "x3-ee-001": [
    { name: "帅克", role: "主人公", description: "一个来自布拉格的狗贩子——以一种'绝对服从'的笨拙姿态瓦解了奥匈帝国军事官僚体制的每一个环节。哈谢克以他创造了反战小说中最大的'玩笑'——没有人知道帅克是真的白痴还是在装傻。" },
  ],
  "x3-ee-002": [
    { name: "卢德维克·扬", role: "主人公", description: "（参见 'the-joke'）米兰·昆德拉以多人称叙述拼接出斯大林时代捷克社会的一个'残酷笑话'。" },
  ],
  "x3-ee-003": [
    { name: "米洛什", role: "核心人物", description: "赫拉巴尔《严密监视的列车》中的年轻铁路员工——在二战末期一个捷克小镇的火车站上，他的性启蒙与一场小小的抵抗行动发生了意外的交叉。捷克斯洛伐克新浪潮电影的原作。" },
  ],


  "x3-am-002": [
    { name: "尤金·甘特", role: "主人公", description: "托马斯·沃尔夫的半自传形象——在北卡罗来纳山区小城中成长的敏感少年。沃尔夫以喷涌澎湃的散文语言写出了一部美国版的'成长小说'——'啊，失落的，被风凭吊的。'" },
  ],
  "x3-am-003": [
    { name: "乔治·巴比特", role: "主人公", description: "一个美国中西部城市的房地产商人——'市侩'一词因他进入英语。刘易斯以无情的锋利讽刺解剖了美国中产阶级的灵魂——一个追求'标准生活'的人的空虚。" },
  ],
  "x3-am-004": [
    { name: "劳拉·温菲尔德", role: "核心人物", description: "一个患有轻度残疾的少女——她的全部世界是一群玻璃小动物。田纳西·威廉斯以她创造了美国戏剧中最易碎也最令人心碎的灵魂——'玻璃独角兽'被打碎的那个瞬间，是整个戏剧史上最安静的心碎。" },
  ],
  "x3-am-005": [
    { name: "埃斯佩朗莎", role: "主人公/叙述者", description: "一个在芝加哥拉丁裔社区芒果街上长大的小女孩——以四十四段散文诗般的短章写出她想要'属于自己的房子'的梦想。希斯内罗丝以她为所有在缝隙中长大的少数族裔女孩发出了声音。" },
  ],
  "x3-am-006": [
    { name: "鲁弗斯", role: "核心人物", description: "鲍德温《另一个国家》中的人物——在纽约的爵士、性和种族之间寻找一种超越一切分类的自由爱情。鲍德温以这部小说写下了美国文学中最赤裸的关于种族与欲望的告白。" },
  ],
  "x3-am-007": [
    { name: "摩西·赫索格", role: "主人公", description: "一个精神濒临崩溃的犹太裔知识分子——他的妻子跟他的好友跑了，而他整天给活人、死人和上帝写不会寄出的信。贝娄以他写出了一部关于美国知识分子精神危机的'思想小说'。" },
  ],
  "x3-am-008": [
    { name: "尤索林", role: "主人公", description: "（参见 'exp-am-014'）海勒以这个想证明自己疯了以停飞的轰炸机投弹手创造了一个关于战争荒谬性的世界文学符号。" },
  ],

  "x3-la-001": [
    { name: "无名小镇居民", role: "集体主人公", description: "哥伦比亚无名小镇的居民——当匿名传单开始在墙上出现，揭露所有人的秘密时，整个社区被恐惧和暴力吞噬。马尔克斯以这部小说为马孔多的世界奠定了基石。" },
  ],
  "x3-la-002": [
    { name: "胡安·普雷西亚多", role: "主人公", description: "一个前往科马拉寻找父亲的年轻人——发现整个镇子都是鬼魂。鲁尔福以他创造了一部五十页的中篇小说——这五十页孕育了整个拉丁美洲的魔幻现实主义。" },
  ],
  "x3-la-003": [
    { name: "无名司机们", role: "集体主人公", description: "在巴黎外的高速公路上因堵车被困数日的司机们——科塔萨尔以这则关于临时社会如何在解封时刻瞬间瓦解的寓言写下了短篇小说的奇迹。'南方高速'——堵车文学的最高峰。" },
  ],
  "x3-la-004": [
    { name: "蒂塔", role: "主人公", description: "（参见 'like-water-for-chocolate'）墨西哥厨房里的魔幻现实主义——她的情感融入了每一道菜。" },
  ],
  "x3-la-005": [
    { name: "奥菲利亚", role: "主人公", description: "1944年西班牙——在法西斯继父的阴影下逃入地下的牧神迷宫。德尔·托罗的这部小说将童话的黑暗与政治的黑暗血肉交织。" },
  ],

  "x3-oc-001": [
    { name: "提孔岛民们", role: "集体主人公", description: "（参见 'tales-of-the-tikongs'）豪奥法以幽默与讽刺写成的太平洋岛国寓言集——以笑声瓦解了殖民主义与'发展'的神话。" },
  ],
  "x3-oc-002": [
    { name: "内德·凯利", role: "主人公", description: "（参见 'true-history-kelly-gang'）澳大利亚最著名的丛林大盗，彼得·凯里以他的第一人称书信体重写了国家神话。" },
  ],

  "x3-pr-001": [
    { name: "奥斯卡·马策拉特", role: "主人公", description: "一个三岁时决定不再长高的侏儒——以他的铁皮鼓和能震碎玻璃的尖叫击穿了纳粹德国及战后德国的整个历史。格拉斯以他创造了一个既是受害者又是共谋者的时代灵魂——但泽三部曲之首。" },
  ],
  "x3-pr-002": [
    { name: "威廉·巴斯克维尔", role: "主人公", description: "一个方济各会修士——在中世纪修道院的连环谋杀案中以中世纪的'理性侦探'身份追寻真相。艾柯以他将符号学、神学和侦探小说编织为一部献给爱书人的迷宫。" },
  ],
  "x3-pr-003": [
    { name: "医生之妻", role: "核心人物", description: "全城唯一没有失明的人——她在所有人失明后带领一群被隔离的盲人在文明崩塌后的至暗之中寻找食物、安全和尊严。萨拉马戈以她书写了人类尊严的最后一束光。" },
  ],
  "x3-pr-004": [
    { name: "悦子", role: "叙述者", description: "（参见主条目）石黑一雄的处女作以不可靠的叙述者让读者在阅读中不断怀疑：悦子真正在隐瞒的是什么？" },
  ],
  "x3-pr-005": [
    { name: "安东尼娅·谢默尔达", role: "主人公", description: "内布拉斯加草原上的波希米亚移民女孩——以她的生命力和对土地的深爱成为叙述者吉姆·伯登一生中的'精神故乡'。凯瑟以她书写了关于美国边疆最深情也最庄重的女性传记。" },
  ],
  "x3-pr-006": [
    { name: "埃丝特·格林伍德", role: "主人公", description: "一个在1950年代纽约实习的年轻女性——在成功的表象下正被抑郁症吞噬。普拉斯以她自己为模型写下了一部关于女性精神崩溃的经典。'我吞下了整个世界的黑暗。'" },
  ],
  "x3-pr-007": [
    { name: "格拉斯", role: "诗人/叙述者", description: "格拉斯以诗歌为'历史的淘金筛'——在两德统一的时代中以诗人-公民的双重身份对德国的过去与现在发出不妥协的声音。" },
  ],
  "x3-pr-008": [
    { name: "老妇人", role: "核心人物", description: "一个在森林中默默死去的老妇人——安德森以这个被遗忘的女人的一生为美国小镇的私密黑暗立下了一座安静的文学墓碑。" },
  ],
  "x3-pr-009": [
    { name: "六个角色", role: "核心人物", description: "一部关于正在寻找作者的六个角色的元戏剧——皮兰德娄以他们打破了舞台与现实的边界。当他们闯入一场排练时——什么是'真实'？什么是'表演'？诺贝尔文学奖得主最著名的戏剧。" },
  ],
  "x3-pr-010": [
    { name: "伊雷内", role: "核心人物", description: "智利军政府时期的女记者——在政治恐怖中与摄影师弗朗西斯科相爱。阿连德将浪漫、政治反抗与女性的勇气编织为一部关于黑暗时代中爱的力量的小说。" },
  ],
  "x3-pr-011": [
    { name: "赛伊", role: "主人公之一", description: "在喜马拉雅山脚下与退休法官祖父一起生活的少女——爱上了她的家庭教师。德赛以两条交错的叙事追问了全球化时代中'家'是什么。布克奖。" },
  ],
  "x3-pr-012": [
    { name: "吉姆", role: "主人公", description: "（参见主条目 'lord-jim'）康拉德以这个年轻海员在一瞬间的懦弱——在沉船时弃船逃生——书写了关于荣誉、罪与救赎的最持久的海事寓言。" },
  ],

  // ==================== x4 扩充 ====================


  "x4-jp-001": [
    { name: "国木田独步", role: "作者/叙述者", description: "日本自然主义文学先驱——以武藏野的森林和原野为舞台开创了日本近代文学的'风景描写'传统。他的短篇将自然景物的每一寸肌理都赋予了情感的深度。" },
  ],
  "x4-jp-002": [
    { name: "小玉", role: "主人公", description: "明治时代被高利贷者包养的女人——她悄悄爱上了路过的年轻医学生，而这份爱注定了无法说出口。森鸥外以最克制的笔触写出了明治日本中最沉默也最悲伤的女性命运。" },
  ],
  "x4-jp-003": [
    { name: "时任谦作", role: "主人公", description: "志贺直哉的自传性形象——在命运给予的重重打击（妻子出轨、自身疾病、与父亲决裂）中——他的'暗夜行路'是一个人寻求内心和解的漫长征途。日本'私小说'的最高峰。" },
  ],
  "x4-jp-004": [
    { name: "高村智惠子", role: "诗人之妻", description: "一个患上精神分裂症的女人——'智惠子说东京没有天空'——高村光太郎以毕生的诗歌守护了对她的爱。日本近代最纯粹的爱情诗篇。" },
  ],
  "x4-jp-005": [
    { name: "鱼津", role: "主人公", description: "日本登山家——在攀登冰壁时尼龙绳断裂。井上靖以真实登山事故为素材书写了关于友谊、责任和高山之美的最严肃的追问。" },
  ],
  "x4-jp-006": [
    { name: "光俱乐部青年", role: "主人公", description: "以真实事件为素材——一个天才青年如何建立了一个金融帝国又迅速崩塌。三岛由纪夫早期以冷眼看天才与毁灭的小说。" },
  ],
  "x4-jp-007": [
    { name: "老人", role: "主人公", description: "一个年迈的日本老人对儿媳的变态痴迷——谷崎润一郎将晚年书写为欲望的最后狂欢。他对'美'的执念至死不休。" },
  ],

  "x4-in-001": [
    { name: "阿齐兹医生", role: "核心人物", description: "（参见 'exp-uk-002'）福斯特以马拉巴山洞这个永远没有答案的事件书写了英印之间那无法跨越的鸿沟。" },
  ],
  "x4-in-002": [
    { name: "印度农民与工人", role: "集体主人公", description: "安纳德以英语书写的印度独立运动中的农民与工人的群像——他们的抵抗与希望是印度英语文学中最真诚的左翼声音。" },
  ],
  "x4-in-003": [
    { name: "拉朱", role: "主人公", description: "（参见 'x5-in-002'）纳拉扬以幽默与智慧书写了普通人在印度社会转型中的身份游移。" },
  ],
  "x4-in-004": [
    { name: "艾莎与拉赫尔", role: "核心人物", description: "一对异卵双胞胎——在喀拉拉邦的河水中溺毙了他们的童年。阿兰达蒂·洛伊以他们的故事书写了一则关于'爱的法则'（即打破种姓的爱必须被惩罚）的最美也最残酷的寓言。布克奖。" },
  ],
  "x4-in-005": [
    { name: "巴尔拉姆·哈瓦伊", role: "主人公", description: "一个从比哈尔邦最底层的村庄走出来的茶馆服务员——通过谋杀雇主而成为班加罗尔的企业家。阿迪加以他幽默而粗暴的叙述为印度'黑暗面的崛起'写下了最尖锐的讽刺。布克奖。" },
  ],

  "x4-kr-001": [
    { name: "崔氏家族", role: "集体主人公", description: "朴景利以五部十六卷的史诗规模——从1897年到1945年——通过崔氏一家的命运折射了整个朝鲜民族在日本殖民下的苦难、抗争与生存。韩国文学史上最宏大的小说。" },
  ],
  "x4-kr-002": [
    { name: "英惠", role: "主人公", description: "一个普通的韩国家庭主妇——在决定不再吃肉后被家庭和社会一步步摧毁——但她同时也从'人'变成了一棵树。韩江以这则关于女性身体暴力和存在之自由的寓言获得了布克国际奖。" },
  ],
  "x4-kr-003": [
    { name: "妈妈", role: "主人公", description: "在首尔地铁站走失的妈妈——全家人第一次以各自的视角回顾这个一生为家人付出的女性。申京淑以她写给了每一位不被看见的妈妈。" },
  ],
  "x4-kr-004": [
    { name: "乡村青年", role: "主人公", description: "金裕贞以'带泪的笑'创造的韩国文学经典——一个纯朴的乡村青年的爱情在贫困与阶级面前被碾碎。韩国短篇小说的典范。" },
  ],

  "x4-uk-001": [
    { name: "凯瑟琳·莫兰", role: "主人公", description: "一个沉迷哥特小说的十七岁少女——在诺桑觉寺中她的想象力将普通事件幻想成恐怖的阴谋。奥斯汀以她向哥特小说致以了最温柔的讽刺——也是一部关于'学会读懂真实世界'的成长小说。" },
  ],
  "x4-uk-002": [
    { name: "马蒂·詹金斯", role: "叙述者", description: "克兰福德小镇的观察者——这个被时间遗忘的地方住着一群老处女。盖斯凯尔以温柔的幽默为维多利亚时代被'进步'遗忘的女性世界写下了最亲切的肖像。" },
  ],
  "x4-uk-003": [
    { name: "苔丝", role: "主人公", description: "（参见主条目 'tess'）哈代以这个纯洁又悲剧的乡村女孩写出了维多利亚时代关于性别、阶级与道德的最沉痛的小说。" },
  ],
  "x4-uk-004": [
    { name: "查尔斯·史密斯森", role: "核心人物", description: "一个维多利亚时代的业余古生物学家——在莱姆里吉斯的悬崖上与他未完成的爱情和达尔文式的'自然选择'相遇。福尔斯以他写出了关于维多利亚时代和现代叙事的一流后设小说。——《法国中尉的女人》。" },
  ],
  "x4-uk-005": [
    { name: "阿齐兹医生", role: "核心人物", description: "（参见 'exp-uk-002'）马拉巴山洞里发生了什么？福斯特以这个永远没有答案的问题书写了英印之间不可跨越的鸿沟。" },
  ],

  "x4-fr-001": [
    { name: "爱玛·包法利", role: "主人公", description: "（参见主条目 'madame-bovary'）福楼拜以这个沉溺于浪漫小说幻想的外省医生妻子——她的通奸、她的债务和她最后的自杀——为现实主义文学立下了不朽的里程碑。" },
  ],
  "x4-fr-002": [
    { name: "斯万", role: "核心人物", description: "（参见主条目 'in-search-of-lost-time'）普鲁斯特以斯万对奥黛特的痴迷之爱开启了整个《追忆似水年华》关于时间、记忆与爱的伟大主题。" },
  ],
  "x4-fr-003": [
    { name: "娜娜", role: "主人公", description: "一个巴黎街头的妓女——以她的肉体攀上了第二帝国上流社会的顶峰并毁灭了无数男人。左拉以自然主义的冷酷精确将她书写为一种'自然力量'——既美丽又致命。" },
  ],
  "x4-fr-004": [
    { name: "史密斯先生与太太", role: "人物", description: "（参见 'exp-fr-008'）尤内斯库以他们那毫无意义的对话宣告了荒诞派戏剧的诞生。" },
  ],

  "x4-de-001": [
    { name: "纳坦", role: "主人公", description: "一个犹太商人——在十字军时代的耶路撒冷。当苏丹萨拉丁问他三个宗教哪个是真宗教时，他以'三枚戒指'的寓言作答。莱辛以他书写了启蒙运动关于宗教宽容最庄严的文学宣言。" },
  ],
  "x4-de-002": [
    { name: "维特", role: "主人公", description: "（参见主条目 'sorrows-of-young-werther'）歌德以这个为爱自杀的青年开启了德国狂飙突进运动和整个欧洲浪漫主义文学。" },
  ],
  "x4-de-003": [
    { name: "痴儿西木", role: "主人公", description: "（参见 'exp-de-001'）德国巴洛克文学的最高成就——三十年战争中的反英雄史诗。" },
  ],

  "x4-ru-001": [
    { name: "塔拉斯·布尔巴", role: "主人公", description: "乌克兰哥萨克的酋长——一个在战斗中比任何人都勇猛的父亲。当他自己的儿子背叛了哥萨克投向波兰人时——他亲手杀死了儿子。果戈理以狂野的笔触书写了一部关于战争、忠诚与父爱的史诗。" },
  ],
  "x4-ru-002": [
    { name: "叶琳娜", role: "主人公", description: "俄国文学中第一个'行动'的女性——不愿只做'沉思者'，她跟随一个保加利亚革命者到巴尔干去为自由而战。屠格涅夫以她预言了一代'新女性'的到来。" },
  ],
  "x4-ru-003": [
    { name: "幻想家", role: "主人公/叙述者", description: "彼得堡白夜中的一个孤独的'幻想家'——在河堤上遇见了一个正在等待恋人的少女。四个夜晚——他们在彼此的孤独中找到了短暂的温暖。陀思妥耶夫斯基最温柔也最令人心碎的中篇小说。" },
  ],
  "x4-ru-004": [
    { name: "安娜·卡列尼娜", role: "主人公", description: "（参见主条目 'anna-karenina'）托尔斯泰以这个为爱毁灭自己的女性写出了一部关于婚姻、欲望与社会的最伟大的小说。" },
  ],
  "x4-ru-005": [
    { name: "格里高利·麦列霍夫", role: "主人公", description: "顿河哥萨克——在红军与白军之间来回摇摆。他的命运在革命、内战和两个女人之间被撕裂。肖洛霍夫以他书写了关于俄国革命最辽阔也最令人心碎的史诗。诺贝尔奖。" },
  ],
  "x4-ru-006": [
    { name: "奥列格·科斯托格洛托夫", role: "主人公", description: "一个刚从劳改营释放的政治犯——在癌症病房中与死亡和体制的双重压迫搏斗。索尔仁尼琴以一间病房隐喻了整个苏联社会的病症。" },
  ],

  "x4-it-001": [
    { name: "伦佐与露琪娅", role: "男女主人公", description: "十七世纪初米兰附近的两个恋人——在瘟疫、战争和贵族阴谋的波浪中被反复冲散。曼佐尼以他们的漂泊为意大利文学确立了现代叙事的标准——'意大利第一部现代小说'。" },
  ],
  "x4-it-002": [
    { name: "泽诺·科西尼", role: "主人公", description: "（参见 'confessions-of-zeno'）斯韦沃以这个永远在尝试戒烟却永远失败的商人创造了现代主义小说中第一个不可靠的叙述者。" },
  ],
  "x4-it-003": [
    { name: "阿吉鲁尔福爵士", role: "主人公", description: "（参见 'exp-it-003'）一套完美的白色盔甲——里面没有身体。卡尔维诺'我们的祖先'三部曲之一。" },
  ],
  "x4-it-004": [
    { name: "梅达尔多子爵", role: "主人公", description: "被土耳其人的炮弹炸成两半——一半极善一半极恶——然后两半都被缝回人形。卡尔维诺以这则哲学寓言追问：人的完整是好事还是坏事？善与恶可以分开吗？" },
  ],

  "x4-es-001": [
    { name: "塞西斯蒙多", role: "主人公", description: "（参见 'life-is-a-dream'）一出生就被囚禁在塔中的波兰王子——被给予一天的自由后发现生命本身就是一场梦。" },
  ],

  "x4-nord-001": [
    { name: "芬兰家庭", role: "集体主人公", description: "北极圈附近一个芬兰家庭——在极夜与极昼的交替中面对各自的秘密与和解。杜蒙以最还原主义的散文为北欧现代生活写下了最安静的小说。" },
  ],
  "x4-nord-002": [
    { name: "霍拉斯", role: "诗人/作者", description: "古罗马奥古斯都时代的桂冠诗人。《诗艺》以诗歌的形式阐述了诗歌的规则——'诗如画'（ut pictura poesis）——这篇诗体论文影响了此后两千年的西方文学理论。" },
  ],


  "x4-am-001": [
    { name: "阿奇·琼斯", role: "核心人物", description: "（参见 'exp-uk-010'）扎迪·史密斯以他的家庭为棱镜折射出半个世纪以来伦敦从白人都城到多元文化都会的蜕变。" },
  ],
  "x4-am-002": [
    { name: "萨姆·斯佩德", role: "主人公", description: "达希尔·哈米特《马耳他之鹰》中的硬汉侦探——他的'硬'不在于肌肉而在于他那不为人知的道德准则。硬汉派侦探小说的原型人物。" },
  ],
  "x4-am-003": [
    { name: "安东尼娅", role: "主人公", description: "（参见 'x3-pr-005'）凯瑟以对土地和人深沉的爱书写了美国边疆文学最动人的女性肖像。" },
  ],

  "x4-la-001": [
    { name: "博尔赫斯", role: "叙述者", description: "在布宜诺斯艾利斯一座老房子的地下室里——在楼梯的第十九级台阶下——有一个小光点。那是阿莱夫——一个包含宇宙所有点的点。博尔赫斯以这则短篇为'无限'写下了最浓缩的文学寓言。" },
  ],
  "x4-la-002": [
    { name: "博尔赫斯", role: "叙述者", description: "（参见 'the-book-of-sand'）一本没有首页也没有末页的书——博尔赫斯关于'无限'的变奏。" },
  ],
  "x4-la-003": [
    { name: "塞萨尔·巴列霍", role: "诗人", description: "（参见 'trilce'）拉丁美洲最激进的诗集——句法被拆解、词汇被发明——一场诗歌的地震。" },
  ],
  "x4-la-004": [
    { name: "奥尔罕·帕慕克", role: "叙述者", description: "（参见 'exp-tr-001'）以个人记忆与城市历史的双重视角写下了对伊斯坦布尔的深情告白。" },
  ],
  "x4-la-005": [
    { name: "拉伊夫", role: "主人公", description: "（参见 'exp-tr-002'）土耳其现代文学中最受热爱的经典爱情——一个在1920年代柏林发生的跨越文化之恋。" },
  ],

  "x4-oc-001": [
    { name: "失踪女孩们", role: "核心人物", description: "1900年情人节——在澳大利亚的悬崖上野餐的少女们——几个再也没有回来。琼·林赛以她们的神秘失踪创造了一部关于维多利亚时代压抑与澳大利亚荒野之力的经典。" },
  ],
  "x4-oc-002": [
    { name: "内德·凯利", role: "主人公", description: "（参见 'true-history-kelly-gang'）彼得·凯里以他的书信体重写了澳大利亚的国家神话。布克奖。" },
  ],

  "x4-pe-001": [
    { name: "昂苏尔·玛阿里", role: "作者/父亲", description: "波斯齐亚尔王朝的王子——在十一世纪写下了一部给儿子的四十四章人生指南。从骑马、射箭到治国、交友——这部'王子镜鉴'文学至今仍是波斯文化的核心文本。" },
  ],
  "x4-pe-002": [
    { name: "薇思与拉敏", role: "男女主人公", description: "波斯版的罗密欧与朱丽叶——比西方早了整整一个世纪。古尔冈尼以这首情诗为波斯所有的爱情叙事奠定了基础。" },
  ],
  "x4-pe-003": [
    { name: "哈菲兹", role: "诗人", description: "（参见主条目）十四世纪设拉子的伟大抒情诗人——以美酒、恋人与玫瑰为象征诉说了关于神圣与世俗之爱的最纯粹的诗篇。" },
  ],
  "x4-pe-004": [
    { name: "扎里", role: "主人公", description: "二战期间设拉子一个地主家庭的年轻妻子——伊朗第一部由女性创作的长篇小说。达内什瓦尔以她的视角写出了伊朗女性在战争、饥饿与外国占领中守护家庭的全部力量。" },
  ],

  "x4-sea-001": [
    { name: "明克", role: "主人公", description: "（参见 'x3-sea-001'）布鲁岛四部曲之首——印尼民族意识的觉醒在跨种族爱情中得到了最动人的表达。" },
  ],
  "x4-sea-002": [
    { name: "胡志明", role: "诗人/囚徒", description: "在国民党监狱中以古典汉诗记录囚禁生活的革命者——'狱中日记'——一百三十三首诗。一个革命领袖在铁窗中以最古老的中国诗体写出了二十世纪最不寻常的诗集。" },
  ],
  "x4-sea-003": [
    { name: "越南士兵", role: "核心人物", description: "从对方的视角书写越南战争——当子弹穿过一个人的身体时，不管那个人属于哪一边。这部小说以人性的共同语言回应了战争的残酷与荒谬。" },
  ],

  // ==================== x5 扩充 ====================

  "x5-ch-002": [
    { name: "九死一生", role: "叙述者", description: "（参见 'bk-ch-007'）" },
  ],

  "x5-jp-001": [
    { name: "美登利", role: "主人公", description: "在吉原花街附近长大的少女——与注定要做和尚的信如之间有着朦胧但注定无法开花的初恋。樋口一叶以她创造了日本近代女性文学的先声——二十四岁便死于肺结核的天才留下的唯一长篇。" },
  ],
  "x5-jp-002": [
    { name: "仆役", role: "主人公", description: "一个被主人逐出的京都仆役——在罗生门的破败楼梯上，他在饿死与成为盗贼之间做出了道德上最模糊的抉择。芥川龙之介以这则改编自《今昔物语》的短篇宣告了日本现代文学的诞生。" },
  ],
  "x5-jp-003": [
    { name: "太田丰太郎", role: "主人公", description: "一个留学德国的日本青年——在东西方文化之间分裂的灵魂。他与德国舞女爱丽丝的爱情悲剧——'在两个世界之间徘徊的人注定无法幸福'——日本浪漫主义文学的开端。" },
  ],
  "x5-jp-004": [
    { name: "濑川丑松", role: "主人公", description: "一个出身于部落民（日本的不接触者阶层）的小学教师——被父亲的遗训'绝不能暴露身份'压得喘不过气。岛崎藤村以他的挣扎书写了日本近代最沉痛的社会小说。" },
  ],
  "x5-jp-005": [
    { name: "莳冈家四姐妹", role: "集体主人公", description: "大阪没落商家的四个女儿——鹤子、幸子、雪子、妙子。谷崎以雪子漫长的相亲过程为线索为二战前日本最后一段优雅的时光——和服、赏樱、大和之美——写下了最动人的挽歌。" },
  ],

  "x5-in-001": [
    { name: "戈拉", role: "主人公", description: "一个爱尔兰弃婴被加尔各答的正统印度教家庭收养——长大后成为一个狂热的民族主义者和印度教正统的捍卫者——直到他发现了自己的真实出身。泰戈尔以他书写了关于民族认同与宗教宽容的最深邃的沉思。" },
  ],
  "x5-in-002": [
    { name: "拉朱", role: "主人公", description: "一个在火车站为旅客当'导游'的小骗子——后来成为舞女的恋人、经理——最后被一个农民误认为圣人。纳拉扬以幽默和慈悲写了这部关于身份游移和'虚假圣人如何成为真圣人'的奇妙小说。" },
  ],
  "x5-in-003": [
    { name: "差鲁达多", role: "主人公", description: "一个贫穷的婆罗门商人——爱上了名妓春军。首陀罗迦的这部古典梵语戏剧是罕见的以平民为主角的印度古典文学——将爱情喜剧、政治讽刺和打斗场面融为一体。" },
  ],

  "x5-uk-001": [
    { name: "红十字骑士", role: "主人公", description: "斯宾塞在《仙后》中创造的圣洁骑士——他的冒险是每一个基督徒灵魂的精神旅程。斯宾塞以这部未完成的史诗为伊丽莎白时代的英国文学创建了一种全新的诗体——'斯宾塞体'。" },
  ],
  "x5-uk-002": [
    { name: "约里克", role: "主人公/叙述者", description: "斯特恩以这个感伤的牧师为旅行者的形象——他在法国的旅行中到处寻找'感伤时刻'。他的叙事充满了机智的离题、突然的柔情和令人心碎的死驴——一部'反游记'的游记经典。" },
  ],
  "x5-uk-003": [
    { name: "芬妮·普莱斯", role: "主人公", description: "一个从贫穷家庭被送到富裕亲戚曼斯菲尔德庄园长大的安静女孩——以她的道德勇气和内在信念守护自己的原则。奥斯汀笔下最不'可爱'但也最受尊敬的女主角。" },
  ],
  "x5-uk-004": [
    { name: "主教与教士们", role: "群像", description: "特罗洛普以巴切斯特大教堂的一场主教职位争夺为舞台——温和的讽刺包裹着对维多利亚时代英国教会和乡村社会最亲切的观察。巴塞特郡系列中最受欢迎的一部。" },
  ],
  "x5-uk-005": [
    { name: "克拉丽莎·达洛维", role: "主人公", description: "（参见主条目 'mrs-dalloway'）伍尔夫以这个买花的女人一天中的意识流写出了整个英国社会阶层体系与一个女性灵魂的全部深度。" },
  ],
  "x5-uk-006": [
    { name: "尼古拉斯·厄夫", role: "主人公", description: "一个在希腊小岛上教书的年轻英国人——被神秘富翁康奇斯拖入一场精心设计的'心理游戏'。福尔斯以不断的反转让读者和尼古拉斯一起迷失——真实与虚构的边界在希腊的阳光下彻底消融。" },
  ],

  "x5-fr-001": [
    { name: "梅尔特伊侯爵夫人", role: "核心人物", description: "一个以操纵他人情感为乐的上流社会女性——她与瓦尔蒙子爵将诱惑与背叛当作一场残酷的游戏。拉克洛以书信体将所有阴谋暴露在读者面前——'危险关系'至今仍是关于情感操控最锋利的文学解剖。" },
  ],
  "x5-fr-002": [
    { name: "弗雷德里克·莫罗", role: "主人公", description: "一个在1848年革命前后的巴黎虚度一生的年轻人——将他所有的激情都投入一场永远不会实现的爱情。福楼拜以他命名了一个'没有行动力'的时代——'情感教育'是十九世纪最具现代性的反成长小说。" },
  ],

  "x5-de-001": [
    { name: "雅各布·冯·贡腾", role: "主人公", description: "罗伯特·瓦尔泽以这个进入仆从学校的年轻人写出了德语文学中最奇异的'反成长小说'——'我们渺小，非常渺小，但我们闪耀。'瓦尔泽被卡夫卡和穆齐尔誉为天才。" },
  ],
  "x5-de-002": [
    { name: "奥斯卡·马策拉特", role: "主人公", description: "（参见 'x3-pr-001'）君特·格拉斯但泽三部曲之首的主人公。" },
  ],

  "x5-ru-001": [
    { name: "赫列斯塔科夫", role: "主人公", description: "一个从彼得堡来的低级官吏——被当地官员误认为钦差大臣后顺势扮演这个角色。果戈理以这部喜剧对俄国官僚体制进行了最无情的讽刺——'你们都在笑什么？在笑你们自己！'" },
  ],
  "x5-ru-002": [
    { name: "伊凡·伊里奇", role: "主人公", description: "一个体面的法官——在临终的病床上发现他的一生——所有体面的职位、体面的婚姻——不过是一个精心维护的谎言。托尔斯泰晚期的'灵魂手术'。" },
  ],
  "x5-ru-003": [
    { name: "波兹内舍夫", role: "主人公/叙述者", description: "一个在火车上向陌生乘客坦白自己怎样因为嫉妒杀了妻子的人。托尔斯泰以他进行了一场关于性爱、婚姻和音乐的极端禁欲主义辩论——'克莱采奏鸣曲'在出版后被俄国审查机构所禁。" },
  ],

  "x5-it-001": [
    { name: "奥兰多", role: "主人公", description: "查理大帝最强大的骑士——因为安洁莉卡公主爱上了别人而发疯。阿里奥斯托以他创造了文艺复兴史诗中最迷人的'疯骑士'——全世界都要去找回他失去的理智。" },
  ],
  "x5-it-002": [
    { name: "戈弗雷", role: "主人公", description: "第一次十字军的领袖——塔索以他的神圣征途将宗教热忱与浪漫爱情的张力书写为一部巴洛克史诗的杰作——影响了弥尔顿和所有后来的欧洲史诗。" },
  ],
  "x5-it-003": [
    { name: "匹诺曹", role: "主人公", description: "杰佩托老木匠用一块会说话的木头雕出来的木偶——每一次说谎鼻子就会变长。科洛迪以这个全世界最著名的木偶书写了一则关于从'没有良心的木头'到'真正的男孩'的道德成长寓言。" },
  ],

  "x5-es-001": [
    { name: "唐璜", role: "主人公", description: "塞维利亚的贵族浪子——引诱每一个他能找到的女人然后逃之夭夭。蒂尔索·德·莫利纳以他创造了西方文学中最著名的浪子原型——最终被他杀害的骑士的石像拖入地狱。" },
  ],


  "x5-am-001": [
    { name: "利奥波德·布卢姆", role: "主人公", description: "（参见主条目 'ulysses'）乔伊斯以这个在都柏林度过1904年6月16日的广告推销员——现代的奥德修斯——为二十世纪文学立下了至高的丰碑。" },
  ],
  "x5-am-002": [
    { name: "拉里·达雷尔", role: "主人公", description: "（参见 'exp-uk-007'）毛姆以这个在一战后追寻精神真理的年轻人探索了在物质主义时代过精神生活的可能。" },
  ],
  "x5-am-003": [
    { name: "亨利·佩罗恩", role: "主人公", description: "（参见 'exp-uk-009'）麦克尤恩以这个神经外科医生的一天将后911时代的个人焦虑与全球政治微缩在一个人的意识之中。" },
  ],

  "x5-me-001": [
    { name: "无名画家", role: "主人公", description: "一个在鸦片烟雾中日复一日画着同一个场景的伊朗画家——在现实的裂隙中，这重复的意象打开了他的灵魂深处。希达亚特以这部中篇小说写下了波斯文学中最黑暗也最迷人的精神景观。" },
  ],
  "x5-me-002": [
    { name: "卡", role: "诗人/主人公", description: "一个旅居德国的土耳其诗人回到东部小城卡尔斯——在大雪封城的日子里，他被卷入了一场关于信仰、政治和爱情的微型内战。帕慕克以他作为一个在东方与西方之间的存在主义游荡者。" },
  ],
  "x5-me-003": [
    { name: "黑", role: "叙述者之一", description: "十六世纪伊斯坦布尔——一个从波斯归来的细密画家以众多声音（包括一条狗、一棵树、一枚金币和一具尸体）讲述了一桩谋杀案。帕慕克以多声部将伊斯兰细密画的哲学辩论、侦探叙事和无法得到的爱编织为后现代叙事的寺院。诺贝尔奖。" },
  ],

  "x5-oc-001": [
    { name: "彩虹勇士号船员", role: "集体主人公", description: "（参见 'the-rainbow-warrior'）绿色和平组织的旗舰被法国特工炸沉——关于环保、反核与主权的重要非虚构。" },
  ],

  "x5-pr-001": [
    { name: "丹尼尔·森普雷", role: "核心人物", description: "萨丰《风之影》中的少年——在巴塞罗那的'遗忘书之墓'中选了一本书，卷入了作者的神秘命运。这部献给爱书人的哥特童话在全球被翻译成四十多种语言。" },
  ],
  "x5-pr-002": [
    { name: "戴维·马丁", role: "主人公", description: "一个1920年代巴塞罗那的落魄作家——接受了一个神秘出版商的委托写一本'能创立宗教的书'。萨丰以他为'遗忘书之墓'宇宙续写了又一座献给文字和巴塞罗那的哥特迷宫。" },
  ],
  "x5-pr-003": [
    { name: "凡艾克兄弟", role: "核心人物", description: "以《根特祭坛画》这幅十五世纪的佛兰芒杰作为线索穿越欧洲五个世纪——一幅画所见证的战争、盗窃、信仰与艺术的全部历史。" },
  ],
  "x5-pr-004": [
    { name: "新娘", role: "主人公", description: "安达卢西亚的农家女——在自己的婚礼上跟从前的恋人莱昂纳多逃跑。洛尔迦以她书写了一则关于欲望、名誉与死亡的民间悲剧——以西班牙深歌的节奏敲打着每一个观众的胸膛。" },
  ],
  "x5-pr-005": [
    { name: "迈达", role: "核心人物", description: "阿契贝《荒原蚁丘》中的人物——在后殖民非洲大人物的腐败统治下，少数精英不得不面对'对抗还是合作'的道德抉择——阿契贝最后的作品之一。" },
  ],
  "x5-pr-006": [
    { name: "戈洛·曼", role: "作者/历史学家", description: "托马斯·曼的儿子——以文学家的笔触书写了一部关于德意志民族精神的千年史诗。他既是历史的法官也是文学的诗人——二十世纪最优雅的历史散文之一。" },
  ],
  "x5-pr-007": [
    { name: "海明威", role: "叙述者", description: "在东非的绿色群山中追踪羚羊和狮子——同时也在追踪自己的'写作之道'。海明威以这部狩猎叙事为文学创作本身写下了最坦诚的自白。" },
  ],

  // ==================== 最后补充 ====================

  "x3-uk-001": [
    { name: "安妮·艾略特", role: "主人公", description: "奥斯汀笔下最年长也最成熟的女主角——二十七岁的她失去了'青春的光泽'，但比八年前更坚定。当年她被'劝导'放弃了爱情，现在当温特沃斯上校再次出现时——她不会再犯同样的错误。'劝导'是奥斯汀最深沉、最像秋天的一部小说。" },
  ],
  "x3-de-001": [
    { name: "维特", role: "主人公", description: "一个敏感、热情、无法被世界容纳的年轻人。他在给友人威廉的书信中诉说了对绿蒂的不可救药的爱——她已是一个乡村法官的未婚妻。歌德以维特的自杀引爆了整个欧洲的浪漫主义——他的蓝外套和黄马甲被千百个青年穿上，他的名字成为一整个时代的灵魂签名。" },
  ],
  "x3-it-001": [
    { name: "匹诺曹", role: "主人公", description: "（参见 'x5-it-003'）老木匠杰佩托用一块会说话的木头雕出来的小木偶——每一次说谎鼻子就会变长。关于从木头变成真正男孩的道德寓言。" },
    { name: "杰佩托", role: "创造者/父亲", description: "一个贫穷的老木匠——他用一块会说话的木头雕出了匹诺曹，并从一开始就把他当作自己的儿子。科洛迪以他定义了'父爱'最朴实的形式。" },
  ],
  "x3-it-002": [
    { name: "六个角色", role: "集体主人公", description: "（参见 'x3-pr-009'）一部关于正在寻找作者的六个角色的元戏剧——皮兰德娄以他们打破了舞台与现实的边界。诺贝尔奖得主最著名的戏剧。" },
  ],
  "x3-es-001": [
    { name: "丹尼尔·森普雷", role: "主人公", description: "（参见 'x5-pr-001'）1945年巴塞罗那——一个书商之子在'遗忘书之墓'中找到了一本名为《风之影》的书，从此被卷入了一个跨越数十年的爱与死亡的谜团。" },
  ],
  "x3-am-001": [
    { name: "嘉莉妹妹", role: "主人公", description: "（参见 'sister-carrie'）一个从威斯康星小镇来到芝加哥的年轻女子——在生存和欲望的驱使下一步步攀爬社会阶梯。美国自然主义文学的开山之作。" },
  ],

};
