  "shijing": [
    { name: "佚名歌者", role: "集体抒情主体", description: "《诗经》的'作者'不是单一个体，而是从西周初年到春秋中叶五百年间的无数民间歌者、宫廷乐师与贵族诗人。他们在采薇、伐木、耕种、戍边、恋爱与祭祀中发出的声音构成了中国诗歌的源头。" },
  ],
  "chu-ci": [
    { name: "屈原", role: "核心诗人", description: "楚国贵族，中国文学史上第一位署名诗人。他的《离骚》以瑰丽的想象和深沉的哀怨开创了中国浪漫主义文学——'路漫漫其修远兮，吾将上下而求索'——他最终自沉汨罗江，成为中国文人精神的象征。" },
  ],
  "zhuangzi": [
    { name: "庄周", role: "作者/思想者", description: "道家学派集大成者。他以'逍遥游'的磅礴想象和'齐物论'的相对主义挑战所有既定认知——'不知周之梦为蝴蝶与，蝴蝶之梦为周与'——将哲学写成了文学的最高境界。" },
  ],
  "tang-poems": [
    { name: "李白", role: "诗仙", description: "唐代最伟大的浪漫主义诗人。'天生我材必有用，千金散尽还复来'——他的豪放与飘逸是中国诗歌中最响亮的声音。" },
    { name: "杜甫", role: "诗圣", description: "唐代最伟大的现实主义诗人。'国破山河在，城春草木深'——他以诗歌记录了安史之乱的深重苦难，时代的见证者。" },
    { name: "王维", role: "诗佛", description: "'诗中有画，画中有诗'——他以禅宗的空灵将山水诗推向精神的巅峰。" },
  ],
  "wang-wei-poems": [
    { name: "王维", role: "诗人", description: "字摩诘，盛唐诗人、画家。'行到水穷处，坐看云起时'——他的山水诗蕴含着佛教禅宗的空灵与超脱。" },
  ],
  "su-shi-poems": [
    { name: "苏轼", role: "诗人", description: "号东坡居士，北宋最全面的文学天才。'大江东去，浪淘尽，千古风流人物'——他的豪放词风开创了宋词的新境界。" },
