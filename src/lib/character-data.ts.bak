  ],
  "family": [
    { name: "高觉慧", role: "主人公", description: "高家三少爷，'激流'中最勇敢的叛逆者。他冲出封建家庭投奔新生活的决定激励了几代中国青年。" },
    { name: "高觉新", role: "重要人物", description: "高家长孙，'激流'中最痛苦的人——清醒地看到了旧制度的罪恶，却无力反抗。'作揖主义'是他生存的策略也是他的牢笼。" },
  ],
  "fortress-besieged": [
    { name: "方鸿渐", role: "主人公", description: "留学归国的知识分子，买了张假博士文凭。在爱情与事业中处处碰壁——'围城'就是他的整个人生。" },
    { name: "孙柔嘉", role: "女主角", description: "方鸿渐的妻子，一个看似温柔实则精于算计的女性。她的温柔是一张网——鸿渐到婚后才发现自己被'柔'字所困。" },
    { name: "苏文纨", role: "重要人物", description: "方鸿渐的大学同学，一个高傲而自负的女博士。她对鸿渐的追求失败后将鸿渐的情史公之于众——制造了全书最精彩的社交灾难。" },
  ],
  "to-live": [
    { name: "徐福贵", role: "主人公/叙述者", description: "从地主少爷到一贫如洗的农民——他一生经历了中国内战、土改、大跃进和文化大革命。他的父亲、儿子、女儿、妻子、女婿、外孙相继死去，最后只剩他和一头老牛。'活着'不是苟活，而是承受一切苦难的能力。" },
    { name: "家珍", role: "福贵的妻子", description: "城里米行老板的女儿，嫁给了败家的福贵。她以一生的忍耐和温柔守护着这个被历史反复碾压的家庭。" },
  ],
  "red-sorghum": [
    { name: "我爷爷（余占鳌）", role: "主人公", description: "高密东北乡的轿夫，后成为抗日土匪司令。他浑身散发着原生态的生命力——杀人放火也轰轰烈烈——莫言笔下'红高粱'精神的化身。" },
    { name: "我奶奶（戴凤莲）", role: "女主角", description: "被父亲卖给麻风病人的美丽女子。她以烈酒和刚烈对抗命运——在红高粱地里与轿夫的野合是她对包办婚姻的最激烈反抗。" },
