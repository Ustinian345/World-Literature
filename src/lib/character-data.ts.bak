  "ru-lin-wai-shi": [
    { name: "范进", role: "核心人物", description: "一个穷困潦倒的老书生，在得知自己中举后竟然高兴得疯了——'范进中举'是中国文学中对科举制度最辛辣的讽刺。" },
    { name: "杜少卿", role: "理想人物", description: "吴敬梓笔下的自画像——一个蔑视功名、逍遥自在的'真儒'，与那些被科举扭曲的文人形成鲜明对比。" },
