  "lao-can-you-ji": [
    { name: "老残", role: "主人公/叙述者", description: "一个浪迹江湖的郎中，以行医为名游历各地。他以'旁观者'的视角揭露了晚清官场的黑暗，而其写景之优美在中国小说中罕有其匹。" },
  ],
  "call-to-arms": [
    { name: "狂人", role: "《狂人日记》主人公", description: "鲁迅笔下第一个'觉醒者'——在'仁义道德'的字缝中看见了'吃人'两个字。" },
    { name: "阿Q", role: "《阿Q正传》主人公", description: "末庄的雇农，以'精神胜利法'面对一切屈辱和失败——'儿子打老子'——他是中国现代文学中最深刻的文化批判符号。" },
    { name: "孔乙己", role: "《孔乙己》主人公", description: "咸亨酒店里唯一穿长衫站着喝酒的人——'窃书不能算偷'——一个被科举制度毁灭的读书人的凄惨剪影。" },
  ],
  "wandering": [
    { name: "涓生", role: "《伤逝》主人公", description: "一个追求爱情自由却在现实面前无力的知识分子。他的忏悔——'人必生活着，爱才有所附丽'——是鲁迅最沉痛的句子之一。" },
    { name: "祥林嫂", role: "《祝福》主人公", description: "一个被封建礼教彻底吞噬的劳动妇女。'我真傻，真的'——她反复讲述儿子被狼叼走的故事，但所有人都厌倦了她的悲痛。" },
  ],
  "midnight-mao": [
