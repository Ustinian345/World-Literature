  { id: "nobel-1975-montale", title: "乌贼骨", titleEn: "Cuttlefish Bones", author: "埃乌杰尼奥·蒙塔莱", country: "意大利", flag: "🇮🇹", continent: "europe", era: "现代 (1900—1950)", genre: ["诗歌"], themes: ["自然", "哲学"], year: 1925, excerpt: "以利古里亚海岸的荒凉风景为隐喻，探索现代人在'生活之恶'中寻求一线解脱的诗歌艺术。", gradient: "from-blue-600 via-teal-500 to-amber-100" },

  // 1978 Isaac Bashevis Singer (美国/波兰犹太裔)
  { id: "nobel-1978-singer", title: "傻瓜吉姆佩尔", titleEn: "Gimpel the Fool", author: "艾萨克·巴什维斯·辛格", country: "美国（波兰裔）", flag: "🇺🇸", continent: "americas", era: "当代 (1950—)", genre: ["小说", "民间故事"], themes: ["宗教", "哲学", "魔幻"], year: 1957, excerpt: "以意第绪语写作的叙事大师，将东欧犹太世界的魔鬼、奇迹与日常悲欢化为不朽的短篇艺术。", gradient: "from-gray-800 via-yellow-600 to-red-600" },

  // 1980 Czesław Miłosz (波兰)
  { id: "nobel-1980-milosz", title: "被禁锢的头脑", titleEn: "The Captive Mind", author: "切斯瓦夫·米沃什", country: "波兰", flag: "🇵🇱", continent: "europe", era: "当代 (1950—)", genre: ["散文/随笔"], themes: ["社会", "哲学", "历史"], year: 1953, excerpt: "对极权主义如何腐蚀知识分子灵魂的经典剖析，米沃什以亲历者的清醒良知见证了整个20世纪的灾难。", gradient: "from-red-600 via-white to-red-600" },

  // 1981 Elias Canetti (英国/保加利亚裔)
  { id: "nobel-1981-canetti", title: "迷惘", titleEn: "Auto-da-Fé", author: "埃利亚斯·卡内蒂", country: "英国（保加利亚裔）", flag: "🇬🇧", continent: "europe", era: "现代 (1900—1950)", genre: ["小说"], themes: ["心理", "哲学"], year: 1935, excerpt: "以一位汉学家被女管家囚禁并焚毁其毕生藏书的荒诞故事，探索了知识分子的孤立与大众的疯狂。", gradient: "from-orange-700 via-red-600 to-black" },

  // 1984 Jaroslav Seifert (捷克)
  { id: "nobel-1984-seifert", title: "世界美如斯", titleEn: "All the Beauties of the World", author: "雅罗斯拉夫·塞弗尔特", country: "捷克", flag: "🇨🇿", continent: "europe", era: "当代 (1950—)", genre: ["诗歌"], themes: ["爱情", "自然"], year: 1981, excerpt: "以感官的丰盈对抗时间的消逝，塞弗尔特的诗是布拉格的灵魂——充满音乐、美酒与对生命的热爱。", gradient: "from-blue-400 via-red-400 to-white" },

  // 1992 Derek Walcott (圣卢西亚)
  { id: "nobel-1992-walcott", title: "奥梅罗斯", titleEn: "Omeros", author: "德里克·沃尔科特", country: "圣卢西亚", flag: "🇱🇨", continent: "americas", era: "当代 (1950—)", genre: ["诗歌", "史诗"], themes: ["历史", "自然", "哲学"], year: 1990, excerpt: "以加勒比海的渔村为舞台，将荷马史诗的传统移植到后殖民时代的现实，创造了一部属于新世界的神话。", gradient: "from-cyan-500 via-blue-600 to-yellow-400" },

  // 1995 Seamus Heaney (爱尔兰)
  { id: "nobel-1995-heaney", title: "一个自然主义者的死亡", titleEn: "Death of a Naturalist", author: "谢默斯·希尼", country: "爱尔兰", flag: "🇮🇪", continent: "europe", era: "当代 (1950—)", genre: ["诗歌"], themes: ["自然", "历史"], year: 1966, excerpt: "以北爱尔兰的泥沼和农场为起点，将爱尔兰的声音与古希腊的悲歌融合为撼人的诗艺。", gradient: "from-green-700 via-white to-orange-500" },

  // 1996 Wisława Szymborska (波兰)
  { id: "nobel-1996-szymborska", title: "万物静默如迷", titleEn: "View with a Grain of Sand", author: "维斯拉瓦·辛波斯卡", country: "波兰", flag: "🇵🇱", continent: "europe", era: "当代 (1950—)", genre: ["诗歌"], themes: ["哲学", "自然"], year: 1995, excerpt: "以轻盈的语调处理严肃的哲学命题，一只甲虫、一粒沙都可以成为宇宙诗意的入口。辛波斯卡的诗是日常生活的形而上学。", gradient: "from-gray-500 via-white to-gray-500" },

  // 2000 Gao Xingjian (法国/中国) — 首位中文作家得主
  { id: "nobel-2000-gao", title: "灵山", titleEn: "Soul Mountain", author: "高行健", country: "法国（华裔）", flag: "🇫🇷", continent: "europe", era: "当代 (1950—)", genre: ["小说"], themes: ["哲学", "心理", "自然"], year: 1990, excerpt: "以'你'与'我'的双声叙事行走在中国西南的山川之间，在禅意与存在之间寻找文字的灵山。首位以中文写作的诺贝尔文学奖得主。", gradient: "from-emerald-700 via-green-500 to-stone-300" },

  // 2001 V.S. Naipaul (英国/特立尼达)
  { id: "nobel-2001-naipaul", title: "毕司沃斯先生的房子", titleEn: "A House for Mr Biswas", author: "V.S. 奈保尔", country: "英国（特立尼达裔）", flag: "🇬🇧", continent: "europe", era: "当代 (1950—)", genre: ["小说"], themes: ["社会", "心理"], year: 1961, excerpt: "以特立尼达的印度移民社区为背景，讲述毕司沃斯先生一生追求拥有一栋属于自己的房子——一个关于殖民、流散与尊严的现代史诗。", gradient: "from-green-600 via-yellow-400 to-orange-500" },

  // 2002 Imre Kertész (匈牙利)
  { id: "nobel-2002-kertesz", title: "无命运的人生", titleEn: "Fatelessness", author: "凯尔泰斯·伊姆雷", country: "匈牙利", flag: "🇭🇺", continent: "europe", era: "当代 (1950—)", genre: ["小说"], themes: ["历史", "心理", "哲学"], year: 1975, excerpt: "以一名15岁犹太少年被送入集中营的经历，以近乎冷漠的精确语言书写了人类最黑暗的篇章。", gradient: "from-gray-800 via-slate-700 to-gray-600" },

  // 2004 Elfriede Jelinek (奥地利)
  { id: "nobel-2004-jelinek", title: "钢琴教师", titleEn: "The Piano Teacher", author: "埃尔弗里德·耶利内克", country: "奥地利", flag: "🇦🇹", continent: "europe", era: "当代 (1950—)", genre: ["小说"], themes: ["心理", "社会", "爱情"], year: 1983, excerpt: "以冰冷的语言解剖一位中年钢琴女教师与母亲之间窒息的控制关系，以及她病态的性幻想。耶利内克的语言是一把手术刀。", gradient: "from-red-700 via-black to-white" },

  // 2005 Harold Pinter (英国)
  { id: "nobel-2005-pinter", title: "看管人", titleEn: "The Caretaker", author: "哈罗德·品特", country: "英国", flag: "🇬🇧", continent: "europe", era: "当代 (1950—)", genre: ["戏剧"], themes: ["心理", "社会", "哲学"], year: 1960, excerpt: "三个男人在一间破旧公寓里展开的荒诞权力游戏。品特的'沉默'与'威胁'重新定义了现代戏剧。", gradient: "from-gray-900 via-slate-800 to-stone-700" },

  // 2008 J.M.G. Le Clézio (法国)
  { id: "nobel-2008-leclezio", title: "沙漠", titleEn: "Desert", author: "勒克莱齐奥", country: "法国", flag: "🇫🇷", continent: "europe", era: "当代 (1950—)", genre: ["小说"], themes: ["自然", "历史", "心理"], year: 1980, excerpt: "两个平行叙事交织——北非沙漠部落少女的史诗迁徙与现代城市移民的迷惘，书写了文明边缘的诗意。", gradient: "from-amber-500 via-orange-400 to-yellow-300" },

  // 2009 Herta Müller (德国/罗马尼亚裔)
  { id: "nobel-2009-muller", title: "呼吸秋千", titleEn: "The Hunger Angel", author: "赫塔·米勒", country: "德国（罗马尼亚裔）", flag: "🇩🇪", continent: "europe", era: "当代 (1950—)", genre: ["小说"], themes: ["历史", "心理", "社会"], year: 2009, excerpt: "以诗意的精确描绘罗马尼亚德裔人在苏联劳改营中五年的生存挣扎——饥饿是有天使的，它叫做'呼吸秋千'。", gradient: "from-gray-700 via-white to-gray-700" },

  // 2013 Alice Munro (加拿大)
  { id: "nobel-2013-munro", title: "逃离", titleEn: "Runaway", author: "艾丽丝·门罗", country: "加拿大", flag: "🇨🇦", continent: "americas", era: "当代 (1950—)", genre: ["小说"], themes: ["爱情", "心理", "社会"], year: 2004, excerpt: "当代短篇小说女王，以加拿大安大略省小镇为舞台，在看似平静的日常生活中揭示命运的惊心动魄。", gradient: "from-red-600 via-white to-red-600" },

  // 2015 Svetlana Alexievich (白俄罗斯)
  { id: "nobel-2015-alexievich", title: "切尔诺贝利的悲鸣", titleEn: "Voices from Chernobyl", author: "斯维特兰娜·阿列克谢耶维奇", country: "白俄罗斯", flag: "🇧🇾", continent: "europe", era: "当代 (1950—)", genre: ["散文/随笔"], themes: ["历史", "社会", "心理"], year: 1997, excerpt: "以口述史的方式记录切尔诺贝利核灾难的幸存者证言，将新闻升华为文学，让沉默的人开口说话。", gradient: "from-yellow-400 via-red-500 to-black" },

  // 2016 Bob Dylan (美国)
  { id: "nobel-2016-dylan", title: "鲍勃·迪伦诗歌集", titleEn: "The Lyrics: 1961-2012", author: "鲍勃·迪伦", country: "美国", flag: "🇺🇸", continent: "americas", era: "当代 (1950—)", genre: ["诗歌"], themes: ["社会", "爱情", "哲学"], year: 2016, excerpt: "在伟大的美国歌谣传统中创造了全新的诗意表达。诺贝尔奖授予迪伦，重新定义了文学与歌曲的边界。", gradient: "from-black via-gray-800 to-blue-900" },

  // 2018 Olga Tokarczuk (波兰)
  { id: "nobel-2018-tokarczuk", title: "云游", titleEn: "Flights", author: "奥尔加·托卡尔丘克", country: "波兰", flag: "🇵🇱", continent: "europe", era: "当代 (1950—)", genre: ["小说"], themes: ["哲学", "心理", "冒险"], year: 2007, excerpt: "由116个片段组成的星群式小说，以旅行与人体解剖为主题，在碎片中追寻现代人的流动与归宿。获2018年国际布克奖。", gradient: "from-white via-blue-100 to-red-300" },

  // 2019 Peter Handke (奥地利)
  { id: "nobel-2019-handke", title: "守门员面对罚点球时的焦虑", titleEn: "The Goalie's Anxiety at the Penalty Kick", author: "彼得·汉德克", country: "奥地利", flag: "🇦🇹", continent: "europe", era: "当代 (1950—)", genre: ["小说"], themes: ["心理", "哲学"], year: 1970, excerpt: "以极简语言呈现一个足球守门员失业后漫无目的的疏离之旅，汉德克的写作是对语言边界的不断探测。", gradient: "from-green-700 via-black to-white" },

  // 2020 Louise Glück (美国)
  { id: "nobel-2020-gluck", title: "野鸢尾", titleEn: "The Wild Iris", author: "露易丝·格丽克", country: "美国", flag: "🇺🇸", continent: "americas", era: "当代 (1950—)", genre: ["诗歌"], themes: ["自然", "哲学", "宗教"], year: 1992, excerpt: "以花园中的花朵与园丁-神的对话形式，在自然与神性之间展开了一场朴素而凌厉的灵魂札记。", gradient: "from-purple-500 via-white to-green-400" },

  // 2021 Abdulrazak Gurnah (坦桑尼亚/英国)
  { id: "nobel-2021-gurnah", title: "天堂", titleEn: "Paradise", author: "阿卜杜勒拉扎克·古尔纳", country: "坦桑尼亚/英国", flag: "🇹🇿", continent: "africa", era: "当代 (1950—)", genre: ["小说"], themes: ["历史", "社会", "心理"], year: 1994, excerpt: "以一战前东非殖民地为背景，讲述男孩尤素福被卖为奴后的流亡旅程，揭示被历史遮蔽的殖民创伤。", gradient: "from-amber-600 via-red-500 to-emerald-700" },

  // 2022 Annie Ernaux (法国)
  { id: "nobel-2022-ernaux", title: "悠悠岁月", titleEn: "The Years", author: "安妮·埃尔诺", country: "法国", flag: "🇫🇷", continent: "europe", era: "当代 (1950—)", genre: ["小说"], themes: ["社会", "历史", "心理"], year: 2008, excerpt: "以'无人称自传'的形式将个人记忆与社会变迁交织成一幅法国战后六十年的集体肖像，开创了'平地写作'的新范式。", gradient: "from-blue-500 via-white to-red-500" },

  // 2023 Jon Fosse (挪威)
  { id: "nobel-2023-fosse", title: "七部曲", titleEn: "Septology", author: "约恩·福瑟", country: "挪威", flag: "🇳🇴", continent: "europe", era: "当代 (1950—)", genre: ["小说"], themes: ["哲学", "宗教", "心理"], year: 2021, excerpt: "七卷本长河小说以无止境的意识流叙说一位老画家关于信仰、艺术与死亡的内省，是21世纪最重要的文学成就之一。", gradient: "from-blue-600 via-gray-400 to-white" },

  // 2024 Han Kang — already covered (The Vegetarian)

  // ===== 布克奖 补充作品 =====
  { id: "booker-1970-murdoch", title: "大海，大海", titleEn: "The Sea, The Sea", author: "艾丽丝·默多克", country: "英国", flag: "🇬🇧", continent: "europe", era: "当代 (1950—)", genre: ["小说"], themes: ["心理", "哲学", "爱情"], year: 1978, excerpt: "一位退休戏剧导演隐居海边，试图写回忆录却被过去的情欲和执念所吞没。默多克以哲学家的思辨与小说家的技艺获1978年布克奖。", gradient: "from-blue-700 via-teal-600 to-cyan-500" },
  { id: "booker-1980-golding", title: "启蒙之旅", titleEn: "Rites of Passage", author: "威廉·戈尔丁", country: "英国", flag: "🇬🇧", continent: "europe", era: "当代 (1950—)", genre: ["小说"], themes: ["心理", "社会", "冒险"], year: 1980, excerpt: "以19世纪一艘驶往澳大利亚的帆船为舞台，戈尔丁以航海日志体展开对阶级、权力与人性的冷酷审视。1980年布克奖。", gradient: "from-blue-600 via-gray-500 to-stone-400" },
  { id: "booker-1990-byatt", title: "占有", titleEn: "Possession", author: "A.S. 拜厄特", country: "英国", flag: "🇬🇧", continent: "europe", era: "当代 (1950—)", genre: ["小说"], themes: ["爱情", "历史"], year: 1990, excerpt: "两位当代学者追踪一对维多利亚时代诗人之间的秘密恋情，在学术侦探与维多利亚书信之间构建了关于爱与知的迷宫。", gradient: "from-purple-600 via-rose-500 to-amber-400" },
  { id: "booker-1992-ondaatje", title: "英国病人", titleEn: "The English Patient", author: "迈克尔·翁达杰", country: "加拿大（斯里兰卡裔）", flag: "🇨🇦", continent: "americas", era: "当代 (1950—)", genre: ["小说"], themes: ["战争", "爱情", "历史"], year: 1992, excerpt: "二战末期意大利托斯卡纳一座废弃别墅中，四位身份各异的人在废墟中相遇。翁达杰以诗意的散文解构了国界、身份与爱情。", gradient: "from-amber-600 via-red-500 to-brown-400" },
  { id: "booker-1993-doyle", title: "童年往事", titleEn: "Paddy Clarke Ha Ha Ha", author: "罗迪·道尔", country: "爱尔兰", flag: "🇮🇪", continent: "europe", era: "当代 (1950—)", genre: ["小说"], themes: ["社会", "心理"], year: 1993, excerpt: "以十岁男孩帕迪的第一人称叙事，生动再现了1968年都柏林郊区的童年世界，捕捉了孩子眼中家庭分裂的无声悲剧。", gradient: "from-green-600 via-white to-orange-500" },
  { id: "booker-1996-swift", title: "最后一单", titleEn: "Last Orders", author: "格雷厄姆·斯威夫特", country: "英国", flag: "🇬🇧", continent: "europe", era: "当代 (1950—)", genre: ["小说"], themes: ["心理", "社会", "历史"], year: 1996, excerpt: "四位老友按死者遗愿将骨灰撒向大海，一场公路旅行串联起半个世纪的英国平民生活史。1996年布克奖。", gradient: "from-blue-700 via-gray-500 to-amber-300" },
  { id: "booker-2002-martel", title: "少年Pi的奇幻漂流", titleEn: "Life of Pi", author: "扬·马特尔", country: "加拿大", flag: "🇨🇦", continent: "americas", era: "当代 (1950—)", genre: ["小说"], themes: ["冒险", "哲学", "宗教"], year: 2002, excerpt: "印度少年派与一头孟加拉虎在太平洋上漂流227天的奇幻故事。三个宗教与一次海难，构成了对信仰与叙事本质的追问。", gradient: "from-cyan-500 via-blue-600 to-orange-400" },
  { id: "booker-2003-pierre", title: "弗农·上帝·利特尔", titleEn: "Vernon God Little", author: "DBC·皮埃尔", country: "澳大利亚/墨西哥", flag: "🇦🇺", continent: "oceania", era: "当代 (1950—)", genre: ["小说"], themes: ["社会", "心理"], year: 2003, excerpt: "以校园枪击案后一名十五岁少年的黑色幽默视角，对媒体、消费主义与美国文化展开了辛辣的讽刺。", gradient: "from-red-600 via-blue-500 to-white" },
  { id: "booker-2004-hollinghurst", title: "美丽线条", titleEn: "The Line of Beauty", author: "艾伦·霍灵赫斯特", country: "英国", flag: "🇬🇧", continent: "europe", era: "当代 (1950—)", genre: ["小说"], themes: ["爱情", "社会", "历史"], year: 2004, excerpt: "以撒切尔时代的伦敦为背景，以亨利·詹姆斯的笔法描绘了1980年代英国政商精英圈中的同性恋情与欲望。", gradient: "from-purple-600 via-blue-500 to-gold-400" },
  { id: "booker-2005-banville", title: "海", titleEn: "The Sea", author: "约翰·班维尔", country: "爱尔兰", flag: "🇮🇪", continent: "europe", era: "当代 (1950—)", genre: ["小说"], themes: ["心理", "爱情", "哲学"], year: 2005, excerpt: "一位丧妻的艺术史学家回到童年海边度假地，在海浪与记忆中重溯一生的丧失与追忆。班维尔的散文如塞尚的画笔。", gradient: "from-blue-600 via-teal-500 to-gray-300" },
  { id: "booker-2008-adiga", title: "白虎", titleEn: "The White Tiger", author: "阿拉文德·阿迪加", country: "印度", flag: "🇮🇳", continent: "asia", era: "当代 (1950—)", genre: ["小说"], themes: ["社会", "心理"], year: 2008, excerpt: "以一个印度底层青年的犯罪自白书，刺穿了印度经济奇迹的光鲜表面，揭示了种姓制度与现代资本的残酷共生。", gradient: "from-red-600 via-orange-500 to-yellow-400" },
  { id: "booker-2009-mantel", title: "狼厅", titleEn: "Wolf Hall", author: "希拉里·曼特尔", country: "英国", flag: "🇬🇧", continent: "europe", era: "当代 (1950—)", genre: ["小说"], themes: ["历史", "心理", "社会"], year: 2009, excerpt: "以托马斯·克伦威尔的视角重述亨利八世时代的都铎宫廷风云。历史小说从此被重新定义。曼特尔凭此作成为首位两获布克奖的女性。", gradient: "from-red-800 via-black to-gold-500" },
  { id: "booker-2011-barnes", title: "终结的感觉", titleEn: "The Sense of an Ending", author: "朱利安·巴恩斯", country: "英国", flag: "🇬🇧", continent: "europe", era: "当代 (1950—)", genre: ["小说"], themes: ["心理", "哲学"], year: 2011, excerpt: "一位退休男子被一纸遗赠拉回四十年前的往事——记忆是不靠谱的叙述者，而历史是幸存者的建构。", gradient: "from-gray-600 via-blue-400 to-gray-200" },
  { id: "booker-2014-flanagan", title: "深入北方的小路", titleEn: "The Narrow Road to the Deep North", author: "理查德·弗拉纳根", country: "澳大利亚", flag: "🇦🇺", continent: "oceania", era: "当代 (1950—)", genre: ["小说"], themes: ["战争", "爱情", "历史"], year: 2014, excerpt: "以泰缅死亡铁路为背景，讲述澳大利亚战俘与日本军官之间的命运交织。弗拉纳根以父亲亲身经历为蓝本。", gradient: "from-green-700 via-red-500 to-yellow-300" },
  { id: "booker-2015-james", title: "七次谋杀简史", titleEn: "A Brief History of Seven Killings", author: "马龙·詹姆斯", country: "牙买加", flag: "🇯🇲", continent: "americas", era: "当代 (1950—)", genre: ["小说"], themes: ["历史", "社会", "心理"], year: 2015, excerpt: "以1976年鲍勃·马利遇刺未遂事件为起点，以数十个声音讲述了牙买加四十年的暴力与政治风云。", gradient: "from-yellow-500 via-green-600 to-black" },
  { id: "booker-2016-beatty", title: "背叛者", titleEn: "The Sellout", author: "保罗·比蒂", country: "美国", flag: "🇺🇸", continent: "americas", era: "当代 (1950—)", genre: ["小说"], themes: ["社会", "心理", "哲学"], year: 2016, excerpt: "首位获得布克奖的美国作家，以挑衅性的讽刺在一个'后种族'时代的洛杉矶重设种族隔离，拷问了美国最深的伤口。", gradient: "from-red-600 via-blue-600 to-white" },
  { id: "booker-2017-saunders", title: "林肯在中阴界", titleEn: "Lincoln in the Bardo", author: "乔治·桑德斯", country: "美国", flag: "🇺🇸", continent: "americas", era: "当代 (1950—)", genre: ["小说"], themes: ["历史", "心理", "魔幻"], year: 2017, excerpt: "林肯11岁儿子威利的灵魂在阴阳之间徘徊，与墓地中众鬼魂对话——一部关于悲伤与慈悲的超现实杰作。", gradient: "from-gray-800 via-indigo-700 to-purple-500" },
  { id: "booker-2019-evaristo", title: "女孩，女人，其他", titleEn: "Girl, Woman, Other", author: "伯纳丁·埃瓦里斯托", country: "英国", flag: "🇬🇧", continent: "europe", era: "当代 (1950—)", genre: ["小说"], themes: ["社会", "爱情", "心理"], year: 2019, excerpt: "十二位英国黑人女性的生活交织成一部去中心化的复调小说，每位角色都在重构英国性的定义。与阿特伍德共享布克奖。", gradient: "from-purple-600 via-orange-400 to-green-400" },
  { id: "booker-2020-shuggie", title: "舒吉·贝恩", titleEn: "Shuggie Bain", author: "道格拉斯·斯图尔特", country: "英国（苏格兰）", flag: "🇬🇧", continent: "europe", era: "当代 (1950—)", genre: ["小说"], themes: ["社会", "心理", "爱情"], year: 2020, excerpt: "以1980年代格拉斯哥为背景，讲述男孩舒吉在母亲酗酒与赤贫中的成长。斯图尔特的处女作即获布克奖。", gradient: "from-blue-800 via-gray-700 to-stone-500" },

  // ===== 普利策小说奖 补充作品 =====
  { id: "pulitzer-1921-wharton", title: "纯真年代", titleEn: "The Age of Innocence", author: "伊迪丝·华顿", country: "美国", flag: "🇺🇸", continent: "americas", era: "现代 (1900—1950)", genre: ["小说"], themes: ["爱情", "社会"], year: 1920, excerpt: "首位获得普利策小说奖的女性作家，以19世纪纽约上流社会为背景，描绘了一段被社会规则束缚的三角恋情。", gradient: "from-cream-100 via-amber-50 to-gold-200" },
  { id: "pulitzer-1925-ferber", title: "如此辽阔", titleEn: "So Big", author: "埃德娜·费伯", country: "美国", flag: "🇺🇸", continent: "americas", era: "现代 (1900—1950)", genre: ["小说"], themes: ["社会", "爱情"], year: 1924, excerpt: "一位芝加哥女子继承农场后独立奋斗的故事，书写了美国拓荒精神的女性叙事。", gradient: "from-amber-500 via-yellow-400 to-green-400" },
  { id: "pulitzer-1959-taylor", title: "旅程", titleEn: "The Travels of Jaimie McPheeters", author: "罗伯特·刘易斯·泰勒", country: "美国", flag: "🇺🇸", continent: "americas", era: "当代 (1950—)", genre: ["小说"], themes: ["冒险", "历史"], year: 1959, excerpt: "以一位13岁男孩西行淘金的视角，描绘了美国西部开拓时代的荒诞与冒险。", gradient: "from-yellow-600 via-amber-500 to-brown-400" },
  { id: "pulitzer-1967-malamud", title: "修配工", titleEn: "The Fixer", author: "伯纳德·马拉默德", country: "美国", flag: "🇺🇸", continent: "americas", era: "当代 (1950—)", genre: ["小说"], themes: ["历史", "心理", "宗教"], year: 1967, excerpt: "以沙俄时期一桩反犹冤案为蓝本，以一个犹太修理工的遭遇书写了关于不公与尊严的现代寓言。", gradient: "from-gray-800 via-stone-700 to-amber-500" },
  { id: "pulitzer-2002-russo", title: "帝国瀑布", titleEn: "Empire Falls", author: "理查德·拉索", country: "美国", flag: "🇺🇸", continent: "americas", era: "当代 (1950—)", genre: ["小说"], themes: ["社会", "心理"], year: 2001, excerpt: "以缅因州一座没落小镇的餐厅经理为主角，在日常生活的细流中捕捉美国小镇的灵魂。", gradient: "from-blue-600 via-gray-400 to-amber-300" },
  { id: "pulitzer-2004-robinson", title: "基列家书", titleEn: "Gilead", author: "玛丽莲·罗宾逊", country: "美国", flag: "🇺🇸", continent: "americas", era: "当代 (1950—)", genre: ["小说"], themes: ["宗教", "哲学", "心理"], year: 2004, excerpt: "一位年迈牧师写给幼子的长篇家书，以深厚的宗教精神书写了美国三代人的信仰、恩典与愧疚。", gradient: "from-amber-300 via-gold-200 to-warm-white" },
  { id: "pulitzer-2014-tartt", title: "金翅雀", titleEn: "The Goldfinch", author: "唐娜·塔特", country: "美国", flag: "🇺🇸", continent: "americas", era: "当代 (1950—)", genre: ["小说"], themes: ["心理", "冒险"], year: 2013, excerpt: "纽约大都会博物馆爆炸案中，13岁的西奥带着一幅荷兰名画《金翅雀》逃生，由此展开跨越十年的阴郁传奇。", gradient: "from-yellow-600 via-brown-500 to-black" },
  { id: "pulitzer-2020-whitehead", title: "镍币男孩", titleEn: "The Nickel Boys", author: "科尔森·怀特黑德", country: "美国", flag: "🇺🇸", continent: "americas", era: "当代 (1950—)", genre: ["小说"], themes: ["历史", "社会", "心理"], year: 2019, excerpt: "基于佛州一所真实存在的少年感化院的残酷历史，讲述六十年代两位黑人少年在系统性虐待中的友情与抵抗。第二个普利策奖。", gradient: "from-gray-600 via-green-700 to-black" },

  // ===== 雨果奖最佳长篇小说 补充 =====
  { id: "hugo-1953-bester", title: "被毁灭的人", titleEn: "The Demolished Man", author: "阿尔弗雷德·贝斯特", country: "美国", flag: "🇺🇸", continent: "americas", era: "当代 (1950—)", genre: ["小说"], themes: ["心理", "社会"], year: 1953, excerpt: "首届雨果奖最佳长篇小说。在一个人人都有心灵感应能力的未来，如何策划一桩完美的谋杀？科幻与侦探的经典融合。", gradient: "from-purple-700 via-red-600 to-yellow-500" },
  { id: "hugo-1962-heinlein", title: "异乡异客", titleEn: "Stranger in a Strange Land", author: "罗伯特·海因莱因", country: "美国", flag: "🇺🇸", continent: "americas", era: "当代 (1950—)", genre: ["小说"], themes: ["哲学", "宗教", "社会"], year: 1961, excerpt: "一个在火星长大的地球人回到故土，以异乡人的视角审视地球的宗教、性与社会制度，是反文化运动的圣经。", gradient: "from-red-600 via-orange-500 to-yellow-400" },
  { id: "hugo-1965-simak", title: "驿站", titleEn: "Way Station", author: "克利福德·西马克", country: "美国", flag: "🇺🇸", continent: "americas", era: "当代 (1950—)", genre: ["小说"], themes: ["哲学", "自然"], year: 1964, excerpt: "一位参加过南北战争的老兵在威斯康星乡间守护着一个外星中转站。以田园诗意书写宇宙和平的科幻经典。", gradient: "from-green-600 via-teal-500 to-blue-400" },
  { id: "hugo-1966-herbert", title: "沙丘", titleEn: "Dune", author: "弗兰克·赫伯特", country: "美国", flag: "🇺🇸", continent: "americas", era: "当代 (1950—)", genre: ["小说"], themes: ["冒险", "哲学", "宗教"], year: 1965, excerpt: "沙漠星球阿拉基斯上香料、宗教与帝国的史诗。赫伯特创造了科幻文学中最宏大的世界观——恐惧是心灵杀手。", gradient: "from-amber-600 via-orange-500 to-red-400" },
  { id: "hugo-1968-zelazny", title: "光明王", titleEn: "Lord of Light", author: "罗杰·泽拉兹尼", country: "美国", flag: "🇺🇸", continent: "americas", era: "当代 (1950—)", genre: ["小说"], themes: ["宗教", "哲学", "魔幻"], year: 1967, excerpt: "在遥远的星球上，一群拥有神级科技的人类以印度教万神殿自居。一场关于科技、宗教与革命的华丽寓言。", gradient: "from-yellow-500 via-orange-400 to-red-500" },
  { id: "hugo-1970-le-guin", title: "黑暗的左手", titleEn: "The Left Hand of Darkness", author: "厄休拉·勒古恩", country: "美国", flag: "🇺🇸", continent: "americas", era: "当代 (1950—)", genre: ["小说"], themes: ["哲学", "社会", "心理"], year: 1969, excerpt: "在无固定性别的外星文明中，一个地球使节试图说服他们加入星际联盟。勒古恩以科幻为棱镜，审视了性别与身份的流动本质。", gradient: "from-white via-blue-100 to-gray-500" },
  { id: "hugo-1973-asimov", title: "神们自己", titleEn: "The Gods Themselves", author: "艾萨克·阿西莫夫", country: "美国", flag: "🇺🇸", continent: "americas", era: "当代 (1950—)", genre: ["小说"], themes: ["哲学", "自然"], year: 1973, excerpt: "阿西莫夫本人最满意的小说。一个跨维度能源交换将毁灭两个宇宙——三个截然不同的生命形态共同演绎了科学的傲慢。", gradient: "from-purple-600 via-blue-500 to-cyan-400" },
  { id: "hugo-1975-le-guin-2", title: "一无所有", titleEn: "The Dispossessed", author: "厄休拉·勒古恩", country: "美国", flag: "🇺🇸", continent: "americas", era: "当代 (1950—)", genre: ["小说"], themes: ["社会", "哲学"], year: 1974, excerpt: "两个互为月亮的星球上，一个无政府主义社会与一个资本主义社会的对峙与对话。勒古恩以科幻书写了政治哲学的极致想象。", gradient: "from-gray-700 via-stone-500 to-yellow-300" },
  { id: "hugo-1979-mcintyre", title: "梦蛇", titleEn: "Dreamsnake", author: "温达·麦金泰尔", country: "美国", flag: "🇺🇸", continent: "americas", era: "当代 (1950—)", genre: ["小说"], themes: ["冒险", "哲学"], year: 1978, excerpt: "后末日时代，一位以蛇毒治疗的女医者踏上寻找稀有梦蛇的旅程。女性主义科幻的里程碑之作。", gradient: "from-purple-500 via-green-400 to-amber-300" },
  { id: "hugo-1984-brin", title: "星潮汹涌", titleEn: "Startide Rising", author: "大卫·布林", country: "美国", flag: "🇺🇸", continent: "americas", era: "当代 (1950—)", genre: ["小说"], themes: ["冒险", "自然"], year: 1984, excerpt: "一艘由海豚驾驶的星舰被围困在未知星球上，而船员中有人携带了宇宙中最危险的秘密。生物科幻的经典。", gradient: "from-blue-600 via-cyan-400 to-teal-500" },
  { id: "hugo-1989-robinson", title: "红色火星", titleEn: "Red Mars", author: "金·斯坦利·罗宾逊", country: "美国", flag: "🇺🇸", continent: "americas", era: "当代 (1950—)", genre: ["小说"], themes: ["自然", "社会", "哲学"], year: 1993, excerpt: "火星三部曲之首，以百名科学家殖民火星的宏大叙事，将地质学、政治学与人性熔铸为近未来史诗。", gradient: "from-red-600 via-orange-500 to-amber-400" },
  { id: "hugo-1996-stephenson", title: "钻石时代", titleEn: "The Diamond Age", author: "尼尔·斯蒂芬森", country: "美国", flag: "🇺🇸", continent: "americas", era: "当代 (1950—)", genre: ["小说"], themes: ["社会", "哲学"], year: 1995, excerpt: "在纳米技术统治的未来，一本互动式启蒙读本彻底改变了一个底层女孩的命运。后赛博朋克杰作。", gradient: "from-purple-600 via-blue-500 to-cyan-400" },
  { id: "hugo-2000-stephenson-2", title: "编码宝典", titleEn: "Cryptonomicon", author: "尼尔·斯蒂芬森", country: "美国", flag: "🇺🇸", continent: "americas", era: "当代 (1950—)", genre: ["小说"], themes: ["历史", "社会"], year: 1999, excerpt: "二战密码学家与现代数据加密朋克之间的双线叙事，将数学、战争与互联网的诞生编织为技术史诗。", gradient: "from-gray-800 via-green-700 to-yellow-500" },
  { id: "hugo-2012-walton", title: "我不属于他们", titleEn: "Among Others", author: "乔·沃顿", country: "加拿大/英国", flag: "🇬🇧", continent: "europe", era: "当代 (1950—)", genre: ["小说"], themes: ["魔幻", "心理"], year: 2012, excerpt: "一个热爱科幻小说的女孩在经历创伤后被送往英国寄宿学校，却发现魔法与现实之间的界限越来越模糊。", gradient: "from-green-600 via-teal-500 to-purple-400" },
  { id: "hugo-2016-jemisin", title: "第五季", titleEn: "The Fifth Season", author: "N.K. 杰米辛", country: "美国", flag: "🇺🇸", continent: "americas", era: "当代 (1950—)", genre: ["小说"], themes: ["魔幻", "自然", "社会"], year: 2016, excerpt: "在永恒地质灾难的世界中，'原人'能以意念控制地震。杰米辛凭此三部曲史无前例地连续三年获得雨果奖。", gradient: "from-red-700 via-orange-500 to-yellow-300" },

  // ===== 茅盾文学奖 补充作品 =====
  { id: "maodun-1982-liu", title: "李自成", titleEn: "Li Zicheng", author: "姚雪垠", country: "中国", flag: "🇨🇳", continent: "asia", era: "当代 (1950—)", genre: ["小说"], themes: ["历史", "战争", "社会"], year: 1963, excerpt: "首届茅盾文学奖获奖作品。以明末农民起义领袖李自成为主角的多卷本历史小说，气势磅礴地再现了明朝覆亡的历史画卷。", gradient: "from-red-800 via-orange-700 to-yellow-600" },
  { id: "maodun-1982-zhou", title: "许茂和他的女儿们", titleEn: "Xu Mao and His Daughters", author: "周克芹", country: "中国", flag: "🇨🇳", continent: "asia", era: "当代 (1950—)", genre: ["小说"], themes: ["社会", "爱情"], year: 1979, excerpt: "以四川农村为背景，书写了文革末期一个普通农民家庭四个女儿的命运，被誉为新时期农村题材文学的开山之作。", gradient: "from-green-600 via-yellow-400 to-amber-300" },
  { id: "maodun-1991-liu", title: "第二个太阳", titleEn: "The Second Sun", author: "刘白羽", country: "中国", flag: "🇨🇳", continent: "asia", era: "当代 (1950—)", genre: ["小说"], themes: ["历史", "战争"], year: 1987, excerpt: "以解放战争时期解放军南下为背景，以宏大的革命史诗笔触书写了新旧中国的交替。", gradient: "from-red-700 via-yellow-500 to-red-600" },
  { id: "maodun-1997-wang", title: "战争和人", titleEn: "War and Man", author: "王火", country: "中国", flag: "🇨🇳", continent: "asia", era: "当代 (1950—)", genre: ["小说"], themes: ["战争", "历史", "社会"], year: 1993, excerpt: "三卷本抗战史诗，以广阔的视野与深刻的笔触书写了中华民族在战火中的人性光辉与精神涅槃。", gradient: "from-stone-700 via-red-800 to-amber-600" },
  { id: "maodun-2005-xiong", title: "张居正", titleEn: "Zhang Juzheng", author: "熊召政", country: "中国", flag: "🇨🇳", continent: "asia", era: "当代 (1950—)", genre: ["小说"], themes: ["历史", "社会"], year: 2002, excerpt: "四卷本长篇历史小说，以明朝万历首辅张居正的改革与悲剧人生为中心，深刻呈现了帝制中国的权力运作与历史悖论。", gradient: "from-yellow-700 via-red-700 to-black" },
  { id: "maodun-2005-zhang", title: "无字", titleEn: "Without Words", author: "张洁", country: "中国", flag: "🇨🇳", continent: "asia", era: "当代 (1950—)", genre: ["小说"], themes: ["爱情", "心理", "历史"], year: 2002, excerpt: "以三代女性的爱情悲剧为主线，贯穿百年中国社会变迁。张洁是首位两获茅盾文学奖的作家。", gradient: "from-gray-600 via-white to-red-400" },
  { id: "maodun-2005-zong", title: "东藏记", titleEn: "Notes from the East", author: "宗璞", country: "中国", flag: "🇨🇳", continent: "asia", era: "当代 (1950—)", genre: ["小说"], themes: ["战争", "历史"], year: 2000, excerpt: "以抗战时期西南联大知识分子群体的命运为核心，书写了一代学人在民族危亡中的坚守与精神漂泊。", gradient: "from-green-600 via-teal-500 to-blue-400" },
  { id: "maodun-2008-chi", title: "额尔古纳河右岸", titleEn: "The Right Bank of the Argun", author: "迟子建", country: "中国", flag: "🇨🇳", continent: "asia", era: "当代 (1950—)", genre: ["小说"], themes: ["自然", "历史", "社会"], year: 2005, excerpt: "以鄂温克族最后一位女酋长的口述，娓娓道出了一个游猎民族的百年沧桑——从山林中的原始生活到现代文明的冲击。", gradient: "from-blue-600 via-white to-green-500" },
  { id: "maodun-2011-liu", title: "天行者", titleEn: "Skywalker", author: "刘醒龙", country: "中国", flag: "🇨🇳", continent: "asia", era: "当代 (1950—)", genre: ["小说"], themes: ["社会", "心理"], year: 2009, excerpt: "以山区民办教师的命运为核心，书写了一群在最艰苦环境中坚守教育理想的中国乡村教师的感人故事。", gradient: "from-blue-500 via-white to-green-400" },
