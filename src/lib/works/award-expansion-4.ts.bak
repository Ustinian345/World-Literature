  { id: "lux-3-p-na", title: "娜夜诗选", titleEn: "Selected Poems of Na Ye", author: "娜夜", country: "中国（满族）", flag: "🇨🇳", continent: "asia", era: "当代 (1950—)", genre: ["诗歌"], themes: ["爱情", "自然"], year: 2003, excerpt: "以少数民族女性诗人的独特声音，在边地的月光下书写爱与孤独的诗篇。", gradient: "from-white via-blue-100 to-purple-300" },
  // ----- 第三届散文 -----
  { id: "lux-3-d-shi", title: "病隙碎笔", titleEn: "Fragments Written at the Sickbed", author: "史铁生", country: "中国", flag: "🇨🇳", continent: "asia", era: "当代 (1950—)", genre: ["散文/随笔"], themes: ["哲学", "心理", "宗教"], year: 2003, excerpt: "在透析的间隙写下的生命沉思——关于信仰、苦难与人的尊严，史铁生将他与死亡的日日相伴化作了最深的生命哲学。", gradient: "from-white via-amber-200 to-gray-500" },
