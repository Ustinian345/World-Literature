  { id: "lux-3-r-wang", title: "宝山", titleEn: "Baoshan", author: "李春雷", country: "中国", flag: "🇨🇳", continent: "asia", era: "当代 (1950—)", genre: ["散文/随笔"], themes: ["社会", "历史"], year: 2003, excerpt: "以宝钢为蓝本的中国工业史诗——在钢铁与炉火之间书写了中国改革开放的工业梦想。", gradient: "from-gray-700 via-red-500 to-yellow-400" },

  // ----- 第四届 诗歌+散文 -----
  { id: "lux-4-p-tian", title: "喊故乡", titleEn: "Calling Home", author: "田禾", country: "中国", flag: "🇨🇳", continent: "asia", era: "当代 (1950—)", genre: ["诗歌"], themes: ["自然", "社会"], year: 2007, excerpt: "以江汉平原为精神原乡——用朴素而沉郁的诗句喊出对故乡最深沉的眷恋。", gradient: "from-green-500 via-yellow-400 to-amber-400" },
  { id: "lux-4-p-yu", title: "只有大海苍茫如幕", titleEn: "Only the Sea Vast as a Curtain", author: "于坚", country: "中国", flag: "🇨🇳", continent: "asia", era: "当代 (1950—)", genre: ["诗歌"], themes: ["自然", "哲学"], year: 2007, excerpt: "第三代诗歌的领军人物——以口语的粗粝与形而上的沉思，在平凡事物中开采诗意的矿脉。", gradient: "from-blue-500 via-white to-gray-500" },
  { id: "lux-4-d-han", title: "山南水北", titleEn: "South of the Mountains, North of the Water", author: "韩少功", country: "中国", flag: "🇨🇳", continent: "asia", era: "当代 (1950—)", genre: ["散文/随笔"], themes: ["自然", "社会", "哲学"], year: 2007, excerpt: "韩少功归隐湖南汨罗乡间的八年记录——在山水之间以体力劳动与日常观察重建当代知识分子与土地的联系。", gradient: "from-green-600 via-yellow-400 to-amber-400" },
  { id: "lux-4-r-wang-shu", title: "长征", titleEn: "The Long March", author: "王树增", country: "中国", flag: "🇨🇳", continent: "asia", era: "当代 (1950—)", genre: ["散文/随笔"], themes: ["战争", "历史"], year: 2007, excerpt: "以非虚构的严谨与文学的笔力重述长征——在血与火中书写了人类史上最壮丽的军事远征。", gradient: "from-red-800 via-gray-600 to-gold-400" },

  // ----- 第五届 诗歌+散文 -----
  { id: "lux-5-p-lei", title: "云南记", titleEn: "Yunnan Notes", author: "雷平阳", country: "中国", flag: "🇨🇳", continent: "asia", era: "当代 (1950—)", genre: ["诗歌"], themes: ["自然", "社会"], year: 2010, excerpt: "以云贵高原为精神腹地——在边地的苍凉与神秘之中书写了一个诗人的大地之歌。", gradient: "from-green-600 via-blue-400 to-purple-400" },
  { id: "lux-5-p-fu", title: "柠檬叶子", titleEn: "Lemon Leaves", author: "傅天琳", country: "中国", flag: "🇨🇳", continent: "asia", era: "当代 (1950—)", genre: ["诗歌"], themes: ["自然", "爱情"], year: 2010, excerpt: "以果园与女性生命经验为母题——在柠檬叶的清香中沉淀了半个世纪的诗歌修行。", gradient: "from-green-400 via-yellow-300 to-white" },
  { id: "lux-5-r-li", title: "震中在人心", titleEn: "The Epicenter Is in the Heart", author: "李鸣生", country: "中国", flag: "🇨🇳", continent: "asia", era: "当代 (1950—)", genre: ["散文/随笔"], themes: ["社会", "心理"], year: 2010, excerpt: "以汶川地震为题材的非虚构力作——震中不在映秀，而在每个人的心里。", gradient: "from-gray-700 via-red-500 to-black" },

  // ----- 第六届 诗歌+散文 -----
  { id: "lux-6-p-li-yuan", title: "无限事", titleEn: "Infinite Matters", author: "李元胜", country: "中国", flag: "🇨🇳", continent: "asia", era: "当代 (1950—)", genre: ["诗歌"], themes: ["自然", "哲学"], year: 2014, excerpt: "以昆虫学家的精确与诗人的敏感书写的自然之诗——在蝴蝶的翅膀上看见了整个宇宙。", gradient: "from-green-500 via-yellow-300 to-white" },
  { id: "lux-6-d-liu", title: "在新疆", titleEn: "In Xinjiang", author: "刘亮程", country: "中国", flag: "🇨🇳", continent: "asia", era: "当代 (1950—)", genre: ["散文/随笔"], themes: ["自然", "社会", "哲学"], year: 2014, excerpt: "一个人在新疆的村庄里——以最朴素的语言书写了人与大地之间最深厚的情感。刘亮程的散文是中国当代最具辨识度的声音之一。", gradient: "from-amber-500 via-green-400 to-blue-400" },
  { id: "lux-6-d-zhou", title: "巨鲸歌唱", titleEn: "The Whale Sings", author: "周晓枫", country: "中国", flag: "🇨🇳", continent: "asia", era: "当代 (1950—)", genre: ["散文/随笔"], themes: ["自然", "哲学"], year: 2014, excerpt: "以华丽而精确的散文笔法潜入动物世界的深处——在巨鲸的歌声中听见了超越物种的生命共鸣。", gradient: "from-blue-600 via-purple-400 to-white" },

  // ----- 第七届 诗歌+散文 -----
  { id: "lux-7-p-tang", title: "去人间", titleEn: "Going to the Mortal World", author: "汤养宗", country: "中国", flag: "🇨🇳", continent: "asia", era: "当代 (1950—)", genre: ["诗歌"], themes: ["哲学", "社会"], year: 2018, excerpt: "以海洋与渔村的经验为诗学原点——汤养宗的诗将身体性经验与形而上学完美融合。", gradient: "from-blue-500 via-white to-amber-400" },
  { id: "lux-7-d-li-juan", title: "遥远的向日葵地", titleEn: "The Distant Sunflower Field", author: "李娟", country: "中国", flag: "🇨🇳", continent: "asia", era: "当代 (1950—)", genre: ["散文/随笔"], themes: ["自然", "社会"], year: 2018, excerpt: "在北疆阿勒泰的戈壁滩上，母亲种下九十亩向日葵——李娟以最清澈的文字书写了边疆生活的艰难与诗意。", gradient: "from-yellow-500 via-green-400 to-blue-300" },
  { id: "lux-7-d-li-xiu", title: "山河袈裟", titleEn: "The Kasaya of Mountains and Rivers", author: "李修文", country: "中国", flag: "🇨🇳", continent: "asia", era: "当代 (1950—)", genre: ["散文/随笔"], themes: ["社会", "哲学"], year: 2018, excerpt: "行走在中国大地上的精神笔记——在凡人凡事中见佛性，山河如袈裟般披在每一个人的肩上。", gradient: "from-green-600 via-gray-500 to-amber-400" },

  // ----- 第八届 诗歌+散文 -----
  { id: "lux-8-p-han-dong", title: "奇迹", titleEn: "Miracle", author: "韩东", country: "中国", flag: "🇨🇳", continent: "asia", era: "当代 (1950—)", genre: ["诗歌"], themes: ["哲学", "社会"], year: 2022, excerpt: "第三代诗歌运动的核心人物——以'诗到语言为止'的信念，在极简中抵达诗歌最本质的力量。", gradient: "from-gray-600 via-white to-black" },
  { id: "lux-8-p-lu", title: "天空下", titleEn: "Under the Sky", author: "路也", country: "中国", flag: "🇨🇳", continent: "asia", era: "当代 (1950—)", genre: ["诗歌"], themes: ["自然", "爱情"], year: 2022, excerpt: "以自由舒展的女性声音在天空下书写——在草木与星座之间寻找诗意栖居的可能。", gradient: "from-blue-300 via-white to-green-400" },
  { id: "lux-8-d-jiang", title: "回乡记", titleEn: "Returning Home", author: "江子", country: "中国", flag: "🇨🇳", continent: "asia", era: "当代 (1950—)", genre: ["散文/随笔"], themes: ["社会", "历史"], year: 2022, excerpt: "以非虚构的写实与散文的诗意记录中国乡村的变迁——回乡之路，是一条通往时间深处的路。", gradient: "from-green-500 via-amber-300 to-gray-400" },
  { id: "lux-8-d-shen", title: "大湖消息", titleEn: "News from the Great Lake", author: "沈念", country: "中国", flag: "🇨🇳", continent: "asia", era: "当代 (1950—)", genre: ["散文/随笔"], themes: ["自然", "社会"], year: 2022, excerpt: "以洞庭湖为舞台的生态散文——在大湖的潮涨潮落中，书写了人与自然共生的当代寓言。", gradient: "from-blue-500 via-green-400 to-yellow-300" },
  { id: "lux-8-r-ding", title: "红船启航", titleEn: "The Red Boat Sets Sail", author: "丁晓平", country: "中国", flag: "🇨🇳", continent: "asia", era: "当代 (1950—)", genre: ["散文/随笔"], themes: ["历史", "社会"], year: 2022, excerpt: "以中共建党史为题材的纪实文学——从南湖的红船启航，书写了一个世纪前那群年轻人的信仰与牺牲。", gradient: "from-red-700 via-gold-400 to-red-600" },
  { id: "lux-8-r-gong", title: "中国北斗", titleEn: "China's BeiDou", author: "龚盛辉", country: "中国", flag: "🇨🇳", continent: "asia", era: "当代 (1950—)", genre: ["散文/随笔"], themes: ["历史", "冒险"], year: 2022, excerpt: "以中国自主卫星导航系统的研发历程为蓝本——在星辰大海的征途中记录了科技人的奋斗与荣耀。", gradient: "from-blue-700 via-black to-gold-400" },
];

