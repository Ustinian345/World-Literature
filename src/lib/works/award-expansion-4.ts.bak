export const luxunS1: W[] = [
  // 中篇 剩余7部
  { id: "lux-1-m-lin", title: "小的儿", titleEn: "The Little One", author: "林希", country: "中国", flag: "🇨🇳", continent: "asia", era: "当代 (1950—)", genre: ["小说"], themes: ["社会", "历史"], year: 1995, excerpt: "以天津卫的市井人物为舞台，书写了底层小人物在时代洪流中的悲欢离合。首届鲁迅文学奖中篇小说奖。", gradient: "from-gray-600 via-red-400 to-amber-400" },
  { id: "lux-1-m-he", title: "年前年后", titleEn: "Before and After New Year", author: "何申", country: "中国", flag: "🇨🇳", continent: "asia", era: "当代 (1950—)", genre: ["小说"], themes: ["社会"], year: 1995, excerpt: "以乡镇干部在春节前后的忙碌与周旋为切面，描绘了中国基层社会的权力生态与人间烟火。", gradient: "from-red-600 via-yellow-400 to-green-400" },
  { id: "lux-1-m-li-guo", title: "涅槃", titleEn: "Nirvana", author: "李国文", country: "中国", flag: "🇨🇳", continent: "asia", era: "当代 (1950—)", genre: ["小说"], themes: ["哲学", "心理"], year: 1995, excerpt: "以知识分子在时代变动中的精神再生为主题，以深厚的笔力书写了灵魂在磨难中的蜕变与升华。", gradient: "from-amber-500 via-red-500 to-black" },
  { id: "lux-1-m-liu", title: "天知地知", titleEn: "Heaven Knows, Earth Knows", author: "刘恒", country: "中国", flag: "🇨🇳", continent: "asia", era: "当代 (1950—)", genre: ["小说"], themes: ["社会", "心理"], year: 1995, excerpt: "以冷峻的写实笔法深入刻画了乡村人物的生存困境与内心挣扎——刘恒以'零度叙事'逼近人性的本真。", gradient: "from-gray-800 via-stone-600 to-amber-400" },
  { id: "lux-1-m-yan", title: "黄金洞", titleEn: "The Gold Cave", author: "阎连科", country: "中国", flag: "🇨🇳", continent: "asia", era: "当代 (1950—)", genre: ["小说"], themes: ["社会", "心理"], year: 1995, excerpt: "以一座金矿为舞台，书写了金钱对人性的侵蚀与扭曲——在黄金的光芒下，所有的道德都在熔解。", gradient: "from-yellow-500 via-red-600 to-black" },
  { id: "lux-1-m-li-guan", title: "天缺一角", titleEn: "A Corner Missing from the Sky", author: "李贯通", country: "中国", flag: "🇨🇳", continent: "asia", era: "当代 (1950—)", genre: ["小说"], themes: ["社会", "哲学"], year: 1995, excerpt: "在荒诞与现实之间探索人的精神困境——天缺一角，人缺的是什么？", gradient: "from-blue-500 via-gray-400 to-amber-300" },
  { id: "lux-1-m-xu", title: "双鱼星座", titleEn: "Pisces", author: "徐小斌", country: "中国", flag: "🇨🇳", continent: "asia", era: "当代 (1950—)", genre: ["小说"], themes: ["心理", "爱情"], year: 1995, excerpt: "以星座为隐喻的女性心理叙事——在现代都市的浮光掠影中勘探女性内心的神秘星空。", gradient: "from-purple-500 via-pink-300 to-blue-400" },

  // 短篇 剩余5部
  { id: "lux-1-s-shi", title: "老屋小记", titleEn: "Notes from the Old House", author: "史铁生", country: "中国", flag: "🇨🇳", continent: "asia", era: "当代 (1950—)", genre: ["小说"], themes: ["心理", "哲学"], year: 1995, excerpt: "以轮椅上的视角回忆老屋的岁月流逝——史铁生以最深沉的思索叩问生命的意义与局限。", gradient: "from-gray-700 via-amber-400 to-blue-400" },
  { id: "lux-1-s-a", title: "赵一曼女士", titleEn: "Ms. Zhao Yiman", author: "阿成", country: "中国", flag: "🇨🇳", continent: "asia", era: "当代 (1950—)", genre: ["小说"], themes: ["历史", "战争"], year: 1995, excerpt: "以东北抗联女英雄赵一曼为主角的短篇叙事——以克制的笔触重塑了一个革命者的血肉之躯。", gradient: "from-red-700 via-white to-blue-500" },
  { id: "lux-1-s-chen", title: "镇长之死", titleEn: "Death of the Town Mayor", author: "陈世旭", country: "中国", flag: "🇨🇳", continent: "asia", era: "当代 (1950—)", genre: ["小说"], themes: ["社会", "心理"], year: 1995, excerpt: "以一个小镇镇长的死亡事件为切口，层层剥开基层权力网络中的复杂人性。", gradient: "from-gray-600 via-red-400 to-stone-400" },
  { id: "lux-1-s-bi", title: "哺乳期的女人", titleEn: "A Breastfeeding Woman", author: "毕飞宇", country: "中国", flag: "🇨🇳", continent: "asia", era: "当代 (1950—)", genre: ["小说"], themes: ["社会", "心理"], year: 1995, excerpt: "以一个男孩对一个哺乳期女人的隐秘凝视，书写了母爱缺失与生命最初的渴望。毕飞宇早期代表作。", gradient: "from-white via-pink-200 to-amber-300" },
  { id: "lux-1-s-chi", title: "心比身先老", titleEn: "The Heart Ages Before the Body", author: "池莉", country: "中国", flag: "🇨🇳", continent: "asia", era: "当代 (1950—)", genre: ["小说"], themes: ["社会", "心理"], year: 1995, excerpt: "以武汉市民的日常生活为底色，书写了一个普通女性在城市角落里独自老去的故事。", gradient: "from-amber-300 via-rose-200 to-gray-400" },

  // 诗歌 8部
  { id: "lux-1-p-li", title: "生命是一片叶子", titleEn: "Life Is a Leaf", author: "李瑛", country: "中国", flag: "🇨🇳", continent: "asia", era: "当代 (1950—)", genre: ["诗歌"], themes: ["哲学", "自然"], year: 1995, excerpt: "以战士的赤诚与诗人的敏感书写了半个世纪的中国记忆——生命是一片叶子，在风中舞蹈。首届鲁迅文学奖诗歌奖。", gradient: "from-green-500 via-white to-amber-300" },
  { id: "lux-1-p-kuang", title: "今天没有空难", titleEn: "No Air Crash Today", author: "匡满", country: "中国", flag: "🇨🇳", continent: "asia", era: "当代 (1950—)", genre: ["诗歌"], themes: ["社会", "哲学"], year: 1995, excerpt: "以敏锐的社会观察与深沉的人文关怀书写了现代生活中的偶然与必然。", gradient: "from-blue-500 via-white to-gray-400" },
  { id: "lux-1-p-han", title: "韩作荣自选诗", titleEn: "Selected Poems of Han Zuorong", author: "韩作荣", country: "中国", flag: "🇨🇳", continent: "asia", era: "当代 (1950—)", genre: ["诗歌"], themes: ["哲学", "爱情"], year: 1995, excerpt: "以干净而锐利的语言切入存在的深处——韩作荣的诗是中国当代诗歌中不可忽视的声音。", gradient: "from-gray-600 via-white to-black" },
  { id: "lux-1-p-shen", title: "在瞬间逗留", titleEn: "Lingering in the Moment", author: "沈苇", country: "中国", flag: "🇨🇳", continent: "asia", era: "当代 (1950—)", genre: ["诗歌"], themes: ["自然", "哲学"], year: 1995, excerpt: "以新疆的荒漠与雪峰为背景，在边地的苍茫之中审视个体与世界的脆弱联系。", gradient: "from-amber-400 via-white to-blue-300" },
  { id: "lux-1-p-zhang-x", title: "鸟落民间", titleEn: "Birds Alight Among the People", author: "张新泉", country: "中国", flag: "🇨🇳", continent: "asia", era: "当代 (1950—)", genre: ["诗歌"], themes: ["自然", "社会"], year: 1995, excerpt: "以朴素的意象与民间的节奏，让诗歌降落在日常生活的土地上——鸟落民间，诗在人间。", gradient: "from-green-400 via-amber-200 to-amber-300" },
  { id: "lux-1-p-wang-jiu", title: "狂雪", titleEn: "Furious Snow", author: "王久辛", country: "中国", flag: "🇨🇳", continent: "asia", era: "当代 (1950—)", genre: ["诗歌"], themes: ["战争", "历史"], year: 1995, excerpt: "以南京大屠杀为题材的长诗——以狂雪般密集的意象与凌厉的节奏，书写了一个民族的集体创伤。", gradient: "from-white via-red-300 to-black" },
  { id: "lux-1-p-xin", title: "寻觅光荣", titleEn: "Seeking Glory", author: "辛茹", country: "中国", flag: "🇨🇳", continent: "asia", era: "当代 (1950—)", genre: ["诗歌"], themes: ["战争", "社会"], year: 1995, excerpt: "以军旅女性的独特视角书写了光荣与牺牲的辩证——在橄榄绿中寻觅生命的意义。", gradient: "from-green-600 via-white to-red-500" },
  { id: "lux-1-p-li-song", title: "拒绝末日", titleEn: "Refusing the Apocalypse", author: "李松涛", country: "中国", flag: "🇨🇳", continent: "asia", era: "当代 (1950—)", genre: ["诗歌"], themes: ["自然", "哲学"], year: 1995, excerpt: "以生态诗人的敏锐声音对工业文明发出警示——在钢铁丛林中为自然留存最后一丝呼吸。", gradient: "from-green-600 via-gray-500 to-black" },

  // 散文 + 杂文 代表
  { id: "lux-1-d-he", title: "何为散文选集", titleEn: "Selected Prose of He Wei", author: "何为", country: "中国", flag: "🇨🇳", continent: "asia", era: "当代 (1950—)", genre: ["散文/随笔"], themes: ["社会", "哲学"], year: 1995, excerpt: "以散文的优雅与沉静书写了半个世纪的人生感悟——何为的散文是中国现当代散文的重要收获。", gradient: "from-amber-300 via-white to-gray-400" },
  { id: "lux-1-d-wang", title: "春宽梦窄", titleEn: "Spring Wide, Dream Narrow", author: "王充闾", country: "中国", flag: "🇨🇳", continent: "asia", era: "当代 (1950—)", genre: ["散文/随笔"], themes: ["历史", "哲学"], year: 1995, excerpt: "以文史交融的笔法在历史与文学之间穿行——春宽梦窄，人生如寄。", gradient: "from-green-400 via-white to-amber-300" },
  { id: "lux-1-d-tie", title: "女人的白夜", titleEn: "A Woman's White Night", author: "铁凝", country: "中国", flag: "🇨🇳", continent: "asia", era: "当代 (1950—)", genre: ["散文/随笔"], themes: ["社会", "心理"], year: 1995, excerpt: "以女性的敏锐感知书写了日常生活中的诗意与温度——在白夜的微光中捕捉生命的质感。", gradient: "from-white via-pink-200 to-purple-300" },
  { id: "lux-1-d-bing", title: "我的家在哪里", titleEn: "Where Is My Home", author: "冰心", country: "中国", flag: "🇨🇳", continent: "asia", era: "当代 (1950—)", genre: ["散文/随笔"], themes: ["社会", "哲学"], year: 1995, excerpt: "世纪老人冰心的晚年散文——九十岁高龄仍在追问'我的家在哪里'，以清澈如初的文字回望一个世纪的风雨。", gradient: "from-white via-blue-100 to-white" },
  { id: "lux-1-d-ji", title: "赋得永久的悔", titleEn: "Eternal Regret", author: "季羡林", country: "中国", flag: "🇨🇳", continent: "asia", era: "当代 (1950—)", genre: ["散文/随笔"], themes: ["哲学", "心理"], year: 1995, excerpt: "以国学大师的学养与赤子之心，书写了对母亲最深沉的愧疚——永久的悔，永远的怀念。", gradient: "from-amber-500 via-white to-gray-500" },

  // 报告文学 代表
  { id: "lux-1-r-yang", title: "灵魂何归", titleEn: "Where Does the Soul Return", author: "杨黎光", country: "中国", flag: "🇨🇳", continent: "asia", era: "当代 (1950—)", genre: ["散文/随笔"], themes: ["社会", "心理"], year: 1995, excerpt: "以深圳特区为背景的非虚构力作——在财富的狂潮中，灵魂正在寻找回家的路。", gradient: "from-gray-600 via-red-400 to-amber-400" },
  { id: "lux-1-r-jin", title: "恸问苍冥", titleEn: "Questioning the Heavens in Grief", author: "金辉", country: "中国", flag: "🇨🇳", continent: "asia", era: "当代 (1950—)", genre: ["散文/随笔"], themes: ["战争", "历史"], year: 1995, excerpt: "以中日战争为题材的沉重追问——在历史的深渊边，以文学之笔打捞被遗忘的伤痛。", gradient: "from-black via-red-700 to-white" },
  { id: "lux-1-r-he-jian", title: "共和国告急", titleEn: "The Republic in Crisis", author: "何建明", country: "中国", flag: "🇨🇳", continent: "asia", era: "当代 (1950—)", genre: ["散文/随笔"], themes: ["社会", "自然"], year: 1995, excerpt: "中国报告文学领军人物的成名作——以记者的敏锐与作家的笔力对中国资源危机发出预警。", gradient: "from-red-600 via-yellow-500 to-black" },
  { id: "lux-1-r-xu", title: "大国长剑", titleEn: "The Great Power's Long Sword", author: "徐剑", country: "中国", flag: "🇨🇳", continent: "asia", era: "当代 (1950—)", genre: ["散文/随笔"], themes: ["战争", "历史"], year: 1995, excerpt: "以中国战略导弹部队的创建历程为蓝本——在隐秘的战线上书写了共和国的核盾牌之梦。", gradient: "from-blue-700 via-gray-500 to-red-600" },
  { id: "lux-1-r-li-ming", title: "走出地球村", titleEn: "Leaving the Global Village", author: "李鸣生", country: "中国", flag: "🇨🇳", continent: "asia", era: "当代 (1950—)", genre: ["散文/随笔"], themes: ["冒险", "历史"], year: 1995, excerpt: "追踪中国航天事业从无到有的壮阔历程——以文学之笔为飞天梦想树碑立传。", gradient: "from-blue-600 via-black to-gold-400" },
];

