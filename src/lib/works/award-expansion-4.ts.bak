export const luxunS2: W[] = [
  { id: "lux-2-p-yang", title: "羞涩", titleEn: "Shyness", author: "杨晓民", country: "中国", flag: "🇨🇳", continent: "asia", era: "当代 (1950—)", genre: ["诗歌"], themes: ["哲学", "社会"], year: 2000, excerpt: "以日常语词入诗，在朴素中开掘出令人惊讶的诗意深度——杨晓民的'羞涩'是关于语言本身的谦卑。", gradient: "from-white via-blue-100 to-gray-400" },
  { id: "lux-2-p-qu", title: "曲有源白话诗选", titleEn: "Selected Colloquial Poems", author: "曲有源", country: "中国", flag: "🇨🇳", continent: "asia", era: "当代 (1950—)", genre: ["诗歌"], themes: ["社会", "哲学"], year: 2000, excerpt: "以白话入诗，用最朴素的语言直面最沉重的人生——曲有源的口语诗是中国当代诗歌的重要实验。", gradient: "from-gray-500 via-white to-black" },
  { id: "lux-2-p-xi", title: "西川的诗", titleEn: "Poems of Xi Chuan", author: "西川", country: "中国", flag: "🇨🇳", continent: "asia", era: "当代 (1950—)", genre: ["诗歌"], themes: ["哲学", "历史"], year: 2000, excerpt: "以知识分子的博学与诗人的锐利在东西方文化之间架桥——西川将中国古典精神嵌入世界诗歌的语境。", gradient: "from-blue-600 via-purple-400 to-gold-300" },
  { id: "lux-2-d-yu", title: "山居笔记", titleEn: "Mountain Dwelling Notes", author: "余秋雨", country: "中国", flag: "🇨🇳", continent: "asia", era: "当代 (1950—)", genre: ["散文/随笔"], themes: ["历史", "哲学"], year: 2000, excerpt: "以文化散文著称的余秋雨最成熟的作品之一——在山水与历史之间追寻中华文明的精神脉络。", gradient: "from-green-600 via-stone-400 to-amber-400" },
  { id: "lux-2-d-li", title: "大雅村言", titleEn: "Elegant Village Talk", author: "李国文", country: "中国", flag: "🇨🇳", continent: "asia", era: "当代 (1950—)", genre: ["散文/随笔"], themes: ["社会", "哲学"], year: 2000, excerpt: "以杂文家的犀利与小说家的叙事功力书写了中国社会与历史的种种面相——大雅村言，俗中见雅。", gradient: "from-gray-700 via-amber-400 to-red-400" },
  { id: "lux-2-r-he", title: "落泪是金", titleEn: "Tears Are Gold", author: "何建明", country: "中国", flag: "🇨🇳", continent: "asia", era: "当代 (1950—)", genre: ["散文/随笔"], themes: ["社会"], year: 2000, excerpt: "以大学贫困生的真实生活为题材的报告文学力作——落泪是金，每一个寒门学子的故事都令人心碎。", gradient: "from-blue-500 via-yellow-400 to-amber-400" },
  { id: "lux-2-r-wang", title: "远东朝鲜战争", titleEn: "The Korean War", author: "王树增", country: "中国", flag: "🇨🇳", continent: "asia", era: "当代 (1950—)", genre: ["散文/随笔"], themes: ["战争", "历史"], year: 2000, excerpt: "以全景式纪实笔法重述朝鲜战争——在宏大的历史叙事中还原个体士兵的血肉与灵魂。", gradient: "from-red-700 via-gray-500 to-blue-500" },
];

