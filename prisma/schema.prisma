generator client {
  provider = "prisma-client-js"
  output   = "../.prisma/client"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  name         String
  passwordHash String     @default("")
  avatar       String?
  provider     String     @default("credentials")
  preferences  Json?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  bookmarks    Bookmark[]
  favoriteTrends      FavoriteTrend[]
  favoriteArticles    FavoriteArticle[]
  dailyRecommendations DailyRecommendation[]
}

model Bookmark {
  id        String   @id @default(cuid())
  userId    String
  workId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, workId])
}

model FavoriteTrend {
  id         String   @id @default(cuid())
  userId     String
  trendId    String
  trendDate  String
  trendTitle String
  savedAt    DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, trendId])
}

model FavoriteArticle {
  id            String   @id @default(cuid())
  userId        String
  articleId     String
  articleTitle  String
  articleSource String
  articleDate   String
  excerpt       String?
  savedAt       DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, articleId])
}

model DailyRecommendation {
  id        String   @id @default(cuid())
  userId    String
  bookId    String
  date      String
  reason    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}
